{
  "name": "@modelscript/exchange",
  "version": "0.0.18",
  "description": "ModelScript Standards & Model Exchange engine — FMI 2.0/3.0 export, SSP packaging, and MQTT co-simulation orchestrator",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fmu": {
      "types": "./dist/fmu/index.d.ts",
      "default": "./dist/fmu/index.js"
    },
    "./fmi": {
      "types": "./dist/fmu/index.d.ts",
      "default": "./dist/fmu/index.js"
    },
    "./ssp": {
      "types": "./dist/ssp/index.d.ts",
      "default": "./dist/ssp/index.js"
    },
    "./lens": {
      "types": "./dist/lens/index.d.ts",
      "default": "./dist/lens/index.js"
    },
    "./aasx": {
      "types": "./dist/aasx/index.d.ts",
      "default": "./dist/aasx/index.js"
    },
    "./variants": {
      "types": "./dist/variants/index.d.ts",
      "default": "./dist/variants/index.js"
    },
    "./cosim": {
      "types": "./dist/cosim/index.d.ts",
      "default": "./dist/cosim/index.js"
    },
    "./cosim/*": {
      "types": "./dist/cosim/*.d.ts",
      "default": "./dist/cosim/*.js"
    },
    "./hpc": {
      "types": "./dist/hpc/index.d.ts",
      "default": "./dist/hpc/index.js"
    },
    "./hpc/*": {
      "types": "./dist/hpc/*.d.ts",
      "default": "./dist/hpc/*.js"
    },
    "./fmu/*": {
      "types": "./dist/fmu/*.d.ts",
      "default": "./dist/fmu/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "fetch:fmusim": "tsx validation/fmi/scripts/fetch-fmusim.ts",
    "lint": "eslint src --no-warn-ignored",
    "test": "npx tsx --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../scripts/node-test-ctrf-reporter.cjs --test-reporter-destination=stdout validation/test-fmi-ls-bus.ts",
    "test:fmusim": "tsx validation/fmi/scripts/fmusim-verify.ts",
    "test:omc": "tsx validation/fmi/scripts/omc-verify.ts",
    "validate": "tsx validation/fmi/scripts/validate.ts"
  },
  "dependencies": {
    "@modelscript/runtime": "*",
    "@modelscript/simulate": "*",
    "aedes": "^1.0.2",
    "aedes-server-factory": "^0.2.1",
    "fflate": "^0.8.3",
    "mqtt": "^5.10.0",
    "pako": "^2.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pako": "^2.0.4",
    "@types/ws": "^8.18.0",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
