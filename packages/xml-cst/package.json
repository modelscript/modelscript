{
  "name": "@modelscript/xml-cst",
  "version": "0.0.0",
  "description": "Lossless XML concrete syntax tree (WASM GLR) with offset-exact structural edits, shared by PSCAD and SSP",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "language.ts",
    "src/**",
    "src-gen/**",
    "dist/**"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "build:parser": "node build.js --force",
    "clean": "rimraf dist build src-gen as-gen *.wasm",
    "lint": "eslint language.ts src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
