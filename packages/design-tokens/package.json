{
  "name": "@modelscript/design-tokens",
  "version": "0.1.0",
  "description": "ModelScript & Ansatz design system — shared CSS tokens and primitive component styles for the docs site, web app, and IDE webviews",
  "keywords": [
    "modelscript",
    "ansatz",
    "design-tokens"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git",
    "directory": "packages/design-tokens"
  },
  "license": "AGPL-3.0-or-later",
  "author": "ModelScript Contributors",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./tokens-vscode.css": "./src/tokens-vscode.css",
    "./tokens-web.css": "./src/tokens-web.css",
    "./components.css": "./src/components.css",
    "./runtime": "./src/runtime.ts",
    "./panel": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "react": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "modelscript": {
    "tier": "beta",
    "category": "core"
  }
}
