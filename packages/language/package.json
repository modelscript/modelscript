{
  "name": "@modelscript/language",
  "version": "0.0.18",
  "description": "ModelScript DSL",
  "keywords": [
    "modelscript",
    "dsl",
    "parser",
    "lexer"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Mohamad Omar Nachawati <mnachawa@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./cad": {
      "types": "./dist/cad/index.d.ts",
      "default": "./dist/cad/index.js"
    },
    "./cad/*": {
      "types": "./dist/cad/*.d.ts",
      "default": "./dist/cad/*.js"
    },
    "./ecad": {
      "types": "./dist/ecad/index.d.ts",
      "default": "./dist/ecad/index.js"
    },
    "./ecad/*": {
      "types": "./dist/ecad/*.d.ts",
      "default": "./dist/ecad/*.js"
    },
    "./csg": {
      "types": "./dist/csg/index.d.ts",
      "default": "./dist/csg/index.js"
    },
    "./csg/*": {
      "types": "./dist/csg/*.d.ts",
      "default": "./dist/csg/*.js"
    },
    "./diagram": {
      "types": "./dist/diagram/index.d.ts",
      "default": "./dist/diagram/index.js"
    },
    "./diagram/builder": {
      "types": "./dist/diagram/polyglot-diagram-builder.d.ts",
      "default": "./dist/diagram/polyglot-diagram-builder.js"
    },
    "./diagram/browser": {
      "types": "./dist/diagram.browser.js",
      "default": "./dist/diagram.browser.js"
    },
    "./diagram/sequence-layout": {
      "types": "./dist/diagram/sequence-layout.d.ts",
      "default": "./dist/diagram/sequence-layout.js"
    },
    "./diagram/spinner": {
      "types": "./dist/diagram/spinner.d.ts",
      "default": "./dist/diagram/spinner.js"
    },
    "./fmi": {
      "types": "./dist/fmi/index.d.ts",
      "default": "./dist/fmi/index.js"
    },
    "./fmi/*": {
      "types": "./dist/fmi/*.d.ts",
      "default": "./dist/fmi/*.js"
    },
    "./cosim": {
      "types": "./dist/cosim/index.d.ts",
      "default": "./dist/cosim/index.js"
    },
    "./cosim/*": {
      "types": "./dist/cosim/*.d.ts",
      "default": "./dist/cosim/*.js"
    },
    "./lsp": {
      "types": "./dist/lsp/browserServerMain.d.ts",
      "default": "./dist/lsp/browserServerMain.js"
    },
    "./lsp/*": {
      "types": "./dist/lsp/*.d.ts",
      "default": "./dist/lsp/*.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "language-generate": "./bin/language-generate.js"
  },
  "files": [
    "package.json",
    "README.md",
    "COPYING",
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:templates && tsc && npm run build:browser",
    "build:browser": "node scripts/build-browser.js",
    "build:templates": "node scripts/bundle-templates.js",
    "clean": "rimraf dist src/src-gen",
    "lint": "eslint src",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:diagnostics": "tsx tests/test-diagnostics.ts",
    "test:recovery": "NODE_OPTIONS=--experimental-vm-modules jest tests/test-recovery-integration.test.ts",
    "watch": "tsc --watch"
  },
  "lint-staged": {
    "*.ts": "eslint --no-warn-ignored",
    "*.{ts,tsx,js,json,md,yml,css}": "prettier --write"
  },
  "dependencies": {
    "@antv/layout": "^0.3.25",
    "@antv/x6": "^3.1.7",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@modelscript/compiler": "*",
    "@modelscript/modelica": "*",
    "@modelscript/owl2": "*",
    "@modelscript/step": "*",
    "@modelscript/sysml2": "*",
    "@modelscript/utils": "*",
    "aedes": "^1.0.2",
    "aedes-server-factory": "^0.2.1",
    "assemblyscript": "^0.28.17",
    "fflate": "^0.8.2",
    "mqtt": "^5.10.0",
    "occt-import-js": "^0.0.23",
    "opencascade.js": "^1.0.0",
    "pako": "^2.1.0",
    "pg": "^8.13.0",
    "sql.js": "^1.14.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@as-pect/cli": "^9.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.2",
    "@types/pako": "^2.0.4",
    "@types/pg": "^8.11.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": []
      }
    }
  }
}
