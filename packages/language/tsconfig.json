{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",

    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node", "@webgpu/types"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    "strict": false,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@modelscript/language": ["./src/index.ts"],
      "@modelscript/language/*": ["./src/*"],
      "@modelscript/cad": ["../cad/dist/index.d.ts"],
      "@modelscript/cad/*": ["../cad/dist/*.d.ts"],
      "@modelscript/diagram": ["../diagram/dist/index.d.ts"],
      "@modelscript/diagram/protocol": ["../diagram/dist/protocol.d.ts"],
      "@modelscript/diagram/builder": ["../diagram/dist/polyglot-diagram-builder.d.ts"],
      "@modelscript/diagram/sequence-layout": ["../diagram/dist/sequence-layout.d.ts"],
      "@modelscript/diagram/spinner": ["../diagram/dist/spinner.d.ts"],
      "@modelscript/diagram/*": ["../diagram/dist/*.d.ts"],
      "@modelscript/dsl": ["../dsl/dist/index.d.ts"],
      "@modelscript/dsl/dsl": ["../dsl/dist/dsl/index.d.ts"],
      "@modelscript/dsl/codegen": ["../dsl/dist/codegen/index.d.ts"],
      "@modelscript/dsl/tgg": ["../dsl/dist/codegen/compile_tgg.d.ts"],
      "@modelscript/dsl/egraph": ["../dsl/dist/codegen/egraph.d.ts"],
      "@modelscript/dsl/parser": ["../dsl/dist/codegen/parser.d.ts"],
      "@modelscript/dsl/bindings": ["../dsl/dist/bindings/javascript/index.d.ts"],
      "@modelscript/dsl/*.js": ["../dsl/dist/*.d.ts"],
      "@modelscript/dsl/*": ["../dsl/dist/*.d.ts"],
      "@modelscript/exchange": ["../exchange/dist/index.d.ts"],
      "@modelscript/exchange/*": ["../exchange/dist/*.d.ts"],
      "@modelscript/lsp": ["../lsp/dist/index.d.ts"],
      "@modelscript/lsp/server": ["../lsp/dist/browserServerMain.d.ts"],
      "@modelscript/lsp/services": ["../lsp/dist/services/index.d.ts"],
      "@modelscript/lsp/handlers": ["../lsp/dist/handlers/index.d.ts"],
      "@modelscript/lsp/bridge": ["../lsp/dist/lsp-bridge.d.ts"],
      "@modelscript/lsp/services/*.js": ["../lsp/dist/services/*.d.ts"],
      "@modelscript/lsp/services/*": ["../lsp/dist/services/*.d.ts"],
      "@modelscript/lsp/handlers/*.js": ["../lsp/dist/handlers/*.d.ts"],
      "@modelscript/lsp/handlers/*": ["../lsp/dist/handlers/*.d.ts"],
      "@modelscript/lsp/providers/*.js": ["../lsp/dist/providers/*.d.ts"],
      "@modelscript/lsp/providers/*": ["../lsp/dist/providers/*.d.ts"],
      "@modelscript/lsp/utils/*.js": ["../lsp/dist/utils/*.d.ts"],
      "@modelscript/lsp/utils/*": ["../lsp/dist/utils/*.d.ts"],
      "@modelscript/lsp/vfs/*.js": ["../lsp/dist/vfs/*.d.ts"],
      "@modelscript/lsp/vfs/*": ["../lsp/dist/vfs/*.d.ts"],
      "@modelscript/lsp/workers/*.js": ["../lsp/dist/workers/*.d.ts"],
      "@modelscript/lsp/workers/*": ["../lsp/dist/workers/*.d.ts"],
      "@modelscript/lsp/*.js": ["../lsp/dist/*.d.ts"],
      "@modelscript/lsp/*": ["../lsp/dist/*.d.ts"],
      "@modelscript/mcp": ["../mcp/dist/index.d.ts"],
      "@modelscript/mcp/main": ["../mcp/dist/main.d.ts"],
      "@modelscript/mcp/*.js": ["../mcp/dist/*.d.ts"],
      "@modelscript/mcp/*": ["../mcp/dist/*.d.ts"],
      "@modelscript/runtime": ["../runtime/dist/index.d.ts"],
      "@modelscript/runtime/*.js": ["../runtime/dist/*.d.ts"],
      "@modelscript/runtime/*": ["../runtime/dist/*.d.ts"],
      "@modelscript/simulate": ["../simulate/dist/index.d.ts"],
      "@modelscript/simulate/core": ["../simulate/dist/core/index.d.ts"],
      "@modelscript/simulate/solvers": ["../simulate/dist/solvers/index.d.ts"],
      "@modelscript/simulate/optimizer": ["../simulate/dist/optimizer/index.d.ts"],
      "@modelscript/simulate/uq": ["../simulate/dist/uq/index.d.ts"],
      "@modelscript/simulate/surrogates": ["../simulate/dist/surrogates/index.d.ts"],
      "@modelscript/simulate/*.js": ["../simulate/dist/*.d.ts"],
      "@modelscript/simulate/*": ["../simulate/dist/*.d.ts"],
      "@modelscript/sysml2": ["../../languages/sysml2/src/index.ts"],
      "@modelscript/sysml2/*": ["../../languages/sysml2/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/codegen/runtime/**/*", "dist", "build", "node_modules"]
}
