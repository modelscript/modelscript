{
  "name": "@modelscript/ide-client",
  "version": "0.1.0",
  "private": true,
  "description": "ModelScript VS Code Web Extension client, custom editors, and webview panels",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "src/browser-client-main.ts",
  "types": "src/browser-client-main.ts",
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/ci/test-runner.js --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "commands": [
      {
        "command": "modelscript.runFormalLints",
        "title": "ModelScript: Run Formal Verification Lints (IC3/PDR, FTA, UQ, Flowpipe)"
      },
      {
        "command": "modelscript.runCompilerLints",
        "title": "ModelScript: Run WASM Compiler Lints"
      },
      {
        "command": "modelscript.openAlmRemotes",
        "title": "ModelScript: Open ALM & PLM Remotes"
      }
    ]
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@modelscript/c": "workspace:*",
    "@modelscript/cad": "workspace:*",
    "@modelscript/cantera": "workspace:*",
    "@modelscript/canvas": "workspace:*",
    "@modelscript/cfd": "workspace:*",
    "@modelscript/csv": "workspace:*",
    "@modelscript/diagram": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/editor": "workspace:*",
    "@modelscript/exchange": "workspace:*",
    "@modelscript/fea": "workspace:*",
    "@modelscript/las": "workspace:*",
    "@modelscript/lsp": "workspace:*",
    "@modelscript/nmodl": "workspace:*",
    "@modelscript/pdb": "workspace:*",
    "@modelscript/pscad": "workspace:*",
    "@modelscript/qif": "workspace:*",
    "@modelscript/runtime": "workspace:*",
    "@modelscript/scad": "workspace:*",
    "@modelscript/sdk": "workspace:*",
    "@modelscript/simpack": "workspace:*",
    "@modelscript/simulate": "workspace:*",
    "@modelscript/sysml2": "workspace:*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/xr": "^6.6.29",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "fflate": "^0.8.3",
    "pako": "^2.1.0",
    "three": "^0.184.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.72.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "beta",
    "category": "core"
  }
}
