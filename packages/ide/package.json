{
  "name": "@modelscript/ide-client",
  "version": "0.1.0",
  "private": true,
  "description": "ModelScript VS Code Web Extension client, custom editors, and webview panels",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "src/browser-client-main.ts",
  "types": "src/browser-client-main.ts",
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "commands": [
      {
        "command": "modelscript.runFormalLints",
        "title": "ModelScript: Run Formal Verification Lints (IC3/PDR, FTA, UQ, Flowpipe)"
      },
      {
        "command": "modelscript.runCompilerLints",
        "title": "ModelScript: Run WASM Compiler Lints"
      },
      {
        "command": "modelscript.openAlmRemotes",
        "title": "ModelScript: Open ALM & PLM Remotes"
      }
    ]
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@modelscript/c": "*",
    "@modelscript/cad": "*",
    "@modelscript/cantera": "*",
    "@modelscript/cfd": "*",
    "@modelscript/csv": "*",
    "@modelscript/diagram": "*",
    "@modelscript/dsl": "*",
    "@modelscript/exchange": "*",
    "@modelscript/fea": "*",
    "@modelscript/las": "*",
    "@modelscript/lsp": "*",
    "@modelscript/nmodl": "*",
    "@modelscript/pdb": "*",
    "@modelscript/qif": "*",
    "@modelscript/runtime": "*",
    "@modelscript/scad": "*",
    "@modelscript/sdk": "*",
    "@modelscript/simpack": "*",
    "@modelscript/simulate": "*",
    "@modelscript/sysml2": "*",
    "@vscode/debugadapter": "^1.68.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.72.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "beta",
    "category": "core"
  }
}
