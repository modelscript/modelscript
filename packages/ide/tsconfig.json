{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "vscode": ["./tests/mocks/vscode.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["src/webview/**/*"]
}
