{
  "name": "@modelscript/embed",
  "version": "0.0.18",
  "description": "ModelScript & Ansatz embed client SDK — iframe bridge, Web Component custom elements, and permalink codec",
  "keywords": [
    "modelscript",
    "ansatz",
    "embed",
    "web-components"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git",
    "directory": "packages/embed"
  },
  "license": "AGPL-3.0-or-later",
  "author": "ModelScript Contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "default": "./dist/codec.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/pako": "^2.0.3",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "stable",
    "category": "core"
  }
}
