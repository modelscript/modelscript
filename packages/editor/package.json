{
  "name": "@modelscript/editor",
  "version": "0.1.0",
  "description": "Host-agnostic Ansatz Editor core, LSP transport abstraction, and host context adapter for ModelScript web, embed, and single-language environments",
  "keywords": [
    "modelscript",
    "ansatz",
    "editor",
    "lsp",
    "workbench",
    "diagram"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git",
    "directory": "packages/editor"
  },
  "license": "AGPL-3.0-or-later",
  "author": "ModelScript Contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./workbench": {
      "types": "./dist/workbench/AnsatzEditor.d.ts",
      "default": "./dist/workbench/AnsatzEditor.js"
    },
    "./workbench/*.js": {
      "types": "./dist/workbench/*.d.ts",
      "default": "./dist/workbench/*.js"
    },
    "./workbench/*": {
      "types": "./dist/workbench/*.d.ts",
      "default": "./dist/workbench/*.js"
    },
    "./internal/*.js": {
      "types": "./dist/internal/*.d.ts",
      "default": "./dist/internal/*.js"
    },
    "./internal/*": {
      "types": "./dist/internal/*.d.ts",
      "default": "./dist/internal/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/workbench/ansatz-editor.css','dist/workbench/ansatz-editor.css')\"",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/ci/test-runner.js --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@modelscript/ampl": "workspace:*",
    "@modelscript/cad": "workspace:*",
    "@modelscript/cad-viewer": "workspace:*",
    "@modelscript/canvas": "workspace:*",
    "@modelscript/cgmes": "workspace:*",
    "@modelscript/diagram": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/epanet": "workspace:*",
    "@modelscript/exchange": "workspace:*",
    "@modelscript/lsp": "workspace:*",
    "@modelscript/matpower": "workspace:*",
    "@modelscript/modelica": "workspace:*",
    "@modelscript/opendrive": "workspace:*",
    "@modelscript/opendss": "workspace:*",
    "@modelscript/owl2": "workspace:*",
    "@modelscript/powerfactory": "workspace:*",
    "@modelscript/pscad": "workspace:*",
    "@modelscript/pslf": "workspace:*",
    "@modelscript/psse": "workspace:*",
    "@modelscript/react": "workspace:*",
    "@modelscript/rotunda": "workspace:*",
    "@modelscript/simulate": "workspace:*",
    "@modelscript/simulink": "workspace:*",
    "@modelscript/spice": "workspace:*",
    "@modelscript/ssp": "workspace:*",
    "@modelscript/swmm": "workspace:*",
    "@modelscript/sysml2": "workspace:*",
    "@modelscript/three-mf": "workspace:*",
    "@modelscript/urdf": "workspace:*",
    "@modelscript/usd": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@primer/octicons-react": "^19.23.1",
    "@primer/react": "^38.14.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/xr": "^6.6.29",
    "@tanstack/react-virtual": "^3.13.21",
    "dompurify": "^3.4.17",
    "monaco-editor": "^0.55.1",
    "mqtt": "^5.10.0",
    "pako": "^2.1.0",
    "papaparse": "^5.5.3",
    "parse-data-url": "^6.0.0",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "unist-util-visit": "^5.1.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/three": "^0.184.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "modelscript": {
    "tier": "beta",
    "category": "core"
  }
}
