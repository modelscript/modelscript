{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@modelscript/dsl": ["../dsl/dist/index.d.ts"],
      "@modelscript/dsl/*": ["../dsl/dist/*"],
      "@modelscript/runtime": ["../runtime/dist/index.d.ts"],
      "@modelscript/runtime/*": ["../runtime/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
