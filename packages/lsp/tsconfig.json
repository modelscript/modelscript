{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@modelscript/runtime": ["../runtime/dist/index.d.ts"],
      "@modelscript/runtime/*": ["../runtime/dist/*"],
      "@modelscript/dsl": ["../dsl/dist/index.d.ts"],
      "@modelscript/dsl/*": ["../dsl/dist/*"],
      "@modelscript/simulate": ["../simulate/dist/index.d.ts"],
      "@modelscript/simulate/*": ["../simulate/dist/*"],
      "@modelscript/diagram": ["../diagram/dist/index.d.ts"],
      "@modelscript/diagram/protocol": ["../diagram/dist/protocol.d.ts"],
      "@modelscript/diagram/*": ["../diagram/dist/*"],
      "@modelscript/cad": ["../cad/dist/index.d.ts"],
      "@modelscript/cad/*": ["../cad/dist/*"],
      "@modelscript/exchange": ["../exchange/dist/index.d.ts"],
      "@modelscript/exchange/*": ["../exchange/dist/*"],
      "@modelscript/modelica": ["../../languages/modelica/dist/index.d.ts"],
      "@modelscript/modelica/*": ["../../languages/modelica/dist/*"],
      "@modelscript/sysml2": ["../../languages/sysml2/src/index.ts"],
      "@modelscript/sysml2/*": ["../../languages/sysml2/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
