{
  "name": "@modelscript/lsp",
  "version": "0.1.0",
  "description": "Multi-language Language Server Protocol server and services for ModelScript",
  "keywords": [
    "modelscript",
    "lsp",
    "language-server"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git",
    "directory": "packages/lsp"
  },
  "license": "AGPL-3.0-or-later",
  "author": "ModelScript Contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/browserServerMain.d.ts",
      "default": "./dist/browserServerMain.js"
    },
    "./node": {
      "types": "./dist/nodeServerMain.d.ts",
      "default": "./dist/nodeServerMain.js"
    },
    "./context": {
      "types": "./dist/lsp-context.d.ts",
      "default": "./dist/lsp-context.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.ts",
      "default": "./dist/handlers/index.js"
    },
    "./bridge": {
      "types": "./dist/lsp-bridge.d.ts",
      "default": "./dist/lsp-bridge.js"
    },
    "./services/*.js": {
      "types": "./dist/services/*.d.ts",
      "default": "./dist/services/*.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "default": "./dist/services/*.js"
    },
    "./handlers/*.js": {
      "types": "./dist/handlers/*.d.ts",
      "default": "./dist/handlers/*.js"
    },
    "./handlers/*": {
      "types": "./dist/handlers/*.d.ts",
      "default": "./dist/handlers/*.js"
    },
    "./providers/*.js": {
      "types": "./dist/providers/*.d.ts",
      "default": "./dist/providers/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "default": "./dist/providers/*.js"
    },
    "./utils/*.js": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./vfs/*.js": {
      "types": "./dist/vfs/*.d.ts",
      "default": "./dist/vfs/*.js"
    },
    "./vfs/*": {
      "types": "./dist/vfs/*.d.ts",
      "default": "./dist/vfs/*.js"
    },
    "./workers/*.js": {
      "types": "./dist/workers/*.d.ts",
      "default": "./dist/workers/*.js"
    },
    "./workers/*": {
      "types": "./dist/workers/*.d.ts",
      "default": "./dist/workers/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc && tsx scripts/build-browser.ts",
    "clean": "rimraf dist",
    "lint": "eslint src tests scripts --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js --timeout=120000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/adams": "*",
    "@modelscript/ampl": "*",
    "@modelscript/antimony": "*",
