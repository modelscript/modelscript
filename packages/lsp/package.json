{
  "name": "@modelscript/lsp",
  "version": "0.0.18",
  "description": "Multi-language Language Server Protocol server and services for ModelScript",
  "license": "AGPL-3.0-or-later",
  "author": "ModelScript Contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/browserServerMain.d.ts",
      "default": "./dist/browserServerMain.js"
    },
    "./context": {
      "types": "./dist/LspContext.d.ts",
      "default": "./dist/LspContext.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.ts",
      "default": "./dist/handlers/index.js"
    },
    "./bridge": {
      "types": "./dist/lsp-bridge.d.ts",
      "default": "./dist/lsp-bridge.js"
    },
    "./services/*.js": {
      "types": "./dist/services/*.d.ts",
      "default": "./dist/services/*.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "default": "./dist/services/*.js"
    },
    "./handlers/*.js": {
      "types": "./dist/handlers/*.d.ts",
      "default": "./dist/handlers/*.js"
    },
    "./handlers/*": {
      "types": "./dist/handlers/*.d.ts",
      "default": "./dist/handlers/*.js"
    },
    "./providers/*.js": {
      "types": "./dist/providers/*.d.ts",
      "default": "./dist/providers/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "default": "./dist/providers/*.js"
    },
    "./utils/*.js": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./vfs/*.js": {
      "types": "./dist/vfs/*.d.ts",
      "default": "./dist/vfs/*.js"
    },
    "./vfs/*": {
      "types": "./dist/vfs/*.d.ts",
      "default": "./dist/vfs/*.js"
    },
    "./workers/*.js": {
      "types": "./dist/workers/*.d.ts",
      "default": "./dist/workers/*.js"
    },
    "./workers/*": {
      "types": "./dist/workers/*.d.ts",
      "default": "./dist/workers/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "lint": "eslint src --no-warn-ignored"
  },
  "dependencies": {
    "@modelscript/cad": "*",
    "@modelscript/csv": "*",
    "@modelscript/diagram": "*",
    "@modelscript/dsl": "*",
    "@modelscript/exchange": "*",
    "@modelscript/modelica": "*",
    "@modelscript/owl2": "*",
    "@modelscript/runtime": "*",
    "@modelscript/simulate": "*",
    "@modelscript/step": "*",
    "@modelscript/sysml2": "*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
