{
  "name": "@modelscript/cad",
  "version": "0.0.18",
  "description": "ModelScript CAD and ECAD engine — CSG primitives, OpenCascade boolean operations, STEP serialization, Gerber parser, and PCB routing",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ecad": {
      "types": "./dist/ecad/index.d.ts",
      "default": "./dist/ecad/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23",
    "opencascade.js": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
