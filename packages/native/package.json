{
  "name": "@modelscript/native",
  "version": "0.1.0",
  "description": "Platform-native wasm2c CPU kernels, Dawn WebGPU runtime, and CUDA/HIP hardware FP64 backend for Desktop VS Code and Cloud HPC",
  "keywords": [
    "modelscript",
    "native",
    "wasm2c",
    "webgpu",
    "dawn",
    "hpc",
    "fp64"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git",
    "directory": "packages/native"
  },
  "license": "AGPL-3.0-or-later",
  "author": "ModelScript Contributors",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser-stub.d.ts",
        "default": "./dist/browser-stub.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "types": "./dist/browser-stub.d.ts",
      "default": "./dist/browser-stub.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "prebuilds/**",
    "CMakeLists.txt",
    "src/**/*.c",
    "src/**/*.cpp",
    "src/**/*.h"
  ],
  "scripts": {
    "build": "tsc",
    "build:codegen": "npx tsx ../../scripts/build/wasm2c-codegen.ts",
    "build:native": "node scripts/build-native.js",
    "clean": "rimraf dist build generated prebuilds",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/ci/test-runner.js --timeout=120000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "beta",
    "category": "core"
  }
}
