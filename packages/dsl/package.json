{
  "name": "@modelscript/dsl",
  "version": "0.0.18",
  "description": "ModelScript DSL syntax combinators, GLR parser generator, and term-rewriting engines",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsl": {
      "types": "./dist/dsl/index.d.ts",
      "default": "./dist/dsl/index.js"
    },
    "./dsl/*.js": {
      "types": "./dist/dsl/*.d.ts",
      "default": "./dist/dsl/*.js"
    },
    "./dsl/*": {
      "types": "./dist/dsl/*.d.ts",
      "default": "./dist/dsl/*.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    },
    "./codegen/parser": {
      "types": "./dist/codegen/parser/index.d.ts",
      "default": "./dist/codegen/parser/index.js"
    },
    "./codegen/parser/*": {
      "types": "./dist/codegen/parser/*.d.ts",
      "default": "./dist/codegen/parser/*.js"
    },
    "./codegen/transpiler": {
      "types": "./dist/codegen/transpiler/index.d.ts",
      "default": "./dist/codegen/transpiler/index.js"
    },
    "./codegen/transpiler/*": {
      "types": "./dist/codegen/transpiler/*.d.ts",
      "default": "./dist/codegen/transpiler/*.js"
    },
    "./codegen/analysis": {
      "types": "./dist/codegen/analysis/index.d.ts",
      "default": "./dist/codegen/analysis/index.js"
    },
    "./codegen/analysis/*": {
      "types": "./dist/codegen/analysis/*.d.ts",
      "default": "./dist/codegen/analysis/*.js"
    },
    "./codegen/rewriting": {
      "types": "./dist/codegen/rewriting/index.d.ts",
      "default": "./dist/codegen/rewriting/index.js"
    },
    "./codegen/rewriting/*": {
      "types": "./dist/codegen/rewriting/*.d.ts",
      "default": "./dist/codegen/rewriting/*.js"
    },
    "./codegen/typesys": {
      "types": "./dist/codegen/typesys/index.d.ts",
      "default": "./dist/codegen/typesys/index.js"
    },
    "./codegen/typesys/*": {
      "types": "./dist/codegen/typesys/*.d.ts",
      "default": "./dist/codegen/typesys/*.js"
    },
    "./codegen/emitters": {
      "types": "./dist/codegen/emitters/index.d.ts",
      "default": "./dist/codegen/emitters/index.js"
    },
    "./codegen/emitters/*": {
      "types": "./dist/codegen/emitters/*.d.ts",
      "default": "./dist/codegen/emitters/*.js"
    },
    "./codegen/ide": {
      "types": "./dist/codegen/ide/index.d.ts",
      "default": "./dist/codegen/ide/index.js"
    },
    "./codegen/ide/*": {
      "types": "./dist/codegen/ide/*.d.ts",
      "default": "./dist/codegen/ide/*.js"
    },
    "./codegen/shared": {
      "types": "./dist/codegen/shared/index.d.ts",
      "default": "./dist/codegen/shared/index.js"
    },
    "./codegen/shared/*": {
      "types": "./dist/codegen/shared/*.d.ts",
      "default": "./dist/codegen/shared/*.js"
    },
    "./codegen/*.js": {
      "types": "./dist/codegen/*.d.ts",
      "default": "./dist/codegen/*.js"
    },
    "./codegen/*": {
      "types": "./dist/codegen/*.d.ts",
      "default": "./dist/codegen/*.js"
    },
    "./bindings": {
      "types": "./dist/bindings/javascript/index.d.ts",
      "default": "./dist/bindings/javascript/index.js"
    },
    "./bindings/*.js": {
      "types": "./dist/bindings/javascript/*.d.ts",
      "default": "./dist/bindings/javascript/*.js"
    },
    "./bindings/*": {
      "types": "./dist/bindings/javascript/*.d.ts",
      "default": "./dist/bindings/javascript/*.js"
    },
    "./tgg": {
      "types": "./dist/codegen/rewriting/compile_tgg.d.ts",
      "default": "./dist/codegen/rewriting/compile_tgg.js"
    },
    "./cpa": {
      "types": "./dist/codegen/rewriting/cpa.d.ts",
      "default": "./dist/codegen/rewriting/cpa.js"
    },
    "./egraph": {
      "types": "./dist/codegen/rewriting/egraph.d.ts",
      "default": "./dist/codegen/rewriting/egraph.js"
    },
    "./parser": {
      "types": "./dist/codegen/parser/parser.d.ts",
      "default": "./dist/codegen/parser/parser.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./tools/*": {
      "types": "./dist/tools/*.d.ts",
      "default": "./dist/tools/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "language-generate": "./bin/language-generate.js"
  },
  "scripts": {
    "build": "npm run build:templates && tsc && npm run build:browser",
    "build:browser": "node scripts/build-browser.js",
    "build:templates": "node scripts/bundle-templates.js",
    "check:as": "node scripts/check-as.js",
    "clean": "rimraf dist src/src-gen build",
    "lint": "eslint src --no-warn-ignored",
    "test": "npx tsx --import ./tests/test-setup.ts --test --test-concurrency=1 --test-timeout=120000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../scripts/node-test-ctrf-reporter.cjs --test-reporter-destination=stdout tests/*.test.ts"
  },
  "dependencies": {
    "helmlab": "^1.0.0",
    "media-typer": "^2.0.0",
    "pako": "^3.0.2",
    "parse-data-url": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/media-typer": "^1.1.3",
    "@types/node": "^25.3.2",
    "@types/pako": "^3.0.0",
    "assemblyscript": "^0.28.20",
    "esbuild": "^0.28.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": []
      }
    }
  }
}
