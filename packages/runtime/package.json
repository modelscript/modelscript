  "files": [
    "dist/**",
    "!dist/**/*.tsbuildinfo",
    "build/release.wasm"
  ],
  "scripts": {
    "asbuild": "node scripts/build-as.js",
    "asbuild:debug": "asc assembly/index.ts --target debug",
    "asbuild:force": "node scripts/build-as.js --force",
    "asbuild:native": "asc assembly/index.ts --target native",
    "asbuild:release": "asc assembly/index.ts --target release",
    "benchmark:scale": "tsx tests/benchmark-dae-scale.ts",
    "build": "npm run asbuild && tsc",
    "clean": "rimraf dist build",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/ci/test-runner.js --timeout=180000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "workspace:*",
    "@modelscript/solve": "workspace:*",
    "pako": "^2.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/pako": "^2.0.4",
    "assemblyscript": "^0.28.19",
    "n3": "^2.0.1",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "beta",
    "category": "core"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "@modelscript/dsl:build",
          "@modelscript/solve:build"
        ]
      }
    }
