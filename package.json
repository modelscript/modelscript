{
  "name": "modelscript",
  "version": "0.0.0",
  "private": true,
  "description": "ModelScript",
  "keywords": [
    "modelscript"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Mohamad Omar Nachawati <mnachawa@gmail.com>",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*",
    "languages/*",
    "languages/*/*"
  ],
  "scripts": {
    "prebuild": "mkdir -p data",
    "build": "nx run-many --target=build --exclude=@modelscript/morsel --parallel=8",
    "build:affected": "nx affected --target=build --exclude=@modelscript/morsel --parallel=8",
    "build:all": "nx run-many --target=build --exclude=@modelscript/morsel --parallel=8",
    "build:extension": "npx tsx apps/cli/src/main.ts generate extension languages/modelica/src/language.ts languages/sysml2/src/language.ts languages/step/src/language.ts languages/owl2/src/language.ts languages/csv/language.ts --outdir dist/extension",
    "build:libs": "nx run-many --target=build --exclude=@modelscript/morsel,@modelscript/site,@modelscript/docs,@modelscript/web --parallel=8",
    "ci:act": "bash scripts/run-act.sh pull_request",
    "ci:act:build": "bash scripts/run-act.sh -j build_and_deploy",
    "ci:act:lint": "bash scripts/run-act.sh -j lint",
    "ci:act:test": "bash scripts/run-act.sh -j test",
    "ci:full": "bash scripts/ci-local.sh --full",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:quick": "bash scripts/ci-local.sh --quick",
    "clean": "nx run-many --target=clean",
    "predev": "mkdir -p data",
    "dev": "nx run-many --target=dev --projects=@modelscript/api,@modelscript/web,@modelscript/ide,@modelscript/dsl --parallel=4",
    "dev:docs": "npm run dev --workspace=@modelscript/docs",
    "dev:ide": "npm run dev --workspace=@modelscript/ide",
    "dev:vscode": "npx tsx apps/cli/src/main.ts sandbox languages/modelica/src/language.ts languages/sysml2/src/language.ts languages/step/src/language.ts languages/owl2/src/language.ts languages/csv/language.ts",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d",
    "format": "prettier . --write",
    "lint": "nx affected --target=lint --parallel=4",
    "lint:all": "nx run-many --target=lint --parallel=4",
    "prepare": "husky",
    "preview:ide": "npx tsx apps/ide/src/preview-static.ts",
    "release": "nx release",
    "release:dry-run": "nx release --dry-run",
    "test": "NODE_OPTIONS='--max-old-space-size=2048' nx affected --target=test --parallel=2",
    "test:all": "NODE_OPTIONS='--max-old-space-size=2048' nx run-many --target=test --parallel=3",
    "test:modelica": "npx tsx languages/modelica/tests/testsuite-runner.ts",
    "test:modelica:update": "npx tsx languages/modelica/tests/testsuite-runner.ts --update --omc",
    "test:quick": "NODE_OPTIONS='--max-old-space-size=2048' nx affected --target=test --parallel=3",
    "test:single": "npx tsx languages/modelica/tests/testsuite-runner.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --no-warn-ignored",
    "*.{ts,tsx,js,json,md,yml,css}": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "@antv/x6-plugin-selection": {
      "@antv/x6": "^3.1.7"
    },
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "@hono/node-server": "^1.19.15",
    "@humanfs/node": "^0.16.8",
    "@mermaid-js/parser": "^1.2.0",
    "@nx/devkit": {
      "brace-expansion": "^5.0.12"
    },
    "@react-router/dev": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@sigstore/core": "^3.2.1",
    "@sigstore/verify": "^3.1.1",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.25",
    "body-parser": "^2.3.0",
    "browserslist": "^4.28.7",
    "d3-color": "^3.1.0",
    "dompurify": "^3.4.15",
    "elliptic": "^6.6.1",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.6",
    "fflate": "^0.8.3",
    "form-data": "^4.0.6",
    "hono": "^4.13.5",
    "http-proxy-middleware": "^3.0.7",
    "image-size": "^2.0.4",
    "immutable": "^5.1.8",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.2",
    "mermaid": "^11.16.1",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nanoid": "^3.3.18",
    "nx": {
      "brace-expansion": "^5.0.12"
    },
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.3",
    "qs": "^6.16.0",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "sigstore": "^4.1.1",
    "smol-toml": "^1.7.1",
    "tar": "^7.5.22",
    "three": "^0.184.0",
    "tmp": "^0.2.7",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2",
    "vitepress": {
      "vite": "^6.4.3"
    },
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.19.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nx/js": "^22.7.3",
    "@types/node": "^25.3.2",
    "ajv": "^8.17.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.1.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "lodash.merge": "^4.6.2",
    "nx": "^22.7.3",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "source-map": "^0.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=24"
  }
}
