{
  "name": "modelscript",
  "version": "0.1.0",
  "private": true,
  "description": "ModelScript",
  "keywords": [
    "modelscript"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Mohamad Omar Nachawati <omar@modelscript.org>",
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/ide/github-fs",
    "ee",
    "packages/*",
    "packages/examples/*",
    "languages/*"
  ],
  "scripts": {
    "audit:languages": "npx tsx scripts/audit-language-maturity.ts",
    "bench:dae-scale": "npx tsx scripts/benchmark-dae-scale.ts",
    "bench:parser": "npm run bench:parser --workspace=@modelscript/modelica",
    "bench:polyglot": "npx tsx scripts/benchmark-polyglot-runner.ts",
    "bench:triplestore": "npx tsx scripts/benchmark-triplestore.ts",
    "prebuild": "mkdir -p data",
    "build": "node scripts/nx-coordinator.js run-many --target=build",
    "build:affected": "node scripts/nx-coordinator.js affected --target=build",
    "build:extension": "node scripts/nx-coordinator.js run-many --target=build --projects=@modelscript/dsl,@modelscript/runtime && npx tsx apps/cli/src/main.ts generate extension --outdir dist/extension",
    "build:ide:extension": "npm run build-extension --workspace=@modelscript/ide",
    "build:libs": "node scripts/nx-coordinator.js run-many --target=build --exclude=@modelscript/docs,@modelscript/web",
    "ci:act": "bash scripts/run-act.sh pull_request",
    "ci:act:build": "bash scripts/run-act.sh -j build",
    "ci:act:lint": "bash scripts/run-act.sh -j lint",
    "ci:act:modelica": "bash scripts/run-act.sh -j modelica_testsuite",
    "ci:act:test": "bash scripts/run-act.sh -j test",
    "ci:full": "bash scripts/ci-local.sh --full",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:quick": "bash scripts/ci-local.sh --quick",
    "clean": "nx run-many --target=clean",
    "clean:scratch": "npx tsx scripts/clean-scratch.ts",
    "codeql": "bash scripts/codeql-scan.sh",
    "codeql:docker": "bash scripts/codeql-scan.sh --docker",
    "codeql:install": "bash scripts/codeql-scan.sh --install",
    "coverage:consolidate": "npx tsx scripts/consolidate-coverage.ts",
    "predev": "mkdir -p data",
    "dev": "nx run-many --target=dev --projects=@modelscript/api,@modelscript/web --parallel=2",
    "dev:ansatz": "npm run dev",
    "dev:api": "npm run dev --workspace=@modelscript/api",
    "dev:cli": "npx tsx watch apps/cli/src/main.ts",
    "dev:compiler": "nx watch --projects=@modelscript/dsl,@modelscript/runtime,@modelscript/modelica -- tsc -w",
    "dev:desktop": "npm run dev --workspace=@modelscript/desktop",
    "dev:docs": "npm run dev --workspace=@modelscript/docs",
    "dev:flagship": "nx run-many --target=dev:flagship --projects=@modelscript/api,@modelscript/web --parallel=2",
    "dev:flagship:api": "npm run dev:flagship --workspace=@modelscript/api",
    "dev:platform": "npm run dev",
    "dev:vscode": "npx tsx apps/cli/src/main.ts sandbox languages/modelica/src/language.ts languages/sysml2/src/language.ts languages/step/src/language.ts languages/owl2/src/language.ts languages/csv/src/language.ts languages/modelscript/src/language.ts",
    "dev:web": "npm run dev --workspace=@modelscript/web",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d",
    "doctor:dev": "npx tsx scripts/dev-doctor.ts",
    "ee:keygen": "npx tsx ee/src/cli/license-cli.ts keygen",
    "ee:sign-license": "npx tsx ee/src/cli/license-cli.ts issue",
    "ee:verify-license": "npx tsx ee/src/cli/license-cli.ts verify",
    "fetch:benchmarks": "npx tsx scripts/fetch-benchmarks.ts",
    "format": "prettier . --write",
    "lint": "node scripts/nx-coordinator.js affected --target=lint && npm run lint:scripts",
    "lint:all": "node scripts/nx-coordinator.js run-many --target=lint && npm run lint:scripts",
    "lint:cycles": "node scripts/check-nx-cycles.js",
    "lint:filenames": "npx tsx scripts/lint-filenames.ts",
    "lint:headers": "npx tsx scripts/normalize-headers.ts --check",
    "lint:lockfile": "npx tsx scripts/lint-lockfile.ts",
    "lint:manifests": "npx tsx scripts/lint-package-manifests.ts",
    "lint:repo": "npx tsx scripts/repo-doctor.ts",
    "lint:scripts": "eslint scripts eslint.config.ts --no-warn-ignored",
    "lint:types-ratchet": "npx tsx scripts/lint-type-safety-ratchet.ts",
    "lint:versions": "npx tsx scripts/sync-versions.ts --check",
    "package:desktop": "npx nx build @modelscript/web && npm run build:tauri --workspace=@modelscript/desktop",
    "package:desktop:portable": "npx nx build @modelscript/web && npm run build:portable --workspace=@modelscript/desktop",
    "package:ide:extension": "npm run build-extension --workspace=@modelscript/ide && (cd apps/ide/dist/extension && npx --yes @vscode/vsce@3.3.2 package --no-dependencies --out ../)",
    "preflight:prod": "npx tsx scripts/ops/preflight-audit.ts",
    "prepare": "husky",
    "preview:ide": "npx tsx apps/ide/src/preview-static.ts",
    "release": "NODE_OPTIONS='--require ./scripts/nx-minimatch-shim.cjs' nx release",
    "release:dry-run": "npx tsx scripts/ci-release-version.ts --dry-run",
    "sync:versions": "npx tsx scripts/sync-versions.ts",
    "test": "node scripts/test-coordinator.js affected",
    "test:all": "node scripts/test-coordinator.js run-many",
    "test:benchmarks": "npx tsx testsuite/benchmarks/cae-parity.test.ts && npx tsx testsuite/benchmarks/polyglot-parity.test.ts && npx tsx testsuite/benchmarks/industrial-scale.test.ts",
    "test:benchmarks:cae": "npx tsx testsuite/benchmarks/cae-parity.test.ts",
    "test:benchmarks:cantera": "npx tsx languages/cantera/tests/cantera-benchmark-runner.ts",
    "test:benchmarks:epanet": "npx tsx languages/epanet/tests/epanet-benchmark-runner.ts",
    "test:benchmarks:febio": "npx tsx languages/febio/tests/febio-benchmark-runner.ts",
    "test:benchmarks:industrial": "npx tsx testsuite/benchmarks/industrial-scale.test.ts",
    "test:benchmarks:opendss": "npx tsx languages/opendss/tests/opendss-benchmark-runner.ts",
    "test:benchmarks:opensim": "npx tsx languages/opensim/tests/opensim-benchmark-runner.ts",
    "test:benchmarks:polyglot": "npx tsx testsuite/benchmarks/polyglot-parity.test.ts",
    "test:benchmarks:sbml": "npx tsx languages/sbml/tests/sbml-benchmark-runner.ts",
    "test:benchmarks:verilog-a": "npx tsx languages/verilog-a/tests/va-benchmark-runner.ts",
    "test:compiler": "node scripts/test-coordinator.js run-many --projects=@modelscript/dsl,@modelscript/runtime,@modelscript/simulate,@modelscript/cad,@modelscript/diagram",
    "test:consolidate": "npx tsx scripts/consolidate-test-reports.ts",
    "test:durations:sync": "node scripts/sync-test-durations.js",
    "test:fast": "node scripts/test-coordinator.js affected",
    "test:modelica": "npx tsx languages/modelica/tests/testsuite-runner.ts",
    "test:modelica:both": "npx tsx languages/modelica/tests/testsuite-runner.ts --flattener=both",
    "test:modelica:both:allow-wasm": "npx tsx languages/modelica/tests/testsuite-runner.ts --flattener=both --allow-wasm-failures --wasm-baseline=languages/modelica/tests/wasm-parity-baseline.json",
    "test:modelica:coverage": "npm run test:omc:coverage --workspace=@modelscript/modelica",
    "test:modelica:js": "npx tsx languages/modelica/tests/testsuite-runner.ts --flattener=ts",
    "test:modelica:update": "npx tsx languages/modelica/tests/testsuite-runner.ts --update --omc",
    "test:modelica:wasm": "npx tsx languages/modelica/tests/testsuite-runner.ts --flattener=wasm",
    "test:msl": "npx tsx languages/modelica/tests/msl-comparison-runner.ts",
    "test:msl:diagram": "npx tsx languages/modelica/tests/msl-comparison-runner.ts --stage=diagram",
    "test:msl:flatten": "npx tsx languages/modelica/tests/msl-comparison-runner.ts --stage=flatten",
    "test:msl:icon": "npx tsx languages/modelica/tests/msl-comparison-runner.ts --stage=icon",
    "test:msl:sim": "npx tsx languages/modelica/tests/msl-comparison-runner.ts --stage=simulate",
    "test:platform": "node scripts/test-coordinator.js run-many --projects=@modelscript/api,@modelscript/web,@modelscript/embed,@modelscript/react",
    "test:single": "npx tsx languages/modelica/tests/testsuite-runner.ts",
    "typecheck": "node scripts/nx-coordinator.js affected --target=typecheck",
    "typecheck:all": "node scripts/nx-coordinator.js run-many --target=typecheck",
    "verify:all": "node scripts/nx-coordinator.js run-many -t lint,typecheck,build --skip-nx-cache",
    "verify:dist": "npx tsx scripts/verify-dist-integrity.ts",
    "verify:fresh": "node scripts/nx-coordinator.js affected -t lint,typecheck,build --uncommitted --skip-nx-cache",
    "verify:pack": "npx tsx scripts/verify-pack-install.ts",
    "version:bump": "npx tsx scripts/sync-versions.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npx tsx scripts/lint-filenames.ts",
      "eslint --config eslint.config.ts --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{js,mjs,cjs,json,md,yml,css}": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "@antv/x6-plugin-selection": {
      "@antv/x6": "^3.1.7"
    },
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "@hono/node-server": "^1.19.15",
    "@humanfs/node": "^0.16.8",
    "@mermaid-js/parser": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelscript/cli": {
      "@npmcli/package-json": {
        "glob": "^14.0.3"
      },
      "glob": "^14.0.3"
    },
    "@modelscript/docs": {
      "mermaid": {
        "katex": "^0.19.1"
      },
      "vitepress": {
        "vite": "^6.4.5"
      }
    },
    "@modelscript/ide-client": {
      "vscode-languageclient": {
        "minimatch": "^11.0.3"
      },
      "minimatch": "^11.0.3"
    },
    "@modelscript/web": {
      "mermaid": {
        "katex": "^0.19.1"
      }
    },
    "@npmcli/package-json": {
      "glob": "^14.0.3"
    },
    "@nx/devkit": {
      "brace-expansion": "^5.0.12"
    },
    "@simple-git/argv-parser": "^2.0.1",
    "@vue/server-renderer": "^3.5.44",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.25",
    "body-parser": "^2.4.0",
    "browserslist": "^4.28.7",
    "d3-color": "^3.1.0",
    "deepmerge": "npm:@stackline/deepmerge@^1.1.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.9",
    "fflate": "^0.8.3",
    "follow-redirects": "^1.16.2",
    "form-data": "^4.0.6",
    "glob": "^14.0.3",
    "hono": "^4.13.5",
    "http-cache-semantics": "^4.3.0",
    "image-size": "^2.0.4",
    "immutable": "^5.1.8",
    "ip-address": "^10.7.5",
    "js-yaml": "^4.3.2",
    "katex": "^0.19.1",
    "mermaid": {
      "katex": "^0.19.1"
    },
    "minimatch": "^11.0.3",
    "monaco-editor": {
      "dompurify": "^3.4.17"
    },
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nanoid": "^3.3.18",
    "nx": {
      "brace-expansion": "^5.0.12"
    },
    "postcss": "^8.5.23",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "simple-git": "^4.0.2",
    "smol-toml": "^1.7.1",
    "source-map-js": "^1.2.2",
    "three": "^0.184.0",
    "tmp": "^0.2.7",
    "undici": "^7.30.1",
    "uuid": "^11.1.1",
    "vitepress": {
      "vite": "^6.4.5"
    },
    "vscode-languageclient": {
      "minimatch": "^11.0.3"
    },
    "vue": "^3.5.44",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/config-array": "^0.19.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nx/js": "^22.7.12",
    "@types/node": "^25.3.2",
    "ajv": "^8.17.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "expect": "^30.5.2",
    "glob": "^14.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "lodash.merge": "^4.6.2",
    "nx": "^22.7.12",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.0",
    "source-map": "^0.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=24"
  }
}
