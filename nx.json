{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": ["@nx/js"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/**/scratch*/**",
      "!{projectRoot}/**/scratch_*/**",
      "!{projectRoot}/**/.cache/**",
      "!{projectRoot}/**/ctrf/**",
      "!{projectRoot}/**/coverage/**",
      "!{projectRoot}/**/*.tsbuildinfo",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/build/**",
      "!{projectRoot}/as-gen/**",
      "!{projectRoot}/src/src-gen/**",
      "!{projectRoot}/src-gen/**"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/build",
        "{projectRoot}/src-gen",
        "{projectRoot}/src/src-gen",
        "{projectRoot}/as-gen",
        "{projectRoot}/public",
        "{projectRoot}/src/**/*.js",
        "{projectRoot}/*.wasm",
        "{projectRoot}/build/**/*.wasm",
        "{projectRoot}/.cache"
      ],
      "maxParallel": 4
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build", "build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/ctrf"],
      "maxParallel": 2
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "maxParallel": 4
    }
  },
  "release": {
    "projects": [
      "packages/dsl",
      "packages/runtime",
      "packages/simulate",
      "packages/diagram",
      "packages/exchange",
      "packages/lsp",
      "packages/cad",
      "packages/mcp",
      "languages/modelica",
      "languages/sysml2",
      "languages/step",
      "languages/scad",
      "languages/owl2",
      "languages/ssp",
      "languages/csv",
      "languages/cfd",
      "languages/fea",
      "apps/api",
      "apps/cli"
    ],
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": true
    },
    "git": {
      "commit": true,
      "tag": true
    }
  },
  "analytics": false,
  "tui": false
}
