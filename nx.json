{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": ["@nx/js"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/**/scratch*",
      "!{projectRoot}/**/scratch*/**",
      "!{projectRoot}/**/scratch_*",
      "!{projectRoot}/**/scratch_*/**",
      "!{projectRoot}/.cache/**",
      "!{projectRoot}/**/.cache/**",
      "!{projectRoot}/ctrf/**",
      "!{projectRoot}/**/ctrf/**",
      "!{projectRoot}/coverage/**",
      "!{projectRoot}/**/coverage/**",
      "!{projectRoot}/data/**",
      "!{projectRoot}/apps/**",
      "!{projectRoot}/public/**",
      "!{projectRoot}/tests/asc_error.log",
      "!{projectRoot}/validation/fmi/exported_fmus/**",
      "!{projectRoot}/validation/fmi/reference_fmus/**",
      "!{projectRoot}/validation/fmi/reference_fmus_repo/**",
      "!{projectRoot}/testsuite/**/*.o",
      "!{projectRoot}/testsuite/**/*.so",
      "!{projectRoot}/testsuite/**/*.libs",
      "!{projectRoot}/testsuite/**/*.log",
      "!{projectRoot}/testsuite/**/*.makefile",
      "!{projectRoot}/testsuite/**/*_records.c",
      "!{projectRoot}/testsuite/**/*_includes.h",
      "!{projectRoot}/testsuite/**/*_merged_table.json",
      "!{projectRoot}/.tsbuildinfo",
      "!{projectRoot}/**/*.tsbuildinfo",
      "!{projectRoot}/*.wasm",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/build/**",
      "!{projectRoot}/as-gen/**",
      "!{projectRoot}/src/src-gen/**",
      "!{projectRoot}/src-gen/**",
      "!{projectRoot}/docs/.vitepress/dist/**",
      "!{projectRoot}/docs/.vitepress/cache/**",
      "!{projectRoot}/vscode-web/**",
      "!{projectRoot}/models/**"
    ],
    "production": [
      "default",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/testsuite/**",
      "!{projectRoot}/validation/**",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.ts",
      "{workspaceRoot}/scripts/build-language-parser.js",
      "{workspaceRoot}/scripts/build-language-wasm.js",
      "{workspaceRoot}/scripts/test-runner.js",
      "{workspaceRoot}/scripts/asc-cache.js",
      "{workspaceRoot}/scripts/node-test-ctrf-reporter.cjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/build",
        "{projectRoot}/src-gen",
        "{projectRoot}/src/src-gen",
        "{projectRoot}/as-gen",
        "{projectRoot}/*.wasm",
        "{projectRoot}/build/**/*.wasm",
        "{projectRoot}/.cache/*.wasm",
        "{projectRoot}/.cache/*.hash",
        "{projectRoot}/.cache/bindings.js",
        "{projectRoot}/.cache/bindings.d.ts",
        "{projectRoot}/.tsbuildinfo",
        "{projectRoot}/*.tsbuildinfo",
        "{projectRoot}/docs/.vitepress/dist"
      ],
      "maxParallel": 8
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build", "build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/ctrf"]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "maxParallel": 4
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "maxParallel": 4
    }
  },
  "release": {
    "projects": ["packages/*", "!packages/ide", "!packages/examples/*", "languages/*", "apps/api", "apps/cli"],
    "projectsRelationship": "fixed",
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": false
    },
    "git": {
      "commit": true,
      "tag": true
    }
  },
  "analytics": false,
  "tui": {
    "autoExit": true
  }
}
