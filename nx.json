{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": ["@nx/js"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/**/scratch*/**",
      "!{projectRoot}/**/scratch_*/**",
      "!{projectRoot}/**/.cache/**",
      "!{projectRoot}/**/ctrf/**",
      "!{projectRoot}/**/coverage/**",
      "!{projectRoot}/**/*.tsbuildinfo",
      "!{projectRoot}/as-gen/**",
      "!{projectRoot}/src/src-gen/**",
      "!{projectRoot}/src-gen/**"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/build",
        "{projectRoot}/src-gen",
        "{projectRoot}/src/src-gen",
        "{projectRoot}/as-gen",
        "{projectRoot}/public",
        "{projectRoot}/src/**/*.js",
        "{projectRoot}/*.wasm",
        "{projectRoot}/build/**/*.wasm",
        "{projectRoot}/.cache"
      ],
      "maxParallel": 4
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build", "build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/ctrf"],
      "maxParallel": 2
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "maxParallel": 4
    }
  },
  "release": {
    "projects": ["packages/dsl", "packages/runtime", "languages/modelica", "apps/cli"],
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": true
    },
    "git": {
      "commit": true,
      "tag": true
    }
  },
  "analytics": false,
  "tui": false
}
