packages/exchange/validation/fmi/reference_fmus
packages/exchange/validation/fmi/reference_fmus_repo
scripts/*.zip
!scripts/ModelicaStandardLibrary_v4.1.0.zip
!scripts/SysML-v2-Release-2026-03.zip

# Package-specific runtime data
apps/api/data
apps/api/uploads

# Exclude all dist/build directories by default...
dist
build

# ...but re-include the ones needed by PREBUILT=true mode
!apps/api/dist
!apps/cli/dist
!apps/web/dist
!apps/docs/docs/.vitepress/dist
!apps/ide/dist
!apps/ide/vscode-web
!apps/ide/github-fs/dist
