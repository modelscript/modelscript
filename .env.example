# ==============================================================================
# ModelScript Environment Configuration
# ==============================================================================
# Usage:
#   cp .env.example .env
#
# Standalone Launch ($6 DigitalOcean Droplet: 1 vCPU / 1 GB RAM):
#   docker compose --profile standalone up -d
#
# Full / Federated Stack (with TimescaleDB Historian & Mosquitto MQTT):
#   docker compose --profile federated up -d
# ==============================================================================

# Public domain name for TLS (Let's Encrypt / ZeroSSL via Caddy)
PUBLIC_DOMAIN=localhost

# Application runtime mode
NODE_ENV=production
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# Node.js memory ceiling (crucial for 1 GB RAM servers to prevent OOM)
NODE_OPTIONS="--max-old-space-size=450"

# ------------------------------------------------------------------------------
# Git & NPM Registry Delegation (Zero Local Package / Git Storage)
# ------------------------------------------------------------------------------
# Upstream GitLab CE / GitHub URL for package & repo proxying
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# ------------------------------------------------------------------------------
# Optional Services (Leave EMPTY for Standalone $6 Launch)
# ------------------------------------------------------------------------------
# For Standalone: leave blank. TimescaleDB and Mosquitto will NOT run.
# For Federated / Internal: set to the internal service URLs:
# MQTT_BROKER_URL=mqtt://mqtt:1883
# TIMESCALE_URL=postgresql://modelscript:modelscript@timescaledb:5432/modelscript_historian
# TIMESCALE_PASSWORD=modelscript
MQTT_BROKER_URL=
TIMESCALE_URL=

# ------------------------------------------------------------------------------
# Federation & HPC / Remote Solvers (Optional)
# ------------------------------------------------------------------------------
FEDERATION_MODE=disabled
# HPC_BACKEND=local # Options: local | slurm | slurm-rest
# SLURM_REST_URL=http://localhost:6820
