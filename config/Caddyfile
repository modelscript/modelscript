# Caddy configuration for ModelScript (modelscript.org) & Ansatz (ansatz.social)
# Automatically provisions and renews Let's Encrypt / ZeroSSL TLS certificates

# Redirect Morsel subdomain to Ansatz Morsel on ansatz.social
morsel.modelscript.org {
    # Route embed links to /embed/morsel
    @embed path /embed /embed/*
    redir @embed https://ansatz.social/embed/morsel{?query} permanent

    # Route root directly to /morsel
    @root path /
    redir @root https://ansatz.social/morsel{?query} permanent

    # Route all other paths under /morsel
    redir https://ansatz.social/morsel{uri} permanent
}

# Redirect legacy IDE subdomain to Studio on ansatz.social
ide.modelscript.org {
    # Route root directly to /studio
    @root path /
    redir @root https://ansatz.social/studio{?query} permanent

    # Route /ide or /ide/* directly to /studio
    @ide path /ide /ide/*
    redir @ide https://ansatz.social/studio{?query} permanent

    # Route all other paths under /studio
    redir https://ansatz.social/studio{uri} permanent
}

{$PUBLIC_DOMAIN:localhost}, {$DOCS_DOMAIN:http://docs.localhost} {
    # Encode responses with gzip or zstd
    encode gzip zstd

    # Route ActivityPub, Git Smart HTTP, npm Registry, SysML v2 REST API, and API traffic to backend API
    handle /api/* {
        reverse_proxy api:3000
    }
    handle /git/* {
        reverse_proxy api:3000
    }
    handle /-/* {
        reverse_proxy api:3000
    }
    handle /projects {
        reverse_proxy api:3000
    }
    handle /projects/* {
        reverse_proxy api:3000
    }
    handle /.well-known/* {
        reverse_proxy api:3000
    }
    handle /security.txt {
        reverse_proxy api:3000
    }
    handle /nodeinfo/* {
        reverse_proxy api:3000
    }
    handle /users/* {
        reverse_proxy api:3000
    }
    handle /actor* {
        reverse_proxy api:3000
    }
    handle /inbox* {
        reverse_proxy api:3000
    }
    handle /thumbnails/* {
        reverse_proxy api:3000
    }
    handle /avatars/* {
        reverse_proxy api:3000
    }
    handle /banners/* {
        reverse_proxy api:3000
    }
    handle /uploads/* {
        reverse_proxy api:3000
    }
    handle /legal* {
        reverse_proxy api:3000
    }
    handle /health* {
        reverse_proxy api:3000
    }

    # Route MQTT over WebSockets to Mosquitto broker
    handle /mqtt* {
        reverse_proxy mqtt:9001
    }

    # Route Web IDE Workbench & Assets to unified API service
    handle /vscode/* {
        reverse_proxy api:3000
    }
    handle /vscode-static/* {
        reverse_proxy api:3000
    }
    handle /static/* {
        reverse_proxy api:3000
    }
    handle /embed/solution/* {
        reverse_proxy api:3000
    }

    # Reject hidden dotfile probes (/.env, /.git/config, /live/.env, /.env.swp, etc.) and scanner scripts (/wp-login.php, etc.)
    @blocked_probes {
        not path /.well-known/*
        path_regexp blocked_probe (?i)(?:^|/)\.(?:env|git|svn|hg|htaccess|htpasswd|DS_Store|npmrc|dockerenv)(?:$|[./])|\.(?:php|asp|aspx|jsp|cgi|swp|swo|bak)$|^/(?:wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|pma|adminer)(?:/|$)
    }
    handle @blocked_probes {
        respond "Not Found" 404
    }

    # Route Unified Web SPA, IDE Shell & Documentation Portal (all other requests)
    handle {
        reverse_proxy web:80
    }

    # Graceful Maintenance Fallback when upstream containers are restarting (502/503/504)
    handle_errors {
        @upstream_down expression `{err.status_code} in [502, 503, 504]`
        handle @upstream_down {
            @api_req path /api/* /git/* /-/* /projects /projects/*
            handle @api_req {
                header Content-Type "application/json"
                header Retry-After "30"
                respond `{"error":"Service is temporarily restarting for scheduled maintenance.","maintenanceMode":true,"retryAfterSeconds":30}` 503
            }
            handle {
                rewrite * /maintenance.html
                reverse_proxy web:80
            }
        }
    }
}

