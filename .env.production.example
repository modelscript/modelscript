# ==============================================================================
# ModelScript & Ansatz Production Environment Configuration (.env.production.example)
#
# Supported Deployment Profiles:
#   1. Flagship Hub (modelscript.org + ansatz.social):
#        docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#          --env-file .env.production --profile flagship up -d
#
#   2. Independent Federated Lab (Full with TimescaleDB Telemetry Historian):
#        docker compose --profile federated up -d
#
#   3. Lightweight Federated Homelab (Embedded SQLite only, low RAM ~1-2GB):
#        docker compose --profile federated-lite up -d
#
#   4. Corporate Intranet Appliance (Air-Gapped / SCIF / SSO):
#        docker compose --profile corporate up -d
#
#   5. Ephemeral Quick Tunnel (1-click trycloudflare.com demo):
#        docker compose --profile quick-tunnel up
# ==============================================================================

NODE_ENV=production
PORT=3000

# ── 1. Domain & Ingress Routing ──
PUBLIC_DOMAIN=ansatz.social
DOCS_DOMAIN=modelscript.org
PUBLIC_URL=https://ansatz.social
CORS_ALLOWED_ORIGINS=https://ansatz.social,https://modelscript.org,https://ide.ansatz.social,https://ide.modelscript.org

# Host Port Bindings (Optional: Leave empty or custom port if port 80/443 is occupied on the host)
HTTP_PORT=80
HTTPS_PORT=443

# ── 2. Cloudflare Zero Trust Tunnel (Zero Open Inbound Ports) ──
# Token from Cloudflare Zero Trust (Networks -> Tunnels -> Create Tunnel)
# Point public hostname to: http://caddy:80
CLOUDFLARE_TUNNEL_TOKEN=

# ── 3. Headless Preinstallation & Deployment Preset ──
# Available presets:
#   - tier3_flagship: Public flagship hub at ansatz.social with docs linking to modelscript.org
#   - tier1_federated: Independent research node with open ActivityPub S2S federation
#   - tier2_corporate: Corporate intranet with airgapped settings and internal /docs
#   - tier0_local_dev: Offline workstation sandbox
DEPLOYMENT_PRESET=tier3_flagship
AUTO_SEED_ADMIN=true
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_EMAIL=admin@ansatz.social
ADMIN_INIT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── 4. Edition & Offline Ed25519 Enterprise License Enforcement ──
# Set MSX_EDITION=ee for Enterprise Cloud / Intranet Appliance, or MSX_EDITION=ce
# for pure AGPL-3.0 Community Edition.
MSX_EDITION=ee
MSX_LICENSE_ENFORCE=true

# Pre-minted 10-year production cloud license signed by .keys/msx-license-private.pem
# (For customer appliances, mint a customer-specific token via `npm run ee:sign-license`)
MSX_LICENSE_KEY=msx_lic_.64j0bXp_9P75-VeAB0OD0NShj_RKpH6V1DAhcNnicIXohn8UIl2Q_uP3XO0tDJUbLtVTD-HL4pgws-JHPlZ9BQ

# ── 5. Enterprise Intranet Appliance & Air-Gap Controls (NERC CIP / FERC CEII) ──
# Set to "true" for single-container on-premise utility/defense deployments
ENTERPRISE_APPLIANCE=false
AIRGAP_ENFORCED=false

# ── 6. Cryptographic Session & TOTP / BYOK Vault Secrets ──
# Generate via: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
BOT_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── 7. Email / SMTP Delivery (SendGrid or standard SMTP) ──
EMAIL_DRIVER=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@ansatz.social
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── 8. Cloudflare Turnstile Anti-Bot Protection ──
TURNSTILE_SECRET_KEY=

# ── 9. Stripe Cloud Compute Wallet & Subscription Billing ──
# Required for Pro ($29/mo), Team ($149/seat/mo), and HPC Compute Credit top-ups
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_TEAM_SEAT_MONTHLY=price_team_seat_monthly_id

# ── 10. Corporate SSO (OIDC / SAML 2.0 / Active Directory) ──
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://modelscript.org/api/v1/auth/oidc/callback

# ── 11. Slurm HPC & TimescaleDB Digital Twin Historian (Optional) ──
HPC_BACKEND=local
SLURM_REST_URL=
SLURM_USER=
SLURM_JWT_TOKEN=
TIMESCALE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_HERE
TIMESCALE_URL=postgres://modelscript:modelscript@timescaledb:5432/modelscript_historian
MQTT_BROKER_URL=mqtt://mqtt:1883
