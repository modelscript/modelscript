# ==============================================================================
# ModelScript & Ansatz Production Environment Configuration (.env.production.example)
# Copy to `.env.production` (gitignored) when deploying modelscript.org + ansatz.social
# Cloud or an Enterprise Intranet Appliance.
# ==============================================================================

NODE_ENV=production
PORT=3000
PUBLIC_DOMAIN=ansatz.social
DOCS_DOMAIN=modelscript.org
PUBLIC_URL=https://ansatz.social
CORS_ALLOWED_ORIGINS=https://ansatz.social,https://modelscript.org,https://ide.ansatz.social,https://ide.modelscript.org

# ── 1. Edition & Offline Ed25519 Enterprise License Enforcement ──
# Set MSX_EDITION=ee for Enterprise Cloud / Intranet Appliance, or MSX_EDITION=ce
# for pure AGPL-3.0 Community Edition.
MSX_EDITION=ee
MSX_LICENSE_ENFORCE=true

# Pre-minted 10-year production cloud license signed by .keys/msx-license-private.pem
# (For customer appliances, mint a customer-specific token via `npm run ee:sign-license`)
MSX_LICENSE_KEY=msx_lic_.64j0bXp_9P75-VeAB0OD0NShj_RKpH6V1DAhcNnicIXohn8UIl2Q_uP3XO0tDJUbLtVTD-HL4pgws-JHPlZ9BQ

# ── 2. Enterprise Intranet Appliance & Air-Gap Controls (NERC CIP / FERC CEII) ──
# Set to "true" for single-container on-premise utility/defense deployments
ENTERPRISE_APPLIANCE=false
AIRGAP_ENFORCED=false

# ── 3. Cryptographic Session & BYOK Vault Secrets ──
# Generate via: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
BOT_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── 4. Stripe Cloud Compute Wallet & Subscription Billing ──
# Required for Pro ($29/mo), Team ($149/seat/mo), and HPC Compute Credit top-ups
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_TEAM_SEAT_MONTHLY=price_team_seat_monthly_id

# ── 5. Corporate SSO (OIDC / SAML 2.0 / Active Directory) ──
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://modelscript.org/api/v1/auth/oidc/callback

# ── 6. Slurm HPC & TimescaleDB Digital Twin Historian (Optional) ──
HPC_DRIVER=local
SLURM_REST_URL=
TIMESCALE_URL=
MQTT_BROKER_URL=
