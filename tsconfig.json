{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@modelscript/dsl": ["./packages/dsl/src/index.ts"],
      "@modelscript/dsl/utils": ["./packages/dsl/src/utils/index.ts"],
      "@modelscript/dsl/*": ["./packages/dsl/src/*", "./packages/dsl/src/*/index.ts"],
      "@modelscript/runtime": ["./packages/runtime/src/index.ts"],
      "@modelscript/runtime/*": ["./packages/runtime/src/*"],
      "@modelscript/simulate": ["./packages/simulate/src/index.ts"],
      "@modelscript/simulate/*": ["./packages/simulate/src/*"],
      "@modelscript/diagram": ["./packages/diagram/src/index.ts"],
      "@modelscript/diagram/*": ["./packages/diagram/src/*"],
      "@modelscript/cad": ["./packages/cad/src/index.ts"],
      "@modelscript/cad/*": ["./packages/cad/src/*"],
      "@modelscript/exchange": ["./packages/exchange/src/index.ts"],
      "@modelscript/exchange/*": ["./packages/exchange/src/*"],
      "@modelscript/lsp": ["./packages/lsp/src/index.ts"],
      "@modelscript/lsp/*": ["./packages/lsp/src/*"],
      "@modelscript/mcp": ["./packages/mcp/src/index.ts"],
      "@modelscript/mcp/*": ["./packages/mcp/src/*"],
      "@modelscript/ide-client": ["./packages/ide/src/browser-client-main.ts"],
      "@modelscript/ide-client/*": ["./packages/ide/src/*"],
      "@modelscript/modelica": ["./languages/modelica/src/index.ts"],
      "@modelscript/modelica/parser": ["./languages/modelica/src-gen/bindings.js"],
      "@modelscript/modelica/*": ["./languages/modelica/src/*"],
      "@modelscript/sysml2": ["./languages/sysml2/src/index.ts"],
      "@modelscript/sysml2/factory": ["./languages/sysml2/src/factory.ts"],
      "@modelscript/sysml2/parser": ["./languages/sysml2/src-gen/bindings.js"],
      "@modelscript/sysml2/*": ["./languages/sysml2/src/*"],
      "@modelscript/owl2": ["./languages/owl2/src/index.ts"],
      "@modelscript/owl2/parser": ["./languages/owl2/src-gen/bindings.js"],
      "@modelscript/owl2/*": ["./languages/owl2/src/*"],
      "@modelscript/pscad": ["./languages/pscad/src/index.ts"],
      "@modelscript/pscad/parser": ["./languages/pscad/src/parser/pscx-parser.ts"],
      "@modelscript/pscad/*": ["./languages/pscad/src/*"],
      "@modelscript/step": ["./languages/step/src/index.ts"],
      "@modelscript/step/parser": ["./languages/step/src-gen/bindings.js"],
      "@modelscript/step/*": ["./languages/step/src/*"],
      "@modelscript/scad": ["./languages/scad/src/index.ts"],
      "@modelscript/scad/parser": ["./languages/scad/src-gen/bindings.js"],
      "@modelscript/scad/*": ["./languages/scad/src/*"],
      "@modelscript/csv": ["./languages/csv/language.ts"],
      "@modelscript/csv/language": ["./languages/csv/language.ts"],
      "@modelscript/csv/parser": ["./languages/csv/src-gen/bindings.js"],
      "@modelscript/csv/*": ["./languages/csv/*", "./languages/csv/src/*"],
      "@modelscript/cfd": ["./languages/cfd/src/index.ts"],
      "@modelscript/cfd/*": ["./languages/cfd/src/*"],
      "@modelscript/fea": ["./languages/fea/src/index.ts"],
      "@modelscript/fea/*": ["./languages/fea/src/*"],
      "@modelscript/ssp": ["./languages/ssp/src/index.ts"],
      "@modelscript/ssp/*": ["./languages/ssp/src/*"],
      "@modelscript/modelscript": ["./languages/modelscript/src/index.ts"],
      "@modelscript/modelscript/parser": ["./languages/modelscript/src-gen/bindings.js"],
      "@modelscript/modelscript/*": ["./languages/modelscript/src/*"]
    }
  },
  "include": ["scripts/**/*", "eslint.config.ts"],
  "exclude": ["scripts/benchmark-polyglot-incremental.ts"]
}
