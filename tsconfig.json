{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@modelscript/dsl": ["./packages/dsl/src/index.ts"],
      "@modelscript/dsl/utils": ["./packages/dsl/src/utils/index.ts"],
      "@modelscript/dsl/xml": ["./packages/dsl/src/xml/index.ts"],
      "@modelscript/dsl/*": ["./packages/dsl/src/*", "./packages/dsl/src/*/index.ts"],
      "@modelscript/runtime": ["./packages/runtime/src/index.ts"],
      "@modelscript/runtime/*": [
        "./packages/runtime/src/*",
        "./packages/runtime/src/dae/*",
        "./packages/runtime/src/workspace/*",
        "./packages/runtime/src/solvers/*",
        "./packages/runtime/src/autodiff/*",
        "./packages/runtime/src/analysis/*",
        "./packages/runtime/src/ontology/*",
        "./packages/runtime/src/statemachine/*",
        "./packages/runtime/src/simulation/*",
        "./packages/runtime/src/gpu/*",
        "./packages/runtime/src/config/*",
        "./packages/runtime/src/interop/*",
