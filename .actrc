# .actrc - Configuration for running GitHub Actions locally via act (nektos/act)

# Map GitHub Actions runner to standard Ubuntu image
-P ubuntu-latest=catthehacker/ubuntu:act-latest

# Environment variables
--env CI=true
--env GITHUB_ACTIONS=true
--env ACT=true

# Force amd64 architecture
--container-architecture linux/amd64

# Enable local artifact server for actions/upload-artifact@v4
--artifact-server-path=.cache/act-artifacts

# Default event payload for pull_request events (needed by nrwl/nx-set-shas)
--eventpath=.github/act-event.json
