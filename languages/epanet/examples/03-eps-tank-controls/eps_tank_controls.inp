 BoostPump       LakeSource   J10          HEAD PumpH1

[CURVES]
;ID              X-Value      Y-Value
 PumpH1          0            80
 PumpH1          50           72
 PumpH1          100          54

[PATTERNS]
;ID              Multipliers
 Pat1            0.55  0.50  0.65  1.15  1.40  1.25
