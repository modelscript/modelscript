# GDSII ASCII Stream: Hierarchical 2-Input CMOS NAND Gate with SREF Contact Cell
HEADER 600
BGNLIB
LIBNAME NAND2_HIER_LIB
UNITS 1e-3 1e-9

BGNSTR
STRNAME CONTACT_STD
  BOUNDARY
  LAYER 4
  DATATYPE 0
  XY 0: 0  240: 0  240: 240  0: 240  0: 0
  ENDEL
ENDSTR

BGNSTR
STRNAME NAND2_X1
  # N-Well
  BOUNDARY
  LAYER 1
  DATATYPE 0
  XY 0: 1800  3600: 1800  3600: 3600  0: 3600  0: 1800
  ENDEL
  # PMOS Active
  BOUNDARY
  LAYER 2
  DATATYPE 0
  XY 300: 2100  3300: 2100  3300: 2800  300: 2800  300: 2100
  ENDEL
  # NMOS Active
  BOUNDARY
  LAYER 2
  DATATYPE 0
  XY 300: 600  3300: 600  3300: 1200  300: 1200  300: 600
  ENDEL
  # Poly Gate A and Poly Gate B
  BOUNDARY
  LAYER 3
  DATATYPE 0
  XY 1000: 400  1300: 400  1300: 3000  1000: 3000  1000: 400
  ENDEL
  BOUNDARY
  LAYER 3
  DATATYPE 0
  XY 2100: 400  2400: 400  2400: 3000  2100: 3000  2100: 400
  ENDEL
  # Reusable SREF Contact Placements
  SREF
  SNAME CONTACT_STD
  XY 500: 2330
  ENDEL
  SREF
  SNAME CONTACT_STD
  XY 1580: 2330
  ENDEL
  SREF
  SNAME CONTACT_STD
  XY 2760: 2330
  ENDEL
  SREF
  SNAME CONTACT_STD
  XY 500: 780
  ENDEL
  SREF
  SNAME CONTACT_STD
  XY 2760: 780
  ENDEL
  # Metal-1 Power Rails and Output Net
  PATH
  LAYER 5
  DATATYPE 0
  PATHTYPE 2
  WIDTH 400
  XY 0: 3400  3600: 3400
  ENDEL
  PATH
  LAYER 5
  DATATYPE 0
  PATHTYPE 2
  WIDTH 400
  XY 0: 200  3600: 200
  ENDEL
  BOUNDARY
  LAYER 5
  DATATYPE 0
  XY 2680: 700  3080: 700  3080: 2700  2680: 2700  2680: 700
  ENDEL
  TEXT
  LAYER 5
  TEXTTYPE 0
  XY 1800: 3400
  STRING "VDD"
  ENDEL
  TEXT
  LAYER 5
  TEXTTYPE 0
  XY 1800: 200
  STRING "GND"
  ENDEL
  TEXT
  LAYER 5
  TEXTTYPE 0
  XY 2880: 1700
  STRING "ZN"
  ENDEL
ENDSTR
ENDLIB
