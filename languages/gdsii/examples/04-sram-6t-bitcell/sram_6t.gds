# GDSII ASCII Stream: Symmetric 6T SRAM Bitcell with SREF Mirroring & AREF Contacts
HEADER 600
BGNLIB
LIBNAME SRAM_6T_LIB
UNITS 1e-3 1e-9

BGNSTR
STRNAME BIT_CONTACT
  BOUNDARY
  LAYER 4
  DATATYPE 0
  XY 0: 0  240: 0  240: 240  0: 240  0: 0
  ENDEL
ENDSTR

BGNSTR
STRNAME SRAM_HALF
  # Half-cell Active Diffusion
  BOUNDARY
  LAYER 2
  DATATYPE 0
  XY 200: 400  1600: 400  1600: 1100  200: 1100  200: 400
  ENDEL
  # Cross-coupled Inverter Poly Gate
  BOUNDARY
  LAYER 3
  DATATYPE 0
  XY 750: 200  1050: 200  1050: 1400  750: 1400  750: 200
  ENDEL
  # Array of 2 Source/Drain Contacts
  AREF
  SNAME BIT_CONTACT
  COLROW 2 1
  XY 350: 630  1950: 630  350: 1230
  ENDEL
ENDSTR

BGNSTR
STRNAME SRAM_6T_BITCELL
  # Shared Center N-Well
  BOUNDARY
  LAYER 1
  DATATYPE 0
  XY 0: 1500  4200: 1500  4200: 3100  0: 3100  0: 1500
  ENDEL
  # Left Half-Cell
  SREF
  SNAME SRAM_HALF
  XY 200: 200
  ENDEL
  # Mirrored Right Half-Cell
  SREF
  SNAME SRAM_HALF
  STRANS 1000000000000000
  MAG 1.0
  ANGLE 0.0
  XY 2200: 3000
  ENDEL
  # Wordline (Metal-1)
  PATH
  LAYER 5
  DATATYPE 0
  PATHTYPE 2
  WIDTH 320
  XY 0: 3400  4200: 3400
  ENDEL
  # Bitline BL and BLB (Metal-2, Layer 7)
  PATH
  LAYER 7
  DATATYPE 0
  PATHTYPE 2
  WIDTH 360
  XY 500: 0  500: 3600
  ENDEL
  PATH
  LAYER 7
  DATATYPE 0
  PATHTYPE 2
  WIDTH 360
  XY 3700: 0  3700: 3600
  ENDEL
  TEXT
  LAYER 5
  TEXTTYPE 0
  XY 2100: 3400
  STRING "WL"
  ENDEL
  TEXT
  LAYER 7
  TEXTTYPE 0
  XY 500: 1800
  STRING "BL"
  ENDEL
  TEXT
  LAYER 7
  TEXTTYPE 0
  XY 3700: 1800
  STRING "BLB"
  ENDEL
ENDSTR
ENDLIB
