# GDSII ASCII Stream: 4x4 SRAM Sub-Array Macro with Wordline/Bitline Routing & Guard Rings
HEADER 600
BGNLIB
LIBNAME SRAM_4X4_MACRO
UNITS 1e-3 1e-9

BGNSTR
STRNAME VIA12_CELL
  BOUNDARY
  LAYER 6
  DATATYPE 0
  XY 0: 0  260: 0  260: 260  0: 260  0: 0
  ENDEL
ENDSTR

BGNSTR
STRNAME BITCELL_UNIT
  BOUNDARY
  LAYER 1
  DATATYPE 0
  XY 0: 600  2000: 600  2000: 1800  0: 1800  0: 600
  ENDEL
  BOUNDARY
  LAYER 2
  DATATYPE 0
  XY 300: 800  1700: 800  1700: 1500  300: 1500  300: 800
  ENDEL
  BOUNDARY
  LAYER 3
  DATATYPE 0
  XY 850: 400  1150: 400  1150: 1900  850: 1900  850: 400
  ENDEL
  SREF
  SNAME VIA12_CELL
  XY 870: 1020
  ENDEL
ENDSTR

BGNSTR
STRNAME SRAM_4X4_TOP
  # Perimeter P-Substrate Guard Ring (Active Layer 2)
  BOUNDARY
  LAYER 2
  DATATYPE 0
  XY 0: 0  10400: 0  10400: 600  0: 600  0: 0
  ENDEL
  BOUNDARY
  LAYER 2
  DATATYPE 0
  XY 0: 10600  10400: 10600  10400: 11200  0: 11200  0: 10600
  ENDEL
  # 4x4 Tiled Bitcell Core Array
  AREF
  SNAME BITCELL_UNIT
  COLROW 4 4
  XY 1200: 1200  9200: 1200  1200: 9200
  ENDEL
  # 4 Horizontal Wordlines (Metal-1, Layer 5)
  PATH
  LAYER 5
  DATATYPE 0
  PATHTYPE 2
  WIDTH 320
  XY 600: 2200  9800: 2200
  ENDEL
  PATH
  LAYER 5
  DATATYPE 0
  PATHTYPE 2
  WIDTH 320
  XY 600: 4200  9800: 4200
  ENDEL
  PATH
  LAYER 5
  DATATYPE 0
  PATHTYPE 2
  WIDTH 320
  XY 600: 6200  9800: 6200
  ENDEL
  PATH
  LAYER 5
  DATATYPE 0
  PATHTYPE 2
  WIDTH 320
  XY 600: 8200  9800: 8200
  ENDEL
  # 4 Vertical Bitlines (Metal-2, Layer 7)
  PATH
  LAYER 7
  DATATYPE 0
  PATHTYPE 2
  WIDTH 360
  XY 2200: 800  2200: 10400
  ENDEL
  PATH
  LAYER 7
  DATATYPE 0
  PATHTYPE 2
  WIDTH 360
  XY 4200: 800  4200: 10400
  ENDEL
  PATH
  LAYER 7
  DATATYPE 0
  PATHTYPE 2
  WIDTH 360
  XY 6200: 800  6200: 10400
  ENDEL
  PATH
  LAYER 7
  DATATYPE 0
  PATHTYPE 2
  WIDTH 360
  XY 8200: 800  8200: 10400
  ENDEL
  TEXT
  LAYER 5
  TEXTTYPE 0
  XY 800: 2200
  STRING "WL0"
  ENDEL
  TEXT
  LAYER 5
  TEXTTYPE 0
  XY 800: 8200
  STRING "WL3"
  ENDEL
  TEXT
  LAYER 7
  TEXTTYPE 0
  XY 2200: 10000
  STRING "BL0"
  ENDEL
  TEXT
  LAYER 7
  TEXTTYPE 0
  XY 8200: 10000
  STRING "BL3"
  ENDEL
ENDSTR
ENDLIB
