{
  "name": "@modelscript/cgmes",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/cgmes-rdf-parser.d.ts",
      "default": "./dist/src/parser/cgmes-rdf-parser.js"
    },
    "./topology": {
      "types": "./dist/src/topology/topology-processor.d.ts",
      "default": "./dist/src/topology/topology-processor.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./projections": {
      "types": "./dist/src/projections/cgmes-to-psse.d.ts",
      "default": "./dist/src/projections/cgmes-to-psse.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    }
  },
  "files": [
    "dist/**",
    "src-gen/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build/build-language-parser.js && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/tools/language-playground.ts .",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "workspace:*",
    "@modelscript/exchange": "workspace:*",
    "@modelscript/psse": "workspace:*",
    "@modelscript/runtime": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "alpha",
    "category": "language"
  }
}
