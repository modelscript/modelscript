  {
    "name": "SMOOTH",
    "kind": "Function",
    "namePath": "DYNAMO.SMOOTH",
    "exports": [
      "DEL",
      "INIT"
    ],
    "inherits": [],
    "metadata": {
      "label": "1st-Order Exponential Smooth",
      "category": "Information & Material Delays",
      "domain": "system-dynamics",
      "description": "First-order exponential information smoothing: dS/dt = (IN - S) / DEL, initialized at S(0) = IN(0).",
      "provenance": "Pugh (1963) DYNAMO User's Manual / Forrester Industrial Dynamics",
      "aliases": [
        "SMTH1"
      ],
      "parameters": [
        {
          "key": "DEL",
          "type": "real",
          "defaultValue": 1,
          "unit": "time",
          "description": "Smoothing time constant (delay)"
        },
        {
          "key": "INIT",
          "type": "real",
          "defaultValue": 0,
          "unit": "1",
          "description": "Optional initial smoothed value"
        }
      ],
      "wasmKernel": "dynamo_eval_smooth",
      "archetypeId": 1,
      "signature": "SMOOTH(IN, DEL)"
    }
  },
