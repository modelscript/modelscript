{
  "name": "@modelscript/opendss",
  "version": "0.0.18",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/opendss-parser.d.ts",
      "default": "./dist/src/parser/opendss-parser.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./solvers": {
      "types": "./dist/src/solvers/power-flow-solver.d.ts",
      "default": "./dist/src/solvers/power-flow-solver.js"
    },
    "./dae": {
      "types": "./dist/src/dae/opendss-to-dae.d.ts",
      "default": "./dist/src/dae/opendss-to-dae.js"
    },
    "./projections": {
      "types": "./dist/src/projections/opendss-to-modelica.d.ts",
      "default": "./dist/src/projections/opendss-to-modelica.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    }
  },
  "files": [
    "src/**",
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
