<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="HDR-SUB-01">
      <CREATION-TIME>2026-11-01T14:00:00Z</CREATION-TIME>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <TITLE>Deep-Submergence Submarine Hull and Life-Support Specification</TITLE>
      <COMMENT>Paired with HullVerification.sysml for digital-thread traceability</COMMENT>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT-STR" LONG-NAME="String" />
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="ST-SUB" LONG-NAME="Naval Safety Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-DESC" LONG-NAME="Description" IS-MANDATORY="true">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STR</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="SUB-HULL-01" LONG-NAME="Collapse Depth Safety Factor">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-SUB</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>Pressure hull collapse depth must be &gt;= 600 m with safety factor 1.5 over test depth.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SUB-HULL-02" LONG-NAME="Maximum Hoop Stress">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-SUB</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>HY-100 hull plating hoop stress at test depth must be &lt;= 460 MPa.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SUB-LIFE-01" LONG-NAME="Cabin CO2 Partial Pressure Limit">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-SUB</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>Atmosphere scrubber shall maintain cabin CO2 concentration &lt;= 0.5 percent.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SUB-LIFE-02" LONG-NAME="Minimum Oxygen Reserve">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-SUB</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>Emergency oxygen bank endurance must be &gt;= 168 h for full crew complement.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPEC-RELATIONS>
        <SPEC-RELATION IDENTIFIER="REL-SUB-01" LONG-NAME="refines">
          <SOURCE><SPEC-OBJECT-REF>SUB-HULL-02</SPEC-OBJECT-REF></SOURCE>
          <TARGET><SPEC-OBJECT-REF>SUB-HULL-01</SPEC-OBJECT-REF></TARGET>
        </SPEC-RELATION>
      </SPEC-RELATIONS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SPEC-SUB" LONG-NAME="Submarine Hull &amp; Life Support">
          <CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="H-HULL">
              <OBJECT><SPEC-OBJECT-REF>SUB-HULL-01</SPEC-OBJECT-REF></OBJECT>
              <CHILDREN>
                <SPEC-HIERARCHY IDENTIFIER="H-HOOP"><OBJECT><SPEC-OBJECT-REF>SUB-HULL-02</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
              </CHILDREN>
            </SPEC-HIERARCHY>
            <SPEC-HIERARCHY IDENTIFIER="H-CO2"><OBJECT><SPEC-OBJECT-REF>SUB-LIFE-01</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
            <SPEC-HIERARCHY IDENTIFIER="H-O2"><OBJECT><SPEC-OBJECT-REF>SUB-LIFE-02</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
