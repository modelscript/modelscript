<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="HDR-FCS-01">
      <CREATION-TIME>2026-11-01T11:00:00Z</CREATION-TIME>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <TITLE>DO-178C DAL-A Primary Flight Control Software Specification</TITLE>
      <COMMENT>High-level and low-level control law requirements</COMMENT>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT-STR" LONG-NAME="String" />
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="ST-HLR" LONG-NAME="High-Level Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-DESC" LONG-NAME="Description" IS-MANDATORY="true">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT-STR</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="HLR-PITCH-01" LONG-NAME="Pitch Envelope Protection">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-HLR</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>Commanded pitch attitude must be &lt;= 30 deg nose-up in normal law.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="LLR-PITCH-01A" LONG-NAME="Control Loop Frame Rate">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-HLR</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>Inner-loop pitch control task period must be &lt;= 10 ms deterministic worst-case.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="LLR-PITCH-01B" LONG-NAME="Triple-Modular Voter Latency">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-HLR</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>Triplex air-data sensor voter fault isolation time must be &lt;= 20 ms.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="HLR-ROLL-01" LONG-NAME="Bank Angle Protection">
          <TYPE><SPEC-OBJECT-TYPE-REF>ST-HLR</SPEC-OBJECT-TYPE-REF></TYPE>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING>
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-DESC</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
              <THE-VALUE>Maximum sustained roll bank angle must be &lt;= 67 deg under full sidestick deflection.</THE-VALUE>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPEC-RELATIONS>
        <SPEC-RELATION IDENTIFIER="REL-FCS-01" LONG-NAME="derives">
          <SOURCE><SPEC-OBJECT-REF>LLR-PITCH-01A</SPEC-OBJECT-REF></SOURCE>
          <TARGET><SPEC-OBJECT-REF>HLR-PITCH-01</SPEC-OBJECT-REF></TARGET>
        </SPEC-RELATION>
        <SPEC-RELATION IDENTIFIER="REL-FCS-02" LONG-NAME="derives">
          <SOURCE><SPEC-OBJECT-REF>LLR-PITCH-01B</SPEC-OBJECT-REF></SOURCE>
          <TARGET><SPEC-OBJECT-REF>HLR-PITCH-01</SPEC-OBJECT-REF></TARGET>
        </SPEC-RELATION>
      </SPEC-RELATIONS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SPEC-FCS" LONG-NAME="Flight Control Software Spec">
          <CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="H-PITCH">
              <OBJECT><SPEC-OBJECT-REF>HLR-PITCH-01</SPEC-OBJECT-REF></OBJECT>
              <CHILDREN>
                <SPEC-HIERARCHY IDENTIFIER="H-PITCH-A"><OBJECT><SPEC-OBJECT-REF>LLR-PITCH-01A</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
                <SPEC-HIERARCHY IDENTIFIER="H-PITCH-B"><OBJECT><SPEC-OBJECT-REF>LLR-PITCH-01B</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
              </CHILDREN>
            </SPEC-HIERARCHY>
            <SPEC-HIERARCHY IDENTIFIER="H-ROLL">
              <OBJECT><SPEC-OBJECT-REF>HLR-ROLL-01</SPEC-OBJECT-REF></OBJECT>
            </SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
