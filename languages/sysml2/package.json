{
  "name": "@modelscript/sysml2",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./config": {
      "types": "./dist/src-gen/config.d.ts",
      "default": "./dist/src-gen/config.js"
    },
    "./query-hooks": {
      "types": "./dist/src-gen/query-hooks.d.ts",
      "default": "./dist/src-gen/query-hooks.js"
    },
    "./ast": {
      "types": "./dist/src-gen/ast.d.ts",
      "default": "./dist/src-gen/ast.js"
    },
    "./constraint-extractor": {
      "types": "./dist/constraint-extractor.d.ts",
      "default": "./dist/constraint-extractor.js"
    },
    "./transformers/modelica": {
      "types": "./dist/transformers/modelica-transformer.d.ts",
      "default": "./dist/transformers/modelica-transformer.js"
    }
  },
  "files": [
    "queries/*",
    "src/**",
    "src-gen/**",
    "dist/**",
    "factory.ts",
    "constraint-extractor.ts",
    "transformers/**"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "clean": "rimraf dist src-gen *.wasm"
  },
  "dependencies": {
    "@modelscript/compiler": "*",
    "@modelscript/diagram": "*",
    "@modelscript/language": "*"
  },
  "devDependencies": {}
}
