{
  "name": "@modelscript/sysml2",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./factory": {
      "types": "./dist/src/factory.d.ts",
      "default": "./dist/src/factory.js"
    },
    "./constraint-extractor": {
      "types": "./dist/src/constraint-extractor.d.ts",
      "default": "./dist/src/constraint-extractor.js"
    },
    "./reasoner-bridge": {
      "types": "./dist/src/reasoner-bridge.d.ts",
      "default": "./dist/src/reasoner-bridge.js"
    },
    "./diff_config": {
      "types": "./dist/src/diff_config.d.ts",
      "default": "./dist/src/diff_config.js"
    },
    "./transformers/modelica": {
      "types": "./dist/transformers/modelica-transformer.d.ts",
      "default": "./dist/transformers/modelica-transformer.js"
    },
    "./transformers/generic-modelica": {
      "types": "./dist/transformers/generic-modelica-bridge.d.ts",
      "default": "./dist/transformers/generic-modelica-bridge.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram/index.d.ts",
      "default": "./dist/src/diagram/index.js"
    },
    "./diagram/*": {
      "types": "./dist/src/diagram/*.d.ts",
      "default": "./dist/src/diagram/*.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "src/**",
    "src-gen/**",
    "dist/**",
    "transformers/**"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "build:parser": "node build.js --force",
    "clean": "rimraf dist *.wasm",
    "lint": "eslint src transformers --no-warn-ignored",
    "test": "npx tsx --test tests/*.test.ts && npx tsx tests/test-imports-and-stdlib.ts && npx tsx tests/test-reasoner-multiplicity-disjoint.ts"
  },
  "dependencies": {
    "@modelscript/diagram": "*",
    "@modelscript/dsl": "*",
    "@modelscript/exchange": "*",
    "@modelscript/runtime": "*",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {},
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "@modelscript/dsl:build",
          "@modelscript/runtime:build",
          "@modelscript/diagram:build"
        ]
      }
    }
  }
}
