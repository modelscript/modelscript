    ],
    "inherits": [],
    "metadata": {
      "label": "Second-Order Complex Pole",
      "category": "Transfer Functions",
      "domain": "controls",
      "description": "CMPXPL(a, b, u, ic1, ic2) — Second-order transfer function 1 / (a * s^2 + b * s + 1) with state initial conditions ic1, ic2.",
      "provenance": "ACSL Reference Manual (Mitchell & Gauthier, 1975)",
      "aliases": [
        "SECOND_ORDER_POLE"
      ],
      "parameters": [
        {
          "key": "A",
          "type": "real",
          "defaultValue": 1,
          "unit": "s^2",
          "description": "Second-order coefficient a = 1 / wn^2"
        },
        {
          "key": "B",
          "type": "real",
          "defaultValue": 1.414,
          "unit": "s",
          "description": "Damping coefficient b = 2 * zeta / wn"
        },
        {
          "key": "IC1",
          "type": "real",
          "defaultValue": 0,
          "unit": "",
          "description": "Initial position y(t0)"
        },
        {
          "key": "IC2",
          "type": "real",
          "defaultValue": 0,
          "unit": "",
          "description": "Initial velocity dy/dt(t0)"
        }
      ],
      "wasmKernel": "acslModelStep",
      "archetypeId": 3,
      "signature": "CMPXPL(a, b, u, ic1, ic2)"
    }
  },
