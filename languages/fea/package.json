{
  "name": "@modelscript/fea",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./materializer": {
      "types": "./dist/src/materializer.d.ts",
      "default": "./dist/src/materializer.js"
    },
    "./dialects": {
      "types": "./dist/src/dialects/index.d.ts",
      "default": "./dist/src/dialects/index.js"
    }
  },
  "files": [
    "src/**",
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
