      "provenance": "Gibaldi & Perrier (1982) Pharmacokinetics, 2nd Ed., Ch. 1; Lavielle (2014) Mixed Effects Models for the Population Approach",
      "aliases": [
        "bolus_1cpt_Vk",
        "iv_1cpt_VCl",
        "pk_1cpt_bolus"
      ],
      "parameters": [
        {
          "key": "V",
          "type": "real",
          "defaultValue": 10,
          "unit": "L",
          "description": "Central volume of distribution"
        },
        {
          "key": "Cl",
          "type": "real",
          "defaultValue": 1,
          "unit": "L/h",
          "description": "Systemic clearance"
        },
        {
          "key": "F",
          "type": "real",
          "defaultValue": 1,
          "unit": "1",
          "description": "Bioavailability fraction"
        },
        {
          "key": "Tlag",
          "type": "real",
          "defaultValue": 0,
          "unit": "h",
          "description": "Dosing lag time"
        }
      ],
      "wasmKernel": "bolus_1cpt_VCl",
      "archetypeId": 1
    }
