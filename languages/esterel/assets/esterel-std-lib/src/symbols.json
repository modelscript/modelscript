    "inherits": [],
    "metadata": {
      "label": "Input Debouncer",
      "category": "Signal Conditioning",
      "domain": "reactive",
      "description": "Filters transient glitches on RAW by emitting STABLE only after N consecutive ticks with RAW present.",
      "provenance": "Synchronous Reactive Control Library",
      "aliases": [
        "SignalDebouncer",
        "GlitchFilter"
      ],
      "parameters": [
        {
          "key": "COUNT",
          "type": "integer",
          "defaultValue": 2,
          "unit": "ticks",
