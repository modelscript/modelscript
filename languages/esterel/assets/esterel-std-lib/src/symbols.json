    ],
    "inherits": [],
    "metadata": {
      "label": "Reactive Watchdog",
      "category": "Preemption & Timing",
      "domain": "reactive",
      "description": "Monitors liveness kicks against a periodic tick clock; emits ALARM if DEADLINE ticks elapse before KICK arrives.",
      "provenance": "Esterel v5 Preemption Patterns",
      "aliases": [
        "WDT",
        "LivenessWatchdog"
      ],
      "parameters": [
        {
          "key": "DEADLINE",
          "type": "integer",
          "defaultValue": 3,
          "unit": "ticks",
          "description": "Number of ticks before emitting ALARM"
        }
      ],
      "wasmKernel": "stepSlot",
      "archetypeId": 2,
      "inputs": [
        "TICK",
        "KICK",
        "RESET"
      ],
      "outputs": [
        "ALARM"
      ]
    }
  },
  {
