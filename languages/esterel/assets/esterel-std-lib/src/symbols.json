        "SyncReset"
      ],
      "parameters": [],
      "wasmKernel": "stepSlot",
      "archetypeId": 1,
      "inputs": [
        "A",
        "B",
        "R"
      ],
      "outputs": [
        "O"
      ]
    }
  },
  {
    "name": "Watchdog",
