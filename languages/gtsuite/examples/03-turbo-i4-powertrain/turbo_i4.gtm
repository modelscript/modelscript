MODEL: Turbo_I4_2L_GDI
SPEED: 3800.0
LAMBDA: 1.0

COMPONENTS:
  INLET = environment_inlet (P = 101325, T = 298.15)
  COMP = turbo_compressor (PR = 2.0, EFF = 0.77, MASS_FLOW = 0.16)
  INTERCOOLER = intercooler (VOL = 0.0055, DP = 0.035, EFF = 0.84)
  PLENUM_IN = plenum (VOL = 0.0042, P = 195000, T = 315.0)
  RUN_IN1 = intake_runner (D = 0.044, L = 0.40, CELLS = 4)
  RUN_IN2 = intake_runner (D = 0.044, L = 0.40, CELLS = 4)
  RUN_IN3 = intake_runner (D = 0.044, L = 0.40, CELLS = 4)
  RUN_IN4 = intake_runner (D = 0.044, L = 0.40, CELLS = 4)
  CYL1 = cylinder (BORE = 0.0825, STROKE = 0.0928, ROD = 0.144, CR = 9.8, ANCHOR = 15, DURATION = 45)
  CYL2 = cylinder (BORE = 0.0825, STROKE = 0.0928, ROD = 0.144, CR = 9.8, ANCHOR = 15, DURATION = 45)
  CYL3 = cylinder (BORE = 0.0825, STROKE = 0.0928, ROD = 0.144, CR = 9.8, ANCHOR = 15, DURATION = 45)
  CYL4 = cylinder (BORE = 0.0825, STROKE = 0.0928, ROD = 0.144, CR = 9.8, ANCHOR = 15, DURATION = 45)
  RUN_EX1 = exhaust_runner (D = 0.038, L = 0.60, CELLS = 4)
  RUN_EX2 = exhaust_runner (D = 0.038, L = 0.60, CELLS = 4)
  RUN_EX3 = exhaust_runner (D = 0.038, L = 0.60, CELLS = 4)
  RUN_EX4 = exhaust_runner (D = 0.038, L = 0.60, CELLS = 4)
  PLENUM_EXH = plenum (VOL = 0.0030, P = 235000, T = 1020.0)
  TURB = turbo_turbine (ER = 1.92, EFF = 0.74)
  OUTLET = environment_outlet (P = 101325, T = 298.15)

CONNECTIONS:
  INLET.out -> COMP.in
  COMP.out -> INTERCOOLER.in
  INTERCOOLER.out -> PLENUM_IN.in
  PLENUM_IN.port1 -> RUN_IN1.in
  PLENUM_IN.port2 -> RUN_IN2.in
  PLENUM_IN.port3 -> RUN_IN3.in
  PLENUM_IN.port4 -> RUN_IN4.in
  RUN_IN1.out -> CYL1.intake
  RUN_IN2.out -> CYL2.intake
  RUN_IN3.out -> CYL3.intake
  RUN_IN4.out -> CYL4.intake
  CYL1.exhaust -> RUN_EX1.in
  CYL2.exhaust -> RUN_EX2.in
  CYL3.exhaust -> RUN_EX3.in
  CYL4.exhaust -> RUN_EX4.in
  RUN_EX1.out -> PLENUM_EXH.port1
  RUN_EX2.out -> PLENUM_EXH.port2
  RUN_EX3.out -> PLENUM_EXH.port3
  RUN_EX4.out -> PLENUM_EXH.port4
  PLENUM_EXH.out -> TURB.in
  TURB.out -> OUTLET.in
