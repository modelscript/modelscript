    "inherits": [],
    "metadata": {
      "label": "Hartree-Fock (HF)",
      "category": "Wavefunction Method",
      "domain": "chemistry",
      "description": "Self-consistent field mean-field wavefunction theory (no dynamic electron correlation).",
      "provenance": "Roothaan (1951), Rev. Mod. Phys. 23, 69; Pople & Nesbet (1954), J. Chem. Phys. 22, 571",
      "aliases": [
        "RHF",
        "UHF",
        "ROHF",
        "Hartree-Fock"
      ],
      "parameters": [
        {
          "key": "scalingOrder",
          "type": "real",
          "defaultValue": 4,
          "unit": "N^k",
          "description": "Formal computational scaling exponent with basis size N"
        },
        {
          "key": "hfExchangeFrac",
          "type": "real",
          "defaultValue": 1,
          "unit": "1",
          "description": "Fraction of exact Hartree-Fock exchange"
        },
        {
          "key": "zpeScaleFactor",
          "type": "real",
          "defaultValue": 0.8953,
          "unit": "1",
          "description": "Harmonic frequency / ZPE empirical scale factor"
        },
        {
          "key": "correlationOrder",
          "type": "real",
          "defaultValue": 0,
          "unit": "1",
          "description": "Perturbative/coupled-cluster correlation level"
        }
      ],
      "wasmKernel": "gaussianModelEval",
      "archetypeId": 1
    }
  },
