{
  "name": "@modelscript/fortran",
  "version": "0.0.18",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./ast": {
      "types": "./dist/src/ast.d.ts",
      "default": "./dist/src/ast.js"
    },
    "./preprocessor": {
      "types": "./dist/src/preprocessor.d.ts",
      "default": "./dist/src/preprocessor.js"
    },
    "./codegen": {
      "types": "./dist/src/codegen/step-compiler.d.ts",
      "default": "./dist/src/codegen/step-compiler.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./dae": {
      "types": "./dist/src/dae/lowering.d.ts",
      "default": "./dist/src/dae/lowering.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "src/**",
    "src-gen/**",
    "dist/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build-language-parser.js && tsc",
    "build:parser": "node ../../scripts/build-language-parser.js --force",
    "clean": "rimraf dist src-gen as-gen *.wasm",
    "lint": "eslint src --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "preview",
    "category": "language"
  }
}
