! PWR Station Blackout Vessel Pressure Relief and Containment Response
MELGEN_INPUT
TITLE 'PWR Station Blackout Vessel Relief and Spray'

EXEC_INPUT
  EXEC_TSTART 0.0
  EXEC_TEND 600.0
  EXEC_DT 0.05 1.0 1.0e-5

CVH_INPUT
  CV_ID 'RCS_Core_Vessel' 100 NORMAL
  CV_THR 1.55e7 590.0 0.50 0.50
  CV_PAS 95.0 0.0 12.0

  CV_ID 'Pressurizer' 110 NORMAL
  CV_THR 1.55e7 618.0 0.40 0.60
  CV_PAS 45.0 10.0 24.0

  CV_ID 'Containment' 200 NORMAL
  CV_THR 1.01325e5 312.0 0.02 0.10
  CV_PAS 55000.0 0.0 55.0
  CV_NCG 'N2' 0.77

FL_INPUT
  FL_ID 'Surge_Line' 10
  FL_FT 100 110 8.5 10.5
  FL_GEO 0.095 8.0 1.0
  FL_USL 1.6 1.6
  FL_IC 0.0

  FL_ID 'Safety_Relief_Valve' 20
  FL_FT 110 200 23.5 28.0
  FL_GEO 0.025 4.0 1.0
  FL_USL 2.2 2.8
  FL_IC 0.0

HS_INPUT
  HS_ID 'Vessel_Shell' 1001 CYLINDRICAL
  HS_GD 0.21 135.0 205000.0 32.0 525.0 7900.0
  HS_LB 100 2200.0
  HS_RB 200 45.0
  HS_TEMP 585.0
  HS_SRC 0.0

  HS_ID 'Containment_Liner' 2001 CYLINDRICAL
  HS_GD 0.02 5200.0 820000.0 45.0 480.0 7850.0
  HS_LB 200 280.0
  HS_RB 200 30.0
  HS_TEMP 312.0
  HS_SRC 0.0

COR_INPUT
  COR_RP 5 10 3.2e9
  COR_ZDF 96000.0 340.0 600.0 4800.0 22500.0 100
  COR_PWR 3.4e7 3.2e9
  COR_OX ON URBANIC_HEIDRICK 4800.0 22500.0

CF_INPUT
  CF_ID 'RCS_to_Containment_DP' 1 SUBTRACT
  CF_SAI 1.0 0.0 0.0
  CF_ARG CVH 100 P 1.0
  CF_ARG CVH 200 P -1.0

TF_INPUT
  TF_ID 'SBO_Decay_Power' 10 1.0 0.0
  TF_TAB 0.0 1.0 100.0 0.68 600.0 0.42 3600.0 0.21

NCG_INPUT
  NCG_ID 'H2' 1 2.01588 14307.0

END
