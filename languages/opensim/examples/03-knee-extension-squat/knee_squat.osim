<?xml version="1.0" encoding="UTF-8"?>
<OpenSimDocument Version="40000">
  <Model name="lower_limb_knee_squat">
    <gravity>0 -9.80665 0</gravity>
    <BodySet>
      <objects>
        <Body name="foot">
          <mass>1.250</mass>
          <mass_center>0.100 0.030 0</mass_center>
          <inertia>0.0014 0.0039 0.0041 0 0 0</inertia>
        </Body>
        <Body name="tibia">
          <mass>3.708</mass>
          <mass_center>0 -0.1867 0</mass_center>
          <inertia>0.0504 0.0051 0.0511 0 0 0</inertia>
        </Body>
        <Body name="femur">
          <mass>9.301</mass>
          <mass_center>0 -0.1700 0</mass_center>
          <inertia>0.1339 0.0351 0.1412 0 0 0</inertia>
        </Body>
        <Body name="pelvis">
          <mass>11.777</mass>
          <mass_center>-0.0707 0 0</mass_center>
          <inertia>0.1028 0.0871 0.0579 0 0 0</inertia>
        </Body>
      </objects>
    </BodySet>
    <JointSet>
      <objects>
        <WeldJoint name="ground_foot">
          <socket_parent_frame>/ground</socket_parent_frame>
          <socket_child_frame>/bodyset/foot</socket_child_frame>
          <location_in_parent>0 0 0</location_in_parent>
          <orientation_in_parent>0 0 0</orientation_in_parent>
        </WeldJoint>
        <PinJoint name="ankle_r">
          <socket_parent_frame>/bodyset/foot</socket_parent_frame>
          <socket_child_frame>/bodyset/tibia</socket_child_frame>
          <location_in_parent>0.048 0.062 0</location_in_parent>
          <orientation_in_parent>0 0 0</orientation_in_parent>
          <coordinates>
            <Coordinate name="ankle_angle_r">
              <motion_type>rotational</motion_type>
              <default_value>0.15</default_value>
              <range>-0.7854 0.7854</range>
              <clamped>true</clamped>
              <locked>false</locked>
            </Coordinate>
          </coordinates>
        </PinJoint>
        <PinJoint name="knee_r">
          <socket_parent_frame>/bodyset/tibia</socket_parent_frame>
          <socket_child_frame>/bodyset/femur</socket_child_frame>
          <location_in_parent>0 0.430 0</location_in_parent>
          <orientation_in_parent>0 0 0</orientation_in_parent>
          <coordinates>
            <Coordinate name="knee_angle_r">
              <motion_type>rotational</motion_type>
              <default_value>-0.75</default_value>
              <range>-2.2689 0.05</range>
              <clamped>true</clamped>
              <locked>false</locked>
            </Coordinate>
          </coordinates>
        </PinJoint>
        <PinJoint name="hip_r">
          <socket_parent_frame>/bodyset/femur</socket_parent_frame>
          <socket_child_frame>/bodyset/pelvis</socket_child_frame>
          <location_in_parent>0 0.400 0</location_in_parent>
          <orientation_in_parent>0 0 0</orientation_in_parent>
          <coordinates>
            <Coordinate name="hip_flexion_r">
              <motion_type>rotational</motion_type>
              <default_value>0.60</default_value>
              <range>-0.5236 2.0944</range>
              <clamped>true</clamped>
              <locked>false</locked>
            </Coordinate>
          </coordinates>
        </PinJoint>
      </objects>
    </JointSet>
    <ForceSet>
      <objects>
        <Millard2012EquilibriumMuscle name="vastus_intermedius_r">
          <max_isometric_force>1365.0</max_isometric_force>
          <optimal_fiber_length>0.0870</optimal_fiber_length>
          <tendon_slack_length>0.1360</tendon_slack_length>
