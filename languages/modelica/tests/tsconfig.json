{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../",
    "noEmit": true,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@modelscript/modelica": ["../src/index.ts"],
      "@modelscript/modelica/factory": ["../src/factory.ts"],
      "@modelscript/modelica/parser": ["../src-gen/bindings.js"],
      "@modelscript/modelica/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["scratch*", "**/scratch*"]
}
