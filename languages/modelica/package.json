{
  "name": "@modelscript/modelica",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./flattener": {
      "types": "./dist/src/flattener.d.ts",
      "default": "./dist/src/flattener.js"
    },
    "./connections": {
      "types": "./dist/src/connections.d.ts",
      "default": "./dist/src/connections.js"
    },
    "./context": {
      "types": "./dist/src/context.d.ts",
      "default": "./dist/src/context.js"
    },
    "./factory": {
      "types": "./dist/src/factory.d.ts",
      "default": "./dist/src/factory.js"
    },
    "./builtins": {
      "types": "./dist/src/builtins.d.ts",
      "default": "./dist/src/builtins.js"
    },
    "./units": {
      "types": "./dist/src/units.d.ts",
      "default": "./dist/src/units.js"
    },
    "./geometry": {
      "types": "./dist/src/extensions/geometry.d.ts",
      "default": "./dist/src/extensions/geometry.js"
    },
    "./csg": {
      "types": "./dist/src/extensions/csg.d.ts",
      "default": "./dist/src/extensions/csg.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./po": {
      "types": "./dist/src/extensions/po.d.ts",
      "default": "./dist/src/extensions/po.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram/index.d.ts",
      "default": "./dist/src/diagram/index.js"
    },
    "./diagram/*": {
      "types": "./dist/src/diagram/*.d.ts",
      "default": "./dist/src/diagram/*.js"
    },
    "./keywords": {
      "types": "./dist/src/keywords.d.ts",
      "default": "./dist/src/keywords.js"
    },
    "./multibody-generator": {
      "types": "./dist/src/extensions/multibody-generator.d.ts",
      "default": "./dist/src/extensions/multibody-generator.js"
    },
    "./modification-args": {
      "types": "./dist/src/modifications.d.ts",
      "default": "./dist/src/modifications.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./transformers/sysml2": {
      "types": "./dist/transformers/sysml2-transformer.d.ts",
      "default": "./dist/transformers/sysml2-transformer.js"
    },
    "./flattener-query": {
      "types": "./dist/src/flattener.d.ts",
      "default": "./dist/src/flattener.js"
    },
    "./shape-flattener": {
      "types": "./dist/src/extensions/shape-flattener.d.ts",
      "default": "./dist/src/extensions/shape-flattener.js"
    },
    "./study-flattener": {
      "types": "./dist/src/extensions/study-flattener.d.ts",
      "default": "./dist/src/extensions/study-flattener.js"
    },
    "./extensions": {
      "types": "./dist/src/extensions/index.d.ts",
      "default": "./dist/src/extensions/index.js"
    },
    "./extensions/*": {
      "types": "./dist/src/extensions/*.d.ts",
      "default": "./dist/src/extensions/*.js"
    },
    "./expression-evaluator": {
      "types": "./dist/src/expression-evaluator.d.ts",
      "default": "./dist/src/expression-evaluator.js"
    },
    "./predefined-types": {
      "types": "./dist/src/predefined-types.d.ts",
      "default": "./dist/src/predefined-types.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./arena-script-interpreter": {
      "types": "./dist/src/arena-script-interpreter.d.ts",
      "default": "./dist/src/arena-script-interpreter.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm",
    "./studies": {
      "types": "./dist/src/studies.d.ts",
      "default": "./dist/src/studies.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "bench:parser": "npx tsx tests/glr-bench.ts",
    "build": "node build.js && tsc",
    "build:parser": "node build.js --force",
    "clean": "rimraf dist build *.wasm",
    "lint": "eslint src transformers --no-warn-ignored",
    "test": "npm run test:unit",
    "test:full": "npm run test:unit && npm run test:omc",
    "test:latex": "npx tsx tests/ctrf-to-latex.ts",
    "test:msl": "npx tsx tests/msl-comparison-runner.ts",
    "test:msl:diagram": "npx tsx tests/msl-comparison-runner.ts --stage=diagram",
    "test:msl:flatten": "npx tsx tests/msl-comparison-runner.ts --stage=flatten",
    "test:msl:icon": "npx tsx tests/msl-comparison-runner.ts --stage=icon",
    "test:msl:sim": "npx tsx tests/msl-comparison-runner.ts --stage=simulate",
    "test:omc": "npx tsx tests/testsuite-runner.ts",
    "test:omc:both": "npx tsx tests/testsuite-runner.ts --flattener=both",
    "test:omc:both:allow-wasm": "npx tsx tests/testsuite-runner.ts --flattener=both --allow-wasm-failures",
    "test:omc:coverage": "rm -rf .v8-coverage coverage/omc && mkdir -p .v8-coverage coverage/omc && NODE_V8_COVERAGE=$(pwd)/.v8-coverage npx tsx tests/testsuite-runner.ts --flattener=both --allow-wasm-failures && npx c8 report --temp-directory=.v8-coverage --reporter=lcov --reports-dir=coverage/omc --include=\"src/**\" --include=\"../../packages/dsl/src/**\" --include=\"../../packages/runtime/src/**\"",
    "test:omc:js": "npx tsx tests/testsuite-runner.ts --flattener=ts",
    "test:omc:wasm": "npx tsx tests/testsuite-runner.ts --flattener=wasm",
    "test:unit": "mkdir -p coverage && npx tsx --import ./tests/test-setup.ts --test --experimental-test-coverage --test-coverage-exclude=\"**/dist/**\" --test-coverage-exclude=\"**/node_modules/**\" --test-coverage-exclude=\"**/tests/**\" --test-concurrency=2 --test-timeout=180000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=../../scripts/node-test-ctrf-reporter.cjs --test-reporter-destination=stdout tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/cad": "*",
    "@modelscript/csv": "*",
    "@modelscript/diagram": "*",
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*",
    "@modelscript/simulate": "*",
    "@svgdotjs/svg.js": "^3.2.4",
    "vscode-languageserver": "^9.0.1"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "@modelscript/dsl:build",
          "@modelscript/runtime:build",
          "@modelscript/diagram:build",
          "@modelscript/csv:build",
          "@modelscript/simulate:build",
          "@modelscript/cad:build"
        ]
      }
    }
  }
}
