{
  "name": "@modelscript/powerfactory",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/powerfactory-parser.d.ts",
      "default": "./dist/src/parser/powerfactory-parser.js"
    },
    "./topology": {
      "types": "./dist/src/topology/topology-processor.d.ts",
      "default": "./dist/src/topology/topology-processor.js"
    },
    "./projections": {
      "types": "./dist/src/projections/powerfactory-to-psse.d.ts",
      "default": "./dist/src/projections/powerfactory-to-psse.js"
    },
    "./dsl": {
      "types": "./dist/src/dsl/dsl-transpiler.d.ts",
      "default": "./dist/src/dsl/dsl-transpiler.js"
    },
    "./shim": {
      "types": "./dist/src/powerfactory-shim.d.ts",
      "default": "./dist/src/powerfactory-shim.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./iec61850": {
      "types": "./dist/src/iec61850/index.d.ts",
      "default": "./dist/src/iec61850/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./ui": {
      "types": "./dist/src/ui/PowerFactoryPanel.d.ts",
      "default": "./dist/src/ui/PowerFactoryPanel.js"
    }
  },
  "files": [
    "dist/**",
    "src-gen/**",
    "assets/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build/build-language-parser.js && node scripts/build-stdlib.js && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/tools/language-playground.ts .",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "workspace:*",
    "@modelscript/psse": "workspace:*",
    "@modelscript/runtime": "workspace:*",
    "@modelscript/simulate": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
