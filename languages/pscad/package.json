{
  "name": "@modelscript/pscad",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/pscx-parser.d.ts",
      "default": "./dist/src/parser/pscx-parser.js"
    },
    "./netlist": {
      "types": "./dist/src/netlist/emt-netlist.d.ts",
      "default": "./dist/src/netlist/emt-netlist.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    }
  },
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js tests/run-test.ts tests/comtrade.test.ts tests/pslx.test.ts tests/corpus.test.ts tests/model-corpus.test.ts tests/edit-engine.test.ts tests/sim-coverage.test.ts tests/param-eval.test.ts tests/datamerge.test.ts tests/meters-logic.test.ts tests/structural-lints.test.ts tests/control-intervals.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*",
    "@modelscript/xml-cst": "*"
  }
}
