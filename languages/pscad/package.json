{
  "name": "@modelscript/pscad",
  "version": "0.0.18",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/pscx-parser.d.ts",
      "default": "./dist/src/parser/pscx-parser.js"
    },
    "./netlist": {
      "types": "./dist/src/netlist/emt-netlist.d.ts",
      "default": "./dist/src/netlist/emt-netlist.js"
    },
    "./edit": {
      "types": "./dist/src/edit/diagram-actions.d.ts",
      "default": "./dist/src/edit/diagram-actions.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./solver": {
      "types": "./dist/src/solver/index.d.ts",
      "default": "./dist/src/solver/index.js"
    },
    "./psout": {
      "types": "./dist/src/psout/index.d.ts",
      "default": "./dist/src/psout/index.js"
    },
    "./psout.wasm": "./dist/psout.wasm",
    "./dist/psout.wasm": "./dist/psout.wasm"
  },
  "files": [
    "src/**",
    "dist/**",
    "assembly/**"
  ],
  "scripts": {
    "build": "npm run build:wasm && tsc",
    "build:wasm": "node scripts/build-wasm.js",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js tests/run-test.ts tests/emt-solver.test.ts tests/comtrade.test.ts tests/pslx.test.ts tests/corpus.test.ts tests/model-corpus.test.ts tests/edit-engine.test.ts tests/sim-coverage.test.ts tests/param-eval.test.ts tests/datamerge.test.ts tests/meters-logic.test.ts tests/structural-lints.test.ts tests/control-intervals.test.ts tests/script-segments.test.ts tests/master-pslx-loader.test.ts tests/psout.test.ts tests/fortran-transliterator.test.ts tests/fortran-simulation.test.ts tests/emtdc-subroutines.test.ts tests/ieee2800-cfrt-and-ja-transformer.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/c": "*",
    "@modelscript/dsl": "*",
    "@modelscript/fortran": "*",
    "@modelscript/runtime": "*"
  },
  "modelscript": {
    "tier": "stable",
    "category": "language"
  }
}
