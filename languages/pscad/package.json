{
  "name": "@modelscript/pscad",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/pscx-parser.d.ts",
      "default": "./dist/src/parser/pscx-parser.js"
    },
    "./netlist": {
      "types": "./dist/src/netlist/emt-netlist.d.ts",
      "default": "./dist/src/netlist/emt-netlist.js"
    },
    "./edit": {
      "types": "./dist/src/edit/diagram-actions.d.ts",
      "default": "./dist/src/edit/diagram-actions.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./solver": {
      "types": "./dist/src/solver/index.d.ts",
      "default": "./dist/src/solver/index.js"
    },
    "./psout": {
      "types": "./dist/src/psout/index.d.ts",
      "default": "./dist/src/psout/index.js"
    },
    "./psout.wasm": "./dist/psout.wasm",
    "./dist/psout.wasm": "./dist/psout.wasm",
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./ui": {
      "types": "./dist/src/ui/Ieee2800Card.d.ts",
      "default": "./dist/src/ui/Ieee2800Card.js"
    }
  },
  "files": [
    "dist/**",
    "assets/**",
    "assembly/**",
    "src-gen/**"
  ],
  "scripts": {
    "bench:pmr": "tsx tests/run-pmr-benchmark.ts",
    "build": "node ../../scripts/build/build-language-parser.js && npm run build:wasm && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "build:wasm": "node scripts/build-wasm.js",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/tools/language-playground.ts .",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@modelscript/c": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/exchange": "workspace:*",
    "@modelscript/fortran": "workspace:*",
    "@modelscript/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.7"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
