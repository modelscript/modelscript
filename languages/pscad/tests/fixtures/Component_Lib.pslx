        <category name="Animation" visible="false">
          <cond><![CDATA[true]]></cond>
          <parameter type="Real" name="PF" desc="PF" group="" helpmode="Append" animate="true" allowemptystr="true" content_type="Literal" min="-1E+308" max="1E+308" unit="" intent="Input" dim="1">
            <value><![CDATA[0.0]]></value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
            <vis />
            <animate />
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Fortran" id="510960850" classid="CoreSegment"><![CDATA[#LOCAL REAL PF

      PF = $In1 / sqrt($In1 * $In1 + $In2 * $In2)

      IF (UPDATE_AG) CALL PSCAD_AGR2(ICALL_NO,$#Component,PF,"PF")

      $Out = PF]]></segment>
        <segment classid="CoreSegment" id="1129167665" name="Help"><![CDATA[help.html]]></segment>
      </script>
    </Definition>
