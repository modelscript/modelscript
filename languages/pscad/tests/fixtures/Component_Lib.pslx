      <script>
        <segment name="Fortran" id="740322278" classid="CoreSegment"><![CDATA[#STORAGE REAL:1 INTEGER:1

      IF (FIRSTSTEP) THEN
        STORF(NSTORF) = 0.0
        STORI(NSTORI) = 0
      ENDIF

      IF (($In .GT. 0) .AND. (STORI(NSTORI) .EQ. 0)) THEN
        STORI(NSTORI) = 1
        STORF(NSTORF) = TIME - $Offset
      ENDIF

      IF (UPDATE_AG) CALL PSCAD_AGR2(ICALL_NO,$#Component,STORF(NSTORF),"Flag_timer")

      $Flag_time = STORF(NSTORF)

      NSTORF = NSTORF + 1
      NSTORI = NSTORI + 1]]></segment>
        <segment classid="CoreSegment" id="311687511" name="Help"><![CDATA[help.html]]></segment>
      </script>
    </Definition>
