            <choice cond=""><![CDATA[1 = Integer]]></choice>
          </parameter>
          <parameter name="operation" desc="Operation" type="Choice" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Choose type of operation. Input 1 (operation) Input 2.]]></help>
            <choice cond=""><![CDATA[0 = ≥]]></choice>
            <choice cond=""><![CDATA[1 = >]]></choice>
            <choice cond=""><![CDATA[2 = =]]></choice>
            <choice cond=""><![CDATA[3 = <]]></choice>
            <choice cond=""><![CDATA[4 = ≤]]></choice>
          </parameter>
          <parameter name="tol" desc="+/- Tolerance" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="-1E+308" max="1E+308">
            <value><![CDATA[0.0]]></value>
            <cond><![CDATA[type==0&&(operation==0||operation==2||operation==4)]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
            <animate><![CDATA[0]]></animate>
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Fortran" id="1430211623" classid="CoreSegment"><![CDATA[#if operation==0
#if type==0
      if ((($in1 - $tol) .GE. $in2) .OR. (($in1 + $tol) .GE. $in2)) then
        $out = 1
      else
        $out = 0
      endif
#else
      if ($in1 .GE. $in2) then
        $out = 1
      else
        $out = 0
      endif
#endif
#else operation==1
      if ($in1 .GT. $in2) then
        $out = 1
      else
        $out = 0
      endif
#else  operation==2
#if type==0
      if ((($in1 - $tol) .EQ. $in2) .OR. (($in1 + $tol) .EQ. $in2)) then
        $out = 1
      else
        $out = 0
      endif
#else
      if ($in1 .EQ. $in2) then
        $out = 1
      else
        $out = 0
      endif
#endif
#else  operation==3
      if ($in1 .LT. $in2) then
        $out = 1
      else
        $out = 0
      endif
#else  operation==4
#if type==0
      if ((($in1 - $tol) .LE. $in2) .OR. (($in1 + $tol) .LE. $in2)) then
        $out = 1
      else
        $out = 0
      endif
#else
      if ($in1 .LE. $in2) then
        $out = 1
      else
        $out = 0
      endif
#endif]]></segment>
        <segment classid="CoreSegment" id="1647186271" name="Help"><![CDATA[help.html]]></segment>
      </script>
    </Definition>
