<?xml version="1.0" encoding="UTF-8"?>
<project name="Hybrid_Microgrid_EMT" version="5.1.0" type="normal">
  <param name="time_step" value="25.0"/>
  <param name="time_duration" value="2.0"/>
  <param name="start_type" value="0"/>
  <param name="f_base" value="60.0"/>
  <library path="inverter_lib.pslx"/>
  <sourcefile path="droop_ctrl.f90"/>
  <hierarchy>
    <call name="Main" link="10001"/>
  </hierarchy>
  <definitions>
    <definition name="Main" type="module">
      <schematic>
        <User classid="UserCmp" defn="master:source_3" id="DIESEL1" x="80" y="160" orient="0">
          <param name="Name" value="DieselGen_5MVA"/>
          <param name="V" value="13.8"/>
          <param name="MVA" value="5.0"/>
          <param name="f" value="60.0"/>
          <port name="out" pos="[20, 0]"/>
        </User>

        <Bus name="Microgrid_PCC_13p8kV" id="B_PCC" x="180" y="160" length="120" vbase="13.8"/>

        <User classid="UserCmp" defn="inverter_lib:BESS_Droop_Inverter" id="BESS1" x="380" y="160" orient="0">
          <param name="Name" value="BESS_GridForming_4MVA"/>
          <param name="Srated" value="4.0"/>
          <param name="Vnom" value="13.8"/>
          <param name="Mp" value="0.04"/>
          <param name="Nq" value="0.05"/>
          <port name="ac_term" pos="[-30, 0]"/>
        </User>

        <User classid="UserCmp" defn="master:fixed_load" id="CRIT_LOAD" x="240" y="260" orient="0">
          <param name="Name" value="CriticalHospitalLoad"/>
          <param name="P" value="3.8"/>
          <param name="Q" value="1.1"/>
          <param name="V" value="13.8"/>
          <port name="in" pos="[0, -20]"/>
        </User>

        <Wire>
          <vertex x="100" y="160"/>
          <vertex x="180" y="160"/>
        </Wire>
        <Wire>
          <vertex x="300" y="160"/>
          <vertex x="350" y="160"/>
        </Wire>
        <Wire>
          <vertex x="240" y="160"/>
          <vertex x="240" y="240"/>
        </Wire>
      </schematic>
    </definition>
  </definitions>
</project>
