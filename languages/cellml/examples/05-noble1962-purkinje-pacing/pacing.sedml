<?xml version="1.0" encoding="UTF-8"?>
<sedML xmlns="http://sed-ml.org/sed-ml/level1/version4" level="1" version="4">
  <listOfModels>
    <model id="noble_model" language="urn:sedml:language:cellml" source="noble1962.cellml"/>
  </listOfModels>
  <listOfSimulations>
    <uniformTimeCourse id="sim_pacing" initialTime="0" outputStartTime="0" outputEndTime="1000" numberOfSteps="2000">
      <algorithm kisaoID="KISAO:0000019"/>
    </uniformTimeCourse>
  </listOfSimulations>
  <listOfTasks>
    <task id="task_pacing" modelReference="noble_model" simulationReference="sim_pacing"/>
  </listOfTasks>
  <listOfDataGenerators>
    <dataGenerator id="dg_time" name="Time">
      <listOfVariables>
        <variable id="var_time" taskReference="task_pacing" target="/cellml:model/cellml:component[@name='environment']/cellml:variable[@name='time']"/>
      </listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML"><ci>var_time</ci></math>
    </dataGenerator>
    <dataGenerator id="dg_V" name="Membrane Potential">
      <listOfVariables>
        <variable id="var_V" taskReference="task_pacing" target="/cellml:model/cellml:component[@name='membrane']/cellml:variable[@name='V']"/>
      </listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML"><ci>var_V</ci></math>
    </dataGenerator>
  </listOfDataGenerators>
</sedML>
