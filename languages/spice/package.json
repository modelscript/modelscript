{
  "name": "@modelscript/spice",
  "version": "0.0.0",
  "description": "SPICE netlist (.cir, .sp, .net, .lib) analog & mixed-signal simulation language package for ModelScript",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/spice-parser.d.ts",
      "default": "./dist/src/parser/spice-parser.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./solvers": {
      "types": "./dist/src/solvers/index.d.ts",
      "default": "./dist/src/solvers/index.js"
    },
    "./dae": {
      "types": "./dist/src/dae/dae-lower.d.ts",
      "default": "./dist/src/dae/dae-lower.js"
    },
    "./projections": {
      "types": "./dist/src/projections/index.d.ts",
      "default": "./dist/src/projections/index.js"
    },
    "./workspace-index": {
      "types": "./dist/src/workspace-index.d.ts",
      "default": "./dist/src/workspace-index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    },
    "./tgg": {
      "types": "./dist/src/tgg/index.d.ts",
      "default": "./dist/src/tgg/index.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram/index.d.ts",
      "default": "./dist/src/diagram/index.js"
    },
    "./grammar": {
      "types": "./dist/src/grammar/index.d.ts",
      "default": "./dist/src/grammar/index.js"
    }
  },
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/cad": "*",
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
