<?xml version="1.0" encoding="UTF-8"?>
<sedML xmlns="http://sed-ml.org/sed-ml/level1/version4" level="1" version="4">
  <listOfModels>
    <model id="mapk_model" language="urn:sedml:language:sbml" source="mapk.sbml"/>
  </listOfModels>
  <listOfSimulations>
    <uniformTimeCourse id="sim_mapk" initialTime="0" outputStartTime="0" outputEndTime="3000" numberOfSteps="300">
      <algorithm kisaoID="KISAO:0000019"/>
    </uniformTimeCourse>
  </listOfSimulations>
  <listOfTasks>
    <task id="task_mapk" modelReference="mapk_model" simulationReference="sim_mapk"/>
  </listOfTasks>
  <listOfDataGenerators>
    <dataGenerator id="dg_time" name="Time">
      <listOfVariables>
        <variable id="var_t" symbol="urn:sedml:symbol:time" taskReference="task_mapk"/>
      </listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <ci>var_t</ci>
      </math>
    </dataGenerator>
    <dataGenerator id="dg_mapk_pp" name="Active MAPK-PP">
      <listOfVariables>
        <variable id="var_mapk_pp" target="/sbml:sbml/sbml:model/sbml:listOfSpecies/sbml:species[@id='MAPK_PP']" taskReference="task_mapk"/>
      </listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <ci>var_mapk_pp</ci>
      </math>
    </dataGenerator>
  </listOfDataGenerators>
  <listOfOutputs>
    <plot2D id="plot_mapk" name="MAPK Cascade Dynamics">
      <listOfCurves>
        <curve id="curve_mapk_pp" xDataReference="dg_time" yDataReference="dg_mapk_pp"/>
      </listOfCurves>
    </plot2D>
  </listOfOutputs>
</sedML>
