{
  "name": "@modelscript/stl",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./parser": {
      "types": "./dist/src/parser/index.d.ts",
      "default": "./dist/src/parser/index.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./cad": {
      "types": "./dist/src/cad/index.d.ts",
      "default": "./dist/src/cad/index.js"
    },
    "./dae": {
      "types": "./dist/src/dae/index.d.ts",
      "default": "./dist/src/dae/index.js"
    },
    "./solver": {
      "types": "./dist/src/solver/index.d.ts",
      "default": "./dist/src/solver/index.js"
    },
    "./projections": {
      "types": "./dist/src/projections/index.d.ts",
      "default": "./dist/src/projections/index.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram/index.d.ts",
      "default": "./dist/src/diagram/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    },
    "./ui": {
      "types": "./dist/src/ui/StlPanel.d.ts",
      "default": "./dist/src/ui/StlPanel.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    }
  },
  "files": [
    "dist/**",
    "src-gen/**",
    "assets/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build/build-language-parser.js && node scripts/build-stdlib.js && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "build:stdlib": "node scripts/build-stdlib.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/tools/language-playground.ts .",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/cad": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
