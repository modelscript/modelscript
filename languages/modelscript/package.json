{
  "name": "@modelscript/modelscript",
  "version": "0.0.18",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "src/**",
    "src-gen/**",
    "dist/**"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "build:parser": "node build.js --force",
    "clean": "rimraf dist src-gen as-gen *.wasm",
    "lint": "eslint src --no-warn-ignored",
    "test": "mkdir -p coverage && npx tsx --test --experimental-test-coverage --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=../../scripts/node-test-ctrf-reporter.cjs --test-reporter-destination=stdout tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
