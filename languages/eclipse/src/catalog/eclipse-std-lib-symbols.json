          "defaultValue": 35,
          "unit": "degAPI",
          "description": "Stock-tank oil API gravity"
        },
        {
          "key": "gammaG",
          "type": "real",
          "defaultValue": 0.75,
          "unit": "1",
          "description": "Solution gas specific gravity (air = 1)"
        },
        {
          "key": "pb",
          "type": "real",
          "defaultValue": 2500,
          "unit": "psia",
          "description": "Bubble-point pressure"
        },
        {
          "key": "co",
          "type": "real",
          "defaultValue": 0.000015,
          "unit": "1/psi",
          "description": "Undersaturated isothermal oil compressibility"
        },
        {
          "key": "muDead",
          "type": "real",
          "defaultValue": 2,
          "unit": "cP",
          "description": "Reference dead-oil viscosity at reservoir temperature"
        }
      ],
      "wasmKernel": "pvto",
      "archetypeId": 10
    }
  },
