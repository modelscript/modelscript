{
  "name": "@modelscript/scl",
  "version": "0.1.0",
  "description": "IEC 61850 Substation Configuration Language (SCL) parser, GOOSE validator, SLD topology projection, and linear-memory DAE arena automation lowering",
  "keywords": [
    "iec61850",
    "scl",
    "scd",
    "cid",
    "icd",
    "ssd",
    "substation",
    "goose",
    "sampled-values",
    "modelscript",
    "power-grid"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Mohamad Omar Nachawati <omar@modelscript.org>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "src-gen/**"
  ],
  "scripts": {
    "ansatz": "npx tsx ../../scripts/tools/language-ansatz.ts .",
    "build": "node ../../scripts/build/build-language-parser.js && tsc -b",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src/ --ext .ts --no-warn-ignored",
    "test": "node ../../scripts/ci/test-runner.js"
  },
  "dependencies": {
    "@modelscript/dsl": "workspace:*",
    "@modelscript/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
