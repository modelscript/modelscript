( Hierarchical 4-Bit Carry-Lookahead Macrocell with I/O Bonding Pad Ring );
DS 10 100/1;
  9 IO_BOND_PAD;
  L CMF;
  B 16 16 8 8;
  L CMS;
  B 16 16 8 8;
  L CVA;
  B 4 4 8 8;
DF;

DS 20 100/1;
  9 CLA_BIT_SLICE;
  L CWN;
  B 20 16 10 24;
  L CAA;
  B 16 5 10 23;
  B 16 5 10 9;
  L CPG;
  B 3 22 6 16;
  B 3 22 14 16;
  L CCA;
  B 3 3 3 23;
  B 3 3 17 23;
  B 3 3 3 9;
  B 3 3 17 9;
  L CMF;
  B 20 4 10 31;
  B 20 4 10 2;
  W 4 17 9 17 23;
DF;

DS 30 100/1;
  9 CLA_4BIT_MACRO;
  ( Instantiate 4 CLA bit slices horizontally );
  C 20 T 24 24;
  C 20 MX T 66 24;
  C 20 T 68 24;
  C 20 MX T 110 24;
  ( Carry-Propagate and Generate Metal-2 Buses );
  L CMS;
  W 4 24 62 110 62;
  W 4 24 68 110 68;
  ( Perimeter I/O Bonding Pads );
  C 10 T 0 24;
  C 10 T 0 52;
  C 10 T 118 24;
  C 10 T 118 52;
  C 10 T 36 0;
  C 10 T 76 0;
  C 10 T 36 76;
  C 10 T 76 76;
  94 CIN 8 32 CMS;
  94 COUT 126 32 CMS;
  94 VDD_RING 44 84 CMS;
  94 GND_RING 84 8 CMS;
DF;

C 30;
E
