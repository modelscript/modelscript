( Mead-Conway NMOS Inverter Layout in MOSIS SCMOS CIF 2.0 );
DS 10 100/1;
  9 NMOS_INVERTER;
  ( Active diffusion channel for pull-up and pull-down );
  L CAA;
  B 6 24 8 14;
  ( Polysilicon input gate crossing active region );
  L CPG;
  B 16 3 8 8;
  ( Depletion load gate strap );
  L CPG;
  B 8 6 8 19;
  ( Source, drain, and output contacts );
  L CCA;
  B 3 3 8 4;
  B 3 3 8 14;
  B 3 3 8 24;
  ( Metal-1 VDD, GND rails and output wire );
  L CMF;
  B 20 4 10 26;
  B 20 4 10 2;
  W 4 8 14 18 14;
  94 VDD 10 26 CMF;
  94 GND 10 2 CMF;
  94 IN 2 8 CPG;
  94 OUT 18 14 CMF;
DF;
C 10;
E
