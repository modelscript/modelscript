$ Single-Zone Small Office Envelope and Lighting Schedule
INPUT LOADS ..

"MAT-BRICK" = MATERIAL
  TYPE = PROPERTIES
  THICKNESS = 0.33
  CONDUCTIVITY = 0.77
  DENSITY = 120.0
  SPECIFIC-HEAT = 0.20 ..

"MAT-INSUL" = MATERIAL
  TYPE = PROPERTIES
  THICKNESS = 0.25
  CONDUCTIVITY = 0.025
  DENSITY = 2.0
  SPECIFIC-HEAT = 0.20 ..

"LAY-WALL" = LAYERS
  MATERIAL = ("MAT-BRICK", "MAT-INSUL") ..

"CON-WALL" = CONSTRUCTION
  TYPE = LAYERS
  LAYERS = "LAY-WALL" ..

"GLZ-DBL" = GLASS-TYPE
  GLASS-CONDUCTANCE = 0.45
  SHADING-COEFF = 0.62 ..

"DS-LIGHT" = DAY-SCHEDULE
  TYPE = FRACTION
  VALUES = (0.10, 0.10, 0.10, 0.10, 0.10, 0.15, 0.40, 0.90, 0.95, 0.95, 0.95, 0.85,
            0.90, 0.95, 0.95, 0.95, 0.90, 0.60, 0.30, 0.15, 0.10, 0.10, 0.10, 0.10) ..

"SP-OFFICE" = SPACE
  AREA = 1200.0
  HEIGHT = 10.0 ..

"WALL-SOUTH" = EXTERIOR-WALL
  CONSTRUCTION = "CON-WALL"
  AREA = 400.0 ..

"WIN-SOUTH" = WINDOW
  GLASS-TYPE = "GLZ-DBL"
  AREA = 120.0 ..

COMPUTE LOADS ..

INPUT SYSTEMS ..
"SYS-OFF" = SYSTEM TYPE = PSZ ..
"ZN-OFFICE" = ZONE SPACE = "SP-OFFICE" ..
COMPUTE SYSTEMS ..

STOP ..
