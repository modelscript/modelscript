$ High-Rise Commercial Office Tower: Core + 4 Perimeters, VAVS + Central Plant
INPUT LOADS ..

"MAT-SPANDREL" = MATERIAL
  TYPE = PROPERTIES
  THICKNESS = 0.08
  CONDUCTIVITY = 0.50
  DENSITY = 155.0
  SPECIFIC-HEAT = 0.20 ..

"MAT-MINWOOL" = MATERIAL
  TYPE = PROPERTIES
  THICKNESS = 0.35
  CONDUCTIVITY = 0.022
  DENSITY = 4.0
  SPECIFIC-HEAT = 0.20 ..

"LAY-CURTAIN" = LAYERS MATERIAL = ("MAT-SPANDREL", "MAT-MINWOOL") ..
"CON-CURTAIN" = CONSTRUCTION TYPE = LAYERS LAYERS = "LAY-CURTAIN" ..

"GLZ-CURTAIN" = GLASS-TYPE
  GLASS-CONDUCTANCE = 0.26
  SHADING-COEFF = 0.34 ..

"DS-TOWER-EQ" = DAY-SCHEDULE
  TYPE = FRACTION
  VALUES = (0.30, 0.30, 0.30, 0.30, 0.30, 0.35, 0.50, 0.80, 0.95, 1.00, 1.00, 0.95,
            0.90, 0.95, 1.00, 1.00, 0.95, 0.80, 0.55, 0.40, 0.35, 0.30, 0.30, 0.30) ..

"SP-CORE" = SPACE AREA = 12000.0 HEIGHT = 12.0 ..
"SP-PERIM-N" = SPACE AREA = 2400.0 HEIGHT = 12.0 ..
"W-N" = EXTERIOR-WALL CONSTRUCTION = "CON-CURTAIN" AREA = 1920.0 ..
"WIN-N" = WINDOW GLASS-TYPE = "GLZ-CURTAIN" AREA = 1150.0 ..

"SP-PERIM-S" = SPACE AREA = 2400.0 HEIGHT = 12.0 ..
"W-S" = EXTERIOR-WALL CONSTRUCTION = "CON-CURTAIN" AREA = 1920.0 ..
"WIN-S" = WINDOW GLASS-TYPE = "GLZ-CURTAIN" AREA = 1150.0 ..

"SP-PERIM-E" = SPACE AREA = 1800.0 HEIGHT = 12.0 ..
"W-E" = EXTERIOR-WALL CONSTRUCTION = "CON-CURTAIN" AREA = 1440.0 ..
"WIN-E" = WINDOW GLASS-TYPE = "GLZ-CURTAIN" AREA = 860.0 ..

"SP-PERIM-W" = SPACE AREA = 1800.0 HEIGHT = 12.0 ..
"W-W" = EXTERIOR-WALL CONSTRUCTION = "CON-CURTAIN" AREA = 1440.0 ..
"WIN-W" = WINDOW GLASS-TYPE = "GLZ-CURTAIN" AREA = 860.0 ..

COMPUTE LOADS ..

INPUT SYSTEMS ..
"AHU-VAV1" = SYSTEM TYPE = VAVS ..
"ZN-CORE" = ZONE SPACE = "SP-CORE" ..
"ZN-N" = ZONE SPACE = "SP-PERIM-N" ..
"ZN-S" = ZONE SPACE = "SP-PERIM-S" ..
"ZN-E" = ZONE SPACE = "SP-PERIM-E" ..
"ZN-W" = ZONE SPACE = "SP-PERIM-W" ..
COMPUTE SYSTEMS ..

INPUT PLANT ..
"CHILLER-1" = PLANT-EQUIPMENT TYPE = HERM-CENT-CHLR SIZE = -999 ..
"BOILER-1" = PLANT-EQUIPMENT TYPE = HW-BOILER SIZE = -999 ..
COMPUTE PLANT ..

STOP ..
