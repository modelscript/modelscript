$ University Campus Multi-Building Loads, Systems, and Central Thermal Plant
$ Companion hourly design-day weather file: weather.csv
INPUT LOADS ..

"MAT-PRECAST" = MATERIAL
  TYPE = PROPERTIES
  THICKNESS = 0.50
  CONDUCTIVITY = 0.90
  DENSITY = 140.0
  SPECIFIC-HEAT = 0.20 ..

"MAT-XPS" = MATERIAL
  TYPE = PROPERTIES
  THICKNESS = 0.25
  CONDUCTIVITY = 0.018
  DENSITY = 2.2
  SPECIFIC-HEAT = 0.29 ..

"MAT-ACOUSTIC" = MATERIAL
  TYPE = PROPERTIES
  THICKNESS = 0.06
  CONDUCTIVITY = 0.035
  DENSITY = 18.0
  SPECIFIC-HEAT = 0.30 ..

"LAY-CAMPUS-WALL" = LAYERS MATERIAL = ("MAT-PRECAST", "MAT-XPS", "MAT-ACOUSTIC") ..
"CON-CAMPUS-WALL" = CONSTRUCTION TYPE = LAYERS LAYERS = "LAY-CAMPUS-WALL" ..

"GLZ-TRIPLE" = GLASS-TYPE
  GLASS-CONDUCTANCE = 0.19
  SHADING-COEFF = 0.30 ..

"DS-LAB" = DAY-SCHEDULE
  TYPE = FRACTION
  VALUES = (0.45, 0.45, 0.45, 0.45, 0.45, 0.50, 0.65, 0.85, 1.00, 1.00, 1.00, 1.00,
            0.95, 1.00, 1.00, 1.00, 0.95, 0.85, 0.70, 0.60, 0.55, 0.50, 0.45, 0.45) ..

"DS-LIB" = DAY-SCHEDULE
  TYPE = FRACTION
  VALUES = (0.10, 0.10, 0.10, 0.10, 0.10, 0.10, 0.15, 0.40, 0.75, 0.90, 0.95, 1.00,
            1.00, 1.00, 1.00, 0.95, 0.90, 0.85, 0.80, 0.75, 0.65, 0.45, 0.20, 0.10) ..

"SP-ENG-LAB" = SPACE AREA = 18000.0 HEIGHT = 14.0 ..
"W-LAB-S" = EXTERIOR-WALL CONSTRUCTION = "CON-CAMPUS-WALL" AREA = 3200.0 ..
"WIN-LAB-S" = WINDOW GLASS-TYPE = "GLZ-TRIPLE" AREA = 960.0 ..

"SP-LIBRARY" = SPACE AREA = 24000.0 HEIGHT = 16.0 ..
"W-LIB-E" = EXTERIOR-WALL CONSTRUCTION = "CON-CAMPUS-WALL" AREA = 4000.0 ..
"WIN-LIB-E" = WINDOW GLASS-TYPE = "GLZ-TRIPLE" AREA = 1400.0 ..

"SP-LECTURE" = SPACE AREA = 8500.0 HEIGHT = 18.0 ..
"W-LEC-N" = EXTERIOR-WALL CONSTRUCTION = "CON-CAMPUS-WALL" AREA = 1800.0 ..
"WIN-LEC-N" = WINDOW GLASS-TYPE = "GLZ-TRIPLE" AREA = 360.0 ..

COMPUTE LOADS ..

INPUT SYSTEMS ..
"AHU-LAB-100OA" = SYSTEM TYPE = VAVS ..
"ZN-ENG-LAB" = ZONE SPACE = "SP-ENG-LAB" ..
"AHU-LIB-VAV" = SYSTEM TYPE = VAVS ..
"ZN-LIBRARY" = ZONE SPACE = "SP-LIBRARY" ..
"ZN-LECTURE" = ZONE SPACE = "SP-LECTURE" ..
COMPUTE SYSTEMS ..

INPUT PLANT ..
"CHLR-PRIMARY" = PLANT-EQUIPMENT TYPE = HERM-CENT-CHLR SIZE = -999 ..
"CHLR-BACKUP" = PLANT-EQUIPMENT TYPE = HERM-CENT-CHLR SIZE = -999 ..
"BLR-CAMPUS" = PLANT-EQUIPMENT TYPE = HW-BOILER SIZE = -999 ..
COMPUTE PLANT ..

STOP ..
