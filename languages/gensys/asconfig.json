{
  "targets": {
    "release": {
      "outFile": "dist/contact.wasm",
      "textFile": "dist/contact.wat",
      "sourceMap": false,
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": true,
      "enable": ["simd"]
    }
  },
  "options": {
    "bindings": "raw",
    "initialMemory": 16,
    "maximumMemory": 2048,
    "disableWarning": ["235"]
  }
}
