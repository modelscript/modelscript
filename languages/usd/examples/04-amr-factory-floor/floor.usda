#usda 1.0
(
    defaultPrim = "FactoryFloor"
    metersPerUnit = 1.0
    upAxis = "Z"
    subLayers = [
        @./lighting.usda@
    ]
)

def Xform "FactoryFloor"
{
    def Cube "ConcreteSlab" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1.0
        double3 xformOp:scale = (40.0, 30.0, 0.2)
        double3 xformOp:translate = (0.0, 0.0, -0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "AMR_Unit_01" (
        prepend references = @./amr_robot.usda@
    )
    {
        double3 xformOp:translate = (2.0, 1.5, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "AMR_Unit_02" (
        prepend references = @./amr_robot.usda@
    )
    {
        double3 xformOp:translate = (-4.0, -2.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
