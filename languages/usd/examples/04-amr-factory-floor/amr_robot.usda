#usda 1.0
(
    defaultPrim = "AmrRobot"
    metersPerUnit = 1.0
    upAxis = "Z"
)

def Xform "AmrRobot" (
    kind = "assembly"
)
{
    def Xform "chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        float physics:mass = 45.0
        float3 physics:diagonalInertia = (2.1, 3.4, 4.2)

        def Cube "body"
        {
            double size = 1.0
            double3 xformOp:scale = (0.85, 0.62, 0.28)
            double3 xformOp:translate = (0.0, 0.0, 0.20)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "wheel_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        float physics:mass = 2.5
        float3 physics:diagonalInertia = (0.04, 0.07, 0.04)

        def Cylinder "tire"
        {
            double radius = 0.12
            double height = 0.06
            double3 xformOp:translate = (0.0, 0.34, 0.12)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsRevoluteJoint "left_drive_joint"
    {
        rel physics:body0 = </AmrRobot/chassis>
        rel physics:body1 = </AmrRobot/wheel_left>
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -3.14
        float physics:upperLimit = 3.14
    }
}
