    "inherits": [],
    "metadata": {
      "label": "Continuous Transfer Function",
      "category": "Control & Transfer",
      "domain": "aerospace",
      "description": "First/second-order continuous-time Laplace transfer function H(s) = (b0 + b1*s) / (a0 + a1*s + a2*s^2) in controllable canonical form.",
      "provenance": "ESA ESL User Manual (Hay & Crosbie, University of Salford / ESTEC, 1985)",
      "aliases": [
        "TF",
        "LAG",
        "LEAD_LAG",
        "REALPL"
      ],
      "parameters": [
        {
          "key": "gain",
          "type": "real",
          "defaultValue": 1,
          "unit": "1",
          "description": "DC gain K"
        },
        {
          "key": "tau",
          "type": "real",
          "defaultValue": 0.5,
          "unit": "s",
          "description": "First-order lag time constant tau"
        },
        {
          "key": "wn",
          "type": "real",
          "defaultValue": 1,
          "unit": "rad/s",
          "description": "Natural frequency for second-order mode"
        },
        {
          "key": "zeta",
          "type": "real",
          "defaultValue": 0.707,
          "unit": "1",
          "description": "Damping ratio for second-order mode"
        },
        {
          "key": "order",
          "type": "real",
          "defaultValue": 1,
          "unit": "1",
          "description": "Transfer function order (1 or 2)"
        }
      ],
      "wasmKernel": "TRANSFER",
      "archetypeId": 1
    }
  },
  {
