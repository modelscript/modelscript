SIMPLE  =                    T / Conforms to FITS 4.0 standard
BITPIX  =                    8 / Primary metadata HDU
NAXIS   =                    0 / No primary array
EXTEND  =                    T / Contains IMAGE and BINTABLE extensions
TELESCOP= 'JWST    '           / James Webb Space Telescope
INSTRUME= 'NIRCAM  '           / Near-Infrared Camera
DETECTOR= 'NRCALONG'           / Long-wavelength channel mosaic
FILTER  = 'F444W   '           / 4.4 micron wide-band filter
TARGNAME= 'GOODS-SOUTH-DEEP'   / Deep extragalactic survey field
EXPTIME =               7200.0 / Total drizzled exposure time [s]
DATE-OBS= '2026-02-22T11:05:00' / UTC epoch
END
XTENSION= 'IMAGE   '           / Drizzled deep-field science mosaic
BITPIX  =                  -32 / IEEE 32-bit float surface brightness
NAXIS   =                    2 / 2D astrometric mosaic
NAXIS1  =                 4096 / Mosaic width [pixels]
NAXIS2  =                 4096 / Mosaic height [pixels]
PCOUNT  =                    0 / No group parameters
GCOUNT  =                    1 / Single image group
EXTNAME = 'SCI     '           / Science mosaic extension
EXTVER  =                    1 / Version 1
BUNIT   = 'MJy/sr  '           / Calibrated surface brightness
RADESYS = 'ICRS    '           / Astrometric reference frame
CTYPE1  = 'RA---TAN'           / Gnomonic Right Ascension
CTYPE2  = 'DEC--TAN'           / Gnomonic Declination
CUNIT1  = 'deg     '           / Axis 1 unit
CUNIT2  = 'deg     '           / Axis 2 unit
CRPIX1  =               2048.5 / Mosaic center X pixel
CRPIX2  =               2048.5 / Mosaic center Y pixel
CRVAL1  =              53.1227 / GOODS-S field center RA [deg]
CRVAL2  =             -27.8051 / GOODS-S field center Dec [deg]
CD1_1   =         -0.000017464 / Rotated WCS CD1_1 [deg/pix]
CD1_2   =          0.000001528 / Rotated WCS CD1_2 [deg/pix]
CD2_1   =          0.000001528 / Rotated WCS CD2_1 [deg/pix]
CD2_2   =          0.000017464 / Rotated WCS CD2_2 [deg/pix]
END
XTENSION= 'BINTABLE'           / Photometric source catalog binary table
BITPIX  =                    8 / 8-bit binary table bytes
NAXIS   =                    2 / 2D table (row bytes x num rows)
NAXIS1  =                   44 / Row width in bytes (4+16+8+8+4+4)
NAXIS2  =                 1250 / Number of detected galaxies
PCOUNT  =                    0 / No heap payload
GCOUNT  =                    1 / Single table group
TFIELDS =                    6 / Six catalog columns
EXTNAME = 'CATALOG '           / Extracted source catalog
EXTVER  =                    1 / Version 1
TTYPE1  = 'SOURCE_ID'          / Unique integer catalog ID
TFORM1  = '1J      '           / 32-bit signed integer (4 bytes)
TTYPE2  = 'DESIGNATION'        / IAU source designation string
TFORM2  = '16A     '           / 16-byte ASCII string
TTYPE3  = 'RA_ICRS '           / Right Ascension J2000 [deg]
TFORM3  = '1D      '           / 64-bit IEEE float (8 bytes)
TUNIT3  = 'deg     '           / Degrees
TTYPE4  = 'DEC_ICRS'           / Declination J2000 [deg]
TFORM4  = '1D      '           / 64-bit IEEE float (8 bytes)
TUNIT4  = 'deg     '           / Degrees
TTYPE5  = 'FLUX_F444W'         / Kron aperture flux [nJy]
TFORM5  = '1E      '           / 32-bit IEEE float (4 bytes)
TUNIT5  = 'nJy     '           / Nanojansky
TTYPE6  = 'Z_PHOT  '           / Photometric redshift estimate
TFORM6  = '1E      '           / 32-bit IEEE float (4 bytes)
END
