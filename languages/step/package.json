{
  "name": "@modelscript/step",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./mapper": {
      "types": "./dist/step-multibody-mapper.d.ts",
      "default": "./dist/step-multibody-mapper.js"
    },
    "./assembly": {
      "types": "./dist/src/assembly-extractor.d.ts",
      "default": "./dist/src/assembly-extractor.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./dist/src/schema.js"
    },
    "./workspace-index": {
      "types": "./dist/src/workspace-index.d.ts",
      "default": "./dist/src/workspace-index.js"
    },
    "./physical-data": {
      "types": "./dist/src/physical-data.d.ts",
      "default": "./dist/src/physical-data.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "queries/*",
    "src/**",
    "src-gen/**",
    "dist/**",
    "step-multibody-mapper.ts"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "build:parser": "node build.js --force",
    "clean": "rimraf dist src-gen *.wasm",
    "lint": "eslint src --no-warn-ignored",
    "test": "npx tsx --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../scripts/node-test-ctrf-reporter.cjs --test-reporter-destination=stdout tests/*.test.ts"
  },
  "dependencies": {
    "@modelscript/cad": "*",
    "@modelscript/dsl": "*",
    "@modelscript/modelica": "*",
    "@modelscript/runtime": "*"
  }
}
