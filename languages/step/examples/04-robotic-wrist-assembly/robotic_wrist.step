ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Three-Part Robotic Wrist Sub-Assembly AP242'),'2;1');
FILE_NAME('robotic_wrist.step','2026-11-01T11:30:00',('Robotics CAD Team'),('Ansatz Robotics'),'ModelScript STEP','Ansatz','Approved');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('managed model based 3d engineering');
#2 = PRODUCT_CONTEXT('',#1,'mechanical');
#3 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#10 = PRODUCT('WRIST-ASM-01','Robotic Wrist Assembly','3-part wrist assembly',(#2));
#11 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('A','',#10,.MADE.);
#12 = PRODUCT_DEFINITION('design','WristAsm',#11,#3);
#20 = PRODUCT('WRIST-HSG-01','Wrist Housing','Machined 7075-T6 housing',(#2));
#21 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('A','',#20,.MADE.);
#22 = PRODUCT_DEFINITION('design','Housing',#21,#3);
#30 = PRODUCT('WRIST-HD-01','Harmonic Drive Flange','Output reducer flange',(#2));
#31 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('A','',#30,.MADE.);
#32 = PRODUCT_DEFINITION('design','HarmonicFlange',#31,#3);
#40 = PRODUCT('WRIST-ISO-01','ISO 9409 Tool Plate','End-effector mount plate',(#2));
#41 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('A','',#40,.MADE.);
#42 = PRODUCT_DEFINITION('design','ToolPlate',#41,#3);
#50 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('NAUO-1','HousingInst','Wrist Housing Instance',#12,#22,$);
#51 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('NAUO-2','FlangeInst','Harmonic Flange Instance',#12,#32,$);
#52 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('NAUO-3','ToolPlateInst','Tool Plate Instance',#12,#42,$);
#60 = CARTESIAN_POINT('Origin',(0.0,0.0,0.0));
#61 = CARTESIAN_POINT('FlangeOrigin',(0.0,0.0,45.0));
#62 = CARTESIAN_POINT('ToolOrigin',(0.0,0.0,70.0));
#63 = DIRECTION('Z',(0.0,0.0,1.0));
#64 = DIRECTION('X',(1.0,0.0,0.0));
#65 = AXIS2_PLACEMENT_3D('AsmFrame',#60,#63,#64);
#66 = AXIS2_PLACEMENT_3D('FlangeFrame',#61,#63,#64);
#67 = AXIS2_PLACEMENT_3D('ToolFrame',#62,#63,#64);
#70 = CYLINDRICAL_SURFACE('HousingOD',#65,36.0);
#71 = CYLINDRICAL_SURFACE('FlangeOD',#66,32.0);
#72 = CYLINDRICAL_SURFACE('ToolPlateOD',#67,25.0);
#80 = GEOMETRIC_REPRESENTATION_CONTEXT(3);
#81 = PRODUCT_DEFINITION_SHAPE('','',#12);
#82 = SHAPE_REPRESENTATION('WristAsmShape',(#65,#66,#67,#70,#71,#72),#80);
#83 = SHAPE_DEFINITION_REPRESENTATION(#81,#82);
ENDSEC;
END-ISO-10303-21;
