ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Countersunk Structural L-Bracket with R6 Inner Bend Fillet'),'2;1');
FILE_NAME('l_bracket.step','2026-11-01T11:00:00',('CAD Engineer'),('Ansatz Mechanical'),'ModelScript STEP','Ansatz','Approved');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('managed model based 3d engineering');
#2 = PRODUCT_CONTEXT('',#1,'mechanical');
#3 = PRODUCT('BRKT-L-003','Countersunk L-Bracket','60x60x5 mm stainless steel bracket',(#2));
#4 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('C','Rev C',#3,.MADE.);
#5 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#6 = PRODUCT_DEFINITION('design','L-Bracket',#4,#5);
#7 = PRODUCT_DEFINITION_SHAPE('','',#6);
#10 = CARTESIAN_POINT('Origin',(0.0,0.0,0.0));
#11 = DIRECTION('Z_Axis',(0.0,0.0,1.0));
#12 = DIRECTION('X_Axis',(1.0,0.0,0.0));
#13 = DIRECTION('Y_Axis',(0.0,1.0,0.0));
#14 = AXIS2_PLACEMENT_3D('BaseFrame',#10,#11,#12);
#20 = CARTESIAN_POINT('VerticalOrigin',(0.0,0.0,5.0));
#21 = AXIS2_PLACEMENT_3D('VerticalFrame',#20,#12,#13);
#22 = PLANE('HorizontalFlange',#14);
#23 = PLANE('VerticalFlange',#21);
#30 = CARTESIAN_POINT('FilletCenter',(11.0,0.0,11.0));
#31 = AXIS2_PLACEMENT_3D('FilletAxis',#30,#13,#12);
#32 = CYLINDRICAL_SURFACE('InnerBendFillet',#31,6.0);
#40 = CARTESIAN_POINT('Hole1Center',(35.0,15.0,5.0));
#41 = CARTESIAN_POINT('Hole2Center',(35.0,45.0,5.0));
#42 = AXIS2_PLACEMENT_3D('Hole1Frame',#40,#11,#12);
#43 = AXIS2_PLACEMENT_3D('Hole2Frame',#41,#11,#12);
#44 = CONICAL_SURFACE('Countersink1',#42,5.0,0.785398);
#45 = CONICAL_SURFACE('Countersink2',#43,5.0,0.785398);
#50 = GEOMETRIC_REPRESENTATION_CONTEXT(3);
#51 = SHAPE_REPRESENTATION('LBracketShape',(#14,#22,#23,#32,#44,#45),#50);
#52 = SHAPE_DEFINITION_REPRESENTATION(#7,#51);
ENDSEC;
END-ISO-10303-21;
