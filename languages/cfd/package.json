{
  "name": "@modelscript/cfd",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./materializer": {
      "types": "./dist/src/materializer.d.ts",
      "default": "./dist/src/materializer.js"
    },
    "./dialects": {
      "types": "./dist/src/dialects/index.d.ts",
      "default": "./dist/src/dialects/index.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./ui": {
      "types": "./dist/src/ui/CfdPanel.d.ts",
      "default": "./dist/src/ui/CfdPanel.js"
    }
  },
  "files": [
    "src/**",
    "dist/**",
    "assets/**",
    "src-gen/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build-language-parser.js && tsc",
    "build:parser": "node ../../scripts/build-language-parser.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/language-playground.ts .",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "alpha",
    "category": "language"
  }
}
