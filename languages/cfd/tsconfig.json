{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "incremental": true,
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "declaration": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "tests"]
}
