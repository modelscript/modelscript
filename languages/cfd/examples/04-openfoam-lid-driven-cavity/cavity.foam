// OpenFOAM Lid-Driven Cavity Case Control Summary
application     icoFoam;
startFrom       startTime;
startTime       0;
stopTime        0.5;
deltaT          0.005;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1.0 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    fixedWalls
    {
        type            noSlip;
    }
}
