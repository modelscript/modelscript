    "metadata": {
      "label": "1-Compartment Linear IV Model (ADVAN1)",
      "category": "Compartmental ADVAN",
      "domain": "pharmacometrics",
      "description": "Closed-form one-compartment linear pharmacokinetic model for IV bolus or zero-order infusion: C(t) = (F1*D/V)*exp(-k*t).",
      "provenance": "Gibaldi & Perrier, Pharmacokinetics (2nd ed., Ch. 1); Rowland & Tozer (4th ed., Ch. 3); FDA PopPK Guidance",
      "aliases": [
        "advan1",
        "one_cpt_iv",
        "1cpt_iv"
      ],
      "parameters": [
        {
          "key": "CL",
          "type": "real",
          "defaultValue": 5,
          "unit": "L/h",
          "description": "Total systemic clearance"
        },
        {
          "key": "V",
          "type": "real",
          "defaultValue": 50,
          "unit": "L",
          "description": "Central compartment volume of distribution"
        },
        {
          "key": "F1",
          "type": "real",
          "defaultValue": 1,
          "unit": "1",
          "description": "Bioavailability fraction for compartment 1"
        },
        {
          "key": "ALAG1",
          "type": "real",
          "defaultValue": 0,
          "unit": "h",
          "description": "Dosing lag time for compartment 1"
        }
      ],
      "wasmKernel": "ADVAN1",
      "archetypeId": 1
    }
  },
  {
