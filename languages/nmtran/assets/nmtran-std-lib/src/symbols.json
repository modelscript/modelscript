    "inherits": [],
    "metadata": {
      "label": "1-Compartment First-Order Oral Model (ADVAN2)",
      "category": "Compartmental ADVAN",
      "domain": "pharmacometrics",
      "description": "Closed-form one-compartment linear PK model with first-order depot absorption (Bateman equation): C(t) = (F1*D*ka/(V*(ka-k)))*(exp(-k*t) - exp(-ka*t)).",
      "provenance": "Gibaldi & Perrier, Pharmacokinetics (2nd ed., Ch. 1); Rowland & Tozer (4th ed., Ch. 7); Gabrielsson & Weiner (5th ed.)",
      "aliases": [
        "advan2",
        "one_cpt_oral",
        "1cpt_oral",
        "bateman"
      ],
      "parameters": [
        {
          "key": "CL",
          "type": "real",
          "defaultValue": 5,
          "unit": "L/h",
          "description": "Apparent systemic clearance (CL/F)"
        },
        {
          "key": "V",
          "type": "real",
          "defaultValue": 50,
          "unit": "L",
          "description": "Apparent central volume of distribution (V/F)"
        },
        {
          "key": "KA",
          "type": "real",
          "defaultValue": 1.2,
          "unit": "1/h",
          "description": "First-order absorption rate constant"
        },
        {
          "key": "F1",
          "type": "real",
          "defaultValue": 1,
          "unit": "1",
          "description": "Bioavailability fraction for depot compartment"
        },
        {
          "key": "ALAG1",
          "type": "real",
          "defaultValue": 0,
          "unit": "h",
          "description": "Absorption lag time"
        }
      ],
      "wasmKernel": "ADVAN2",
      "archetypeId": 2
    }
  },
