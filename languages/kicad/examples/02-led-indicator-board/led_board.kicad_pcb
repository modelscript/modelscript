(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (44 "Edge.Cuts" user)
  )
  (setup
    (stackup
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 1.53) (material "FR4") (epsilon_r 4.3) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035))
    )
  )
  (net 0 "")
  (net 1 "V5V")
  (net 2 "LED_A")
  (net 3 "GND")
  (footprint "Connector_PinHeader:PinHeader_1x02"
    (layer "F.Cu")
    (at 8 12)
    (property "Reference" "J1")
    (property "Value" "5V_IN")
    (pad "1" thru_hole circle (at 0 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "V5V"))
    (pad "2" thru_hole circle (at 0 2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 3 "GND"))
  )
  (footprint "Resistor_SMD:R_0603_1608Metric"
    (layer "F.Cu")
    (at 20 12)
    (property "Reference" "R1")
    (property "Value" "330")
    (pad "1" smd roundrect (at -0.8 0) (size 0.9 0.95) (layers "F.Cu" "F.Mask") (net 1 "V5V"))
    (pad "2" smd roundrect (at 0.8 0) (size 0.9 0.95) (layers "F.Cu" "F.Mask") (net 2 "LED_A"))
  )
  (footprint "LED_SMD:LED_0603_1608Metric"
    (layer "F.Cu")
    (at 30 12)
    (property "Reference" "D1")
    (property "Value" "GREEN")
    (pad "1" smd roundrect (at -0.8 0) (size 0.9 0.95) (layers "F.Cu" "F.Mask") (net 2 "LED_A"))
    (pad "2" smd roundrect (at 0.8 0) (size 0.9 0.95) (layers "F.Cu" "F.Mask") (net 3 "GND"))
  )
  (gr_rect (start 0 0) (end 40 24) (layer "Edge.Cuts") (width 0.1))
  (segment (start 8 12) (end 19.2 12) (width 0.3) (layer "F.Cu") (net 1))
  (segment (start 20.8 12) (end 29.2 12) (width 0.3) (layer "F.Cu") (net 2))
  (via (at 33 12) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 3))
  (segment (start 30.8 12) (end 33 12) (width 0.3) (layer "F.Cu") (net 3))
  (zone (net 3) (net_name "GND") (layer "B.Cu")
    (connect_pads (clearance 0.3))
    (polygon (pts (xy 1 1) (xy 39 1) (xy 39 23) (xy 1 23)))
  )
)
