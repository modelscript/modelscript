          "description": "Initial simulation time"
        },
        {
          "key": "TIMEND",
          "type": "real",
          "defaultValue": 3600,
          "unit": "s",
          "description": "Final simulation time"
        },
        {
          "key": "DTIMEI",
          "type": "real",
          "defaultValue": 1,
          "unit": "s",
          "description": "Initial integration time step"
        },
        {
          "key": "THETA",
          "type": "real",
          "defaultValue": 0.5,
          "unit": "",
          "description": "Implicit weighting factor (0.5 = Crank-Nicolson)"
        }
      ],
      "wasmKernel": "evalSindaThermalElement",
      "archetypeId": 2
    }
  },
