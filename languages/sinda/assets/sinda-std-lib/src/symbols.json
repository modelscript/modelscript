    "metadata": {
      "label": "Simultaneous Newton / Fast Relaxation Solver (SNFR)",
      "category": "Solver Routines",
      "domain": "thermal",
      "description": "Simultaneous matrix steady-state solver with analytical radiative Jacobian for tightly coupled spacecraft thermal networks.",
      "provenance": "NASA SINDA/G & SINDA-FLUINT Reference Manual",
      "aliases": [
        "SNFR_SOLVER",
        "FAST_RELAX"
      ],
      "parameters": [
        {
          "key": "NLOOP",
          "type": "real",
          "defaultValue": 50,
          "unit": "",
          "description": "Maximum Newton-Raphson iterations"
        },
        {
          "key": "TOL",
          "type": "real",
          "defaultValue": 1e-8,
          "unit": "W",
          "description": "Energy balance residual tolerance"
        },
        {
          "key": "SIGMA",
          "type": "real",
          "defaultValue": 5.670374419e-8,
          "unit": "W/(m2.K4)",
          "description": "Stefan-Boltzmann constant"
        }
      ],
      "wasmKernel": "evalSindaThermalElement",
      "archetypeId": 4
    }
  },
