  {
    "name": "STDSTL",
    "kind": "Model",
    "namePath": "SINDA.STDSTL",
    "exports": [
      "NLOOP",
      "DRLXCA",
      "ARLXCA",
      "DAMPA"
    ],
    "inherits": [],
    "metadata": {
      "label": "Steady-State Newton-Raphson Solver (STDSTL)",
      "category": "Solver Routines",
      "domain": "thermal",
      "description": "NASA SINDA steady-state thermal network solver using damped Newton-Raphson relaxation for linear and radiative equilibrium.",
      "provenance": "NASA MSC-13805 / SINDA User's Manual",
      "aliases": [
        "STEADY",
        "STDSTL_NR"
      ],
      "parameters": [
        {
          "key": "NLOOP",
          "type": "real",
          "defaultValue": 100,
          "unit": "",
          "description": "Maximum relaxation / Newton iterations"
        },
        {
          "key": "DRLXCA",
          "type": "real",
          "defaultValue": 0.000001,
          "unit": "K",
          "description": "Diffusion node convergence tolerance"
        },
        {
          "key": "ARLXCA",
          "type": "real",
          "defaultValue": 0.000001,
          "unit": "K",
          "description": "Arithmetic node convergence tolerance"
        },
        {
          "key": "DAMPA",
          "type": "real",
          "defaultValue": 1,
          "unit": "",
          "description": "Under-relaxation damping factor"
        }
      ],
      "wasmKernel": "evalSindaThermalElement",
      "archetypeId": 1
    }
  },
  {
