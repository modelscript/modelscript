{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@modelscript/owl2": ["../src/index.ts"],
      "@modelscript/owl2/*": ["../src/*"]
    }
  },
  "include": ["**/*"]
}
