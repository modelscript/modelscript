{
  "name": "@modelscript/owl2",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./factory": {
      "types": "./dist/src/factory.d.ts",
      "default": "./dist/src/factory.js"
    },
    "./cst-lowering": {
      "types": "./dist/src/cst-lowering.d.ts",
      "default": "./dist/src/cst-lowering.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./lints": {
      "types": "./dist/src/lints.d.ts",
      "default": "./dist/src/lints.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram/index.d.ts",
      "default": "./dist/src/diagram/index.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm",
    "./ui": {
      "types": "./dist/src/ui/Owl2Panel.d.ts",
      "default": "./dist/src/ui/Owl2Panel.js"
    }
  },
  "files": [
    "queries/*",
    "src-gen/**",
    "dist/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build/build-language-parser.js && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "clean": "rimraf dist src-gen *.wasm",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/tools/language-playground.ts .",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/diagram": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/runtime": "workspace:*",
    "@modelscript/sparql": "workspace:*",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
