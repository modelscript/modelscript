{
  "name": "@modelscript/owl2",
  "version": "0.0.18",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./factory": {
      "types": "./dist/src/factory.d.ts",
      "default": "./dist/src/factory.js"
    },
    "./cst-lowering": {
      "types": "./dist/src/cst-lowering.d.ts",
      "default": "./dist/src/cst-lowering.js"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./dist/src/errors.js"
    },
    "./lints": {
      "types": "./dist/src/lints.d.ts",
      "default": "./dist/src/lints.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram/index.d.ts",
      "default": "./dist/src/diagram/index.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "queries/*",
    "src/**",
    "src-gen/**",
    "dist/**"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "build:parser": "node build.js --force",
    "clean": "rimraf dist src-gen *.wasm",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/diagram": "*",
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "modelscript": {
    "tier": "stable",
    "category": "language"
  }
}
