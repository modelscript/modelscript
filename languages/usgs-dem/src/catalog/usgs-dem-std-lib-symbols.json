      "label": "Inclined Plane Benchmark",
      "category": "Synthetic Terrain",
      "domain": "geospatial",
      "description": "Canonical linear ramp z(x,y) = z0 + a*x + b*y with exact constant slope atan(sqrt(a^2+b^2)) and constant compass aspect.",
      "provenance": "Horn (1981) Analytical Slope/Aspect Verification Benchmark",
      "aliases": [
        "RAMP",
        "PLANAR_SLOPE"
      ],
      "parameters": [
        {
          "key": "baseElevation",
          "type": "real",
          "defaultValue": 100,
          "unit": "m",
          "description": "Origin elevation z0"
        },
        {
          "key": "gradX",
          "type": "real",
          "defaultValue": -0.1,
          "unit": "m/m",
          "description": "East-West slope dz/dx"
        },
        {
          "key": "gradY",
          "type": "real",
          "defaultValue": -0.05,
          "unit": "m/m",
          "description": "North-South slope dz/dy"
        },
        {
          "key": "dx",
          "type": "real",
          "defaultValue": 30,
          "unit": "m",
          "description": "Grid spacing dx"
        },
        {
          "key": "dy",
          "type": "real",
          "defaultValue": 30,
          "unit": "m",
          "description": "Grid spacing dy"
        }
      ],
      "wasmKernel": "usgsDemEval",
