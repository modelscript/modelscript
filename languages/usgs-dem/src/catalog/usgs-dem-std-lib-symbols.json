    ],
    "inherits": [],
    "metadata": {
      "label": "Gaussian Hill Benchmark",
      "category": "Synthetic Terrain",
      "domain": "geospatial",
      "description": "Canonical smooth Gaussian hill z(x,y) = z0 + H * exp(-((x-xc)^2 + (y-yc)^2) / (2*sigma^2)) with analytical peak, volume, and hypsometric integral.",
      "provenance": "Cleanroom Geomorphometry Verification Benchmark",
      "aliases": [
        "GAUSSIAN",
        "BELL_HILL"
      ],
      "parameters": [
        {
          "key": "baseElevation",
          "type": "real",
          "defaultValue": 1000,
          "unit": "m",
          "description": "Base datum elevation z0"
        },
        {
          "key": "amplitude",
          "type": "real",
          "defaultValue": 500,
          "unit": "m",
          "description": "Peak height H above base"
        },
        {
          "key": "sigma",
          "type": "real",
          "defaultValue": 150,
          "unit": "m",
          "description": "Gaussian standard deviation sigma"
        },
        {
          "key": "dx",
          "type": "real",
          "defaultValue": 30,
          "unit": "m",
          "description": "Grid spacing dx"
        },
        {
          "key": "dy",
          "type": "real",
          "defaultValue": 30,
          "unit": "m",
          "description": "Grid spacing dy"
        }
      ],
      "wasmKernel": "usgsDemEval",
      "archetypeId": 10
    }
  },
