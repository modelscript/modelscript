{
  "name": "@modelscript/lps",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/index.d.ts",
      "default": "./dist/src/parser/index.js"
    },
    "./solver": {
      "types": "./dist/src/solver/steady/steady-network-solver.d.ts",
      "default": "./dist/src/solver/steady/steady-network-solver.js"
    },
    "./projections": {
      "types": "./dist/src/projections/lps-to-sysml2.d.ts",
      "default": "./dist/src/projections/lps-to-sysml2.js"
    },
    "./verification": {
      "types": "./dist/src/verification/pipeline-verifier.d.ts",
      "default": "./dist/src/verification/pipeline-verifier.js"
    },
    "./dae": {
      "types": "./dist/src/dae/index.d.ts",
      "default": "./dist/src/dae/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    }
  },
  "files": [
    "src/**",
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
