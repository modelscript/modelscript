{
  "name": "@modelscript/lps",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/index.d.ts",
      "default": "./dist/src/parser/index.js"
    },
    "./solver": {
      "types": "./dist/src/solver/steady/steady-network-solver.d.ts",
      "default": "./dist/src/solver/steady/steady-network-solver.js"
    },
    "./projections": {
      "types": "./dist/src/projections/lps-to-sysml2.d.ts",
      "default": "./dist/src/projections/lps-to-sysml2.js"
    },
    "./verification": {
      "types": "./dist/src/verification/pipeline-verifier.d.ts",
      "default": "./dist/src/verification/pipeline-verifier.js"
    },
    "./dae": {
      "types": "./dist/src/dae/index.d.ts",
      "default": "./dist/src/dae/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./ui": {
      "types": "./dist/src/ui/LpsPanel.d.ts",
      "default": "./dist/src/ui/LpsPanel.js"
    }
  },
  "files": [
    "dist/**",
    "assets/**",
    "src-gen/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build/build-language-parser.js && node scripts/build-stdlib.js && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "build:stdlib": "node scripts/build-stdlib.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/tools/language-playground.ts .",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/diagram": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
