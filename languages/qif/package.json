{
  "name": "@modelscript/qif",
  "version": "0.1.0",
  "description": "ISO 23952 / ANSI DMSC Quality Information Framework (QIF 3.0) digital metrology, GD&T, and SPC language package for ModelScript",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/index.d.ts",
      "default": "./dist/src/parser/index.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./spc": {
      "types": "./dist/src/spc/index.d.ts",
      "default": "./dist/src/spc/index.js"
    },
    "./step-bridge": {
      "types": "./dist/src/step-bridge/index.d.ts",
      "default": "./dist/src/step-bridge/index.js"
    },
    "./projections": {
      "types": "./dist/src/projections/index.d.ts",
      "default": "./dist/src/projections/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./ui": {
      "types": "./dist/src/ui/QifPanel.d.ts",
      "default": "./dist/src/ui/QifPanel.js"
    }
  },
  "files": [
    "dist/**",
    "src-gen/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build/build-language-parser.js && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/tools/language-playground.ts .",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "workspace:*",
    "@modelscript/runtime": "workspace:*",
    "@modelscript/step": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "alpha",
    "category": "language"
  }
}
