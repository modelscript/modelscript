          (net NA (joined (portRef A) (portRef A (instanceRef X1)) (portRef A (instanceRef A1))))
          (net NB (joined (portRef B) (portRef B (instanceRef X1)) (portRef B (instanceRef A1))))
          (net NCIN (joined (portRef CIN) (portRef B (instanceRef X2)) (portRef B (instanceRef A2))))
          (net NP (joined (portRef Y (instanceRef X1)) (portRef A (instanceRef X2)) (portRef A (instanceRef A2))))
          (net NG1 (joined (portRef Y (instanceRef A1)) (portRef A (instanceRef O1))))
          (net NG2 (joined (portRef Y (instanceRef A2)) (portRef B (instanceRef O1))))
          (net NSUM (joined (portRef Y (instanceRef X2)) (portRef SUM)))
          (net NCOUT (joined (portRef Y (instanceRef O1)) (portRef COUT))))))
    (cell ADDER4
