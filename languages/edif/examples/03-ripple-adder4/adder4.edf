          (net NC1 (joined (portRef COUT (instanceRef FA0)) (portRef CIN (instanceRef FA1))))
          (net NC2 (joined (portRef COUT (instanceRef FA1)) (portRef CIN (instanceRef FA2))))
          (net NC3 (joined (portRef COUT (instanceRef FA2)) (portRef CIN (instanceRef FA3))))
          (net NS0 (joined (portRef SUM (instanceRef FA0)) (portRef S0)))
