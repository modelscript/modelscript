          (net N_OR  (joined (portRef Y (instanceRef U_OR))  (portRef D1 (instanceRef U_M0))))
          (net N_SUM (joined (portRef Y (instanceRef U_SUM)) (portRef D0 (instanceRef U_M1))))
          (net N_CG  (joined (portRef Y (instanceRef U_CG))  (portRef B (instanceRef U_CO)) (portRef D1 (instanceRef U_M1))))
          (net N_OP0 (joined (portRef OP0) (portRef S (instanceRef U_M0)) (portRef S (instanceRef U_M1))))
          (net N_OP1 (joined (portRef OP1) (portRef S (instanceRef U_M2))))
          (net N_L0  (joined (portRef Y (instanceRef U_M0)) (portRef D0 (instanceRef U_M2))))
          (net N_L1  (joined (portRef Y (instanceRef U_M1)) (portRef D1 (instanceRef U_M2))))
          (net NY    (joined (portRef Y (instanceRef U_M2)) (portRef Y)))
          (net NCOUT (joined (portRef Y (instanceRef U_CO)) (portRef COUT))))))
