{
  "name": "@modelscript/psse",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/raw-parser.d.ts",
      "default": "./dist/src/parser/raw-parser.js"
    },
    "./netlist": {
      "types": "./dist/src/netlist/powerflow-netlist.d.ts",
      "default": "./dist/src/netlist/powerflow-netlist.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./wasm": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dae": {
      "types": "./dist/src/dae/index.d.ts",
      "default": "./dist/src/dae/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    },
    "./ui": {
      "types": "./dist/src/ui/PssePanel.d.ts",
      "default": "./dist/src/ui/PssePanel.js"
    }
  },
  "files": [
    "src/**",
    "src-gen/**",
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "bench:accc": "tsx tests/run-70k-accc.ts",
    "build": "npm run sync:schemas && node ../../scripts/build-language-parser.js && npm run build:wasm && tsc",
    "build:parser": "node ../../scripts/build-language-parser.js --force",
    "build:wasm": "tsx scripts/build-wasm.js",
    "clean": "rimraf dist src-gen as-gen *.wasm",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/language-playground.ts .",
    "sync:schemas": "tsx scripts/sync-dyr-schemas.ts",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/exchange": "*",
    "@modelscript/runtime": "*",
    "@modelscript/simulate": "*"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "*",
    "@modelscript/diagram": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "@modelscript/diagram": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
