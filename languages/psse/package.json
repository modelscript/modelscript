{
  "name": "@modelscript/psse",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/raw-parser.d.ts",
      "default": "./dist/src/parser/raw-parser.js"
    },
    "./netlist": {
      "types": "./dist/src/netlist/powerflow-netlist.d.ts",
      "default": "./dist/src/netlist/powerflow-netlist.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./wasm": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "src/**",
    "src-gen/**",
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
