// 4D Ocean Circulation Forecast Cube (time, depth, lat, lon)
netcdf north_pacific_4d_forecast {
dimensions:
  time = UNLIMITED ; // (2 currently)
  depth = 3 ;
  lat = 2 ;
  lon = 2 ;
variables:
  double time(time) ;
    time:units = "days since 2026-03-01 00:00:00 UTC" ;
    time:long_name = "forecast valid time" ;
    time:standard_name = "time" ;
  float depth(depth) ;
    depth:units = "m" ;
    depth:long_name = "Depth Below Sea Surface" ;
    depth:standard_name = "depth" ;
  float lat(lat) ;
    lat:units = "degrees_north" ;
    lat:long_name = "latitude" ;
  float lon(lon) ;
    lon:units = "degrees_east" ;
    lon:long_name = "longitude" ;
  float potential_temp(time, depth, lat, lon) ;
    potential_temp:units = "degC" ;
    potential_temp:long_name = "Sea Water Potential Temperature" ;
    potential_temp:standard_name = "sea_water_potential_temperature" ;
    potential_temp:_FillValue = -9999.f ;
  float salinity(time, depth, lat, lon) ;
    salinity:units = "1e-3" ;
    salinity:long_name = "Sea Water Practical Salinity" ;
    salinity:standard_name = "sea_water_salinity" ;
    salinity:_FillValue = -9999.f ;

// global attributes:
  :Conventions = "CF-1.8" ;
  :title = "North Pacific 4D Thermocline Forecast Cube" ;
  :institution = "HYCOM Consortium" ;
data:
  time = 0.0, 1.0 ;
  depth = 5.0, 100.0, 500.0 ;
  lat = 30.0, 32.0 ;
  lon = -140.0, -138.0 ;
  potential_temp =
    18.4, 18.2, 17.6, 17.4,
    13.2, 13.0, 12.5, 12.3,
     6.1,  6.0,  5.8,  5.7,
    18.6, 18.3, 17.7, 17.5,
    13.1, 12.9, 12.4, 12.2,
     6.1,  6.0,  5.8,  5.7 ;
  salinity =
    34.82, 34.79, 34.65, 34.61,
    34.40, 34.38, 34.31, 34.28,
    34.12, 34.11, 34.09, 34.08,
    34.83, 34.80, 34.66, 34.62,
    34.41, 34.39, 34.32, 34.29,
    34.12, 34.11, 34.09, 34.08 ;
}
