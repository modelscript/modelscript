-- Industrial SCADA Sensor Telemetry Packet (ASN.1 X.680)
IndustrialTelemetry { iso(1) org(3) dod(6) internet(1) private(4) enterprise(1) 55001 }
DEFINITIONS AUTOMATIC TAGS ::= BEGIN

SensorReading ::= SEQUENCE {
  sensorId      INTEGER (1..65535),
  location      PrintableString (SIZE (1..32)),
  timestampSec  INTEGER (0..4294967295),
  temperatureK  REAL,
  pressurePa    REAL,
  valid         BOOLEAN
}

telemetryOid OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 55001 1 }

END
