{
  "name": "@modelscript/ampl",
  "version": "0.1.0",
  "description": "AMPL (A Mathematical Programming Language) parser, relational set instantiator, ASL .nl exporter, and COIN-OR WebAssembly solver bridge for ModelScript",
  "keywords": [
    "modelscript",
    "ampl",
    "optimization",
    "lp",
    "milp",
    "nlp",
    "minlp",
    "mathprog"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/index.d.ts",
      "default": "./dist/src/parser/index.js"
    },
    "./instantiator": {
      "types": "./dist/src/instantiator/index.d.ts",
      "default": "./dist/src/instantiator/index.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./solvers": {
      "types": "./dist/src/solvers/index.d.ts",
      "default": "./dist/src/solvers/index.js"
    },
    "./dae": {
      "types": "./dist/src/dae/index.d.ts",
      "default": "./dist/src/dae/index.js"
    },
    "./nl": {
      "types": "./dist/src/nl/index.d.ts",
      "default": "./dist/src/nl/index.js"
    },
    "./mps": {
      "types": "./dist/src/mps/index.d.ts",
      "default": "./dist/src/mps/index.js"
    },
    "./presolve": {
      "types": "./dist/src/presolve/index.d.ts",
      "default": "./dist/src/presolve/index.js"
    },
    "./tables": {
      "types": "./dist/src/tables/index.d.ts",
      "default": "./dist/src/tables/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    }
  },
  "files": [
    "src/**",
    "dist/**",
    "assets/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "test:bench": "npx tsx tests/ampl-benchmark-runner.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*",
    "@modelscript/simulate": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "modelscript": {
    "tier": "stable",
    "category": "language"
  }
}
