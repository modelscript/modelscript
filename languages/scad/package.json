{
  "name": "@modelscript/scad",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./evaluator": {
      "types": "./dist/src/evaluator.d.ts",
      "default": "./dist/src/evaluator.js"
    },
    "./patcher": {
      "types": "./dist/src/patcher.d.ts",
      "default": "./dist/src/patcher.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm",
    "./ui": {
      "types": "./dist/src/ui/ScadPanel.d.ts",
      "default": "./dist/src/ui/ScadPanel.js"
    }
  },
  "files": [
    "src/**",
    "src-gen/**",
    "dist/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build-language-parser.js && tsc",
    "build:parser": "node ../../scripts/build-language-parser.js --force",
    "clean": "rimraf dist src-gen as-gen *.wasm",
    "lint": "eslint src tests --no-warn-ignored",
    "playground": "npx tsx ../../scripts/language-playground.ts .",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/cad": "*",
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
