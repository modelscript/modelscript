{
  "name": "@modelscript/scad",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./evaluator": {
      "types": "./dist/src/evaluator.d.ts",
      "default": "./dist/src/evaluator.js"
    },
    "./patcher": {
      "types": "./dist/src/patcher.d.ts",
      "default": "./dist/src/patcher.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./dist/parser.wasm": "./dist/parser.wasm"
  },
  "files": [
    "src/**",
    "src-gen/**",
    "dist/**"
  ],
  "scripts": {
    "build": "node build.js && tsc",
    "build:parser": "node build.js --force",
    "clean": "rimraf dist src-gen as-gen *.wasm",
    "lint": "eslint src --no-warn-ignored",
    "test": "npx tsx --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=../../scripts/node-test-ctrf-reporter.cjs --test-reporter-destination=stdout tests/test-scad-evaluator.ts"
  },
  "dependencies": {
    "@modelscript/cad": "*",
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
