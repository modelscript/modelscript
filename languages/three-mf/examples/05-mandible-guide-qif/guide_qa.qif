<?xml version="1.0" encoding="UTF-8"?>
<QIFDocument xmlns="http://qifstandards.org/xsd/qif3" versionQIF="3.0.0">
  <Header>
    <Application>
      <Name>Ansatz Medical AM Metrology QA</Name>
    </Application>
    <Description>Dimensional verification plan for MandibleCuttingGuide (ISO 13485)</Description>
