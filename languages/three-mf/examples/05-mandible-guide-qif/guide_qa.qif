        <Name>FixationSleeveProx_ID</Name>
        <Tolerance>
          <MaxValue>2.08</MaxValue>
          <MinValue>1.95</MinValue>
        </Tolerance>
      </DiameterCharacteristicDefinition>
      <LinearCharacteristicDefinition id="2">
        <Name>OsteotomySlotWidth</Name>
        <Tolerance>
          <MaxValue>1.28</MaxValue>
          <MinValue>1.15</MinValue>
        </Tolerance>
      </LinearCharacteristicDefinition>
    </CharacteristicDefinitions>
  </Characteristics>
</QIFDocument>
