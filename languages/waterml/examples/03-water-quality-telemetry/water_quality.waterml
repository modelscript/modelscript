          <wml2:point><wml2:MeasurementTVP><wml2:time>2026-07-10T18:00:00Z</wml2:time><wml2:value>9.1</wml2:value></wml2:MeasurementTVP></wml2:point>
        </wml2:MeasurementTimeseries>
      </om:result>
