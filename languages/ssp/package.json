{
  "name": "@modelscript/ssp",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./ssd-parser": {
      "types": "./dist/src/ssd-parser.d.ts",
      "default": "./dist/src/ssd-parser.js"
    },
    "./projection": {
      "types": "./dist/src/projection.d.ts",
      "default": "./dist/src/projection.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram.d.ts",
      "default": "./dist/src/diagram.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    }
  },
  "files": [
    "src/**",
    "dist/**",
    "src-gen/**"
  ],
  "scripts": {
    "build": "node ../../scripts/build-language-parser.js && tsc",
    "build:parser": "node ../../scripts/build-language-parser.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "modelscript": {
    "tier": "beta",
    "category": "language"
  }
}
