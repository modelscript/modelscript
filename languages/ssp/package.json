{
  "name": "@modelscript/ssp",
  "version": "0.0.18",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./ssd-parser": {
      "types": "./dist/src/ssd-parser.d.ts",
      "default": "./dist/src/ssd-parser.js"
    },
    "./projection": {
      "types": "./dist/src/projection.d.ts",
      "default": "./dist/src/projection.js"
    },
    "./diagram": {
      "types": "./dist/src/diagram.d.ts",
      "default": "./dist/src/diagram.js"
    }
  },
  "files": [
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/dsl": "*",
    "@modelscript/runtime": "*"
  },
  "modelscript": {
    "tier": "stable",
    "category": "language"
  }
}
