!- Small Office Building with Reciprocal Interzone Partition and Ideal Loads HVAC
Building,
  ChicagoSmallOffice,      !- Name
  0.0,                     !- North Axis [deg]
  City,                    !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value [W]
  0.4,                     !- Temperature Convergence Tolerance Value [deltaC]
  FullExterior,            !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

Zone,
  OpenOffice,              !- Name
  0.0,                     !- Direction of Relative North [deg]
  0.0, 0.0, 0.0,           !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.2,                     !- Ceiling Height [m]
  256.0;                   !- Volume [m3]

Zone,
  ConferenceRoom,          !- Name
  0.0,                     !- Direction of Relative North [deg]
  0.0, 8.0, 0.0,           !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.2,                     !- Ceiling Height [m]
  128.0;                   !- Volume [m3]

Material,
  BrickVeneer,             !- Name
  MediumRough,             !- Roughness
  0.10,                    !- Thickness [m]
  0.89,                    !- Conductivity [W/m-K]
  1920.0,                  !- Density [kg/m3]
  790.0,                   !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.70,                    !- Solar Absorptance
  0.70;                    !- Visible Absorptance

Material,
  PolyisoBoard,            !- Name
  MediumSmooth,            !- Roughness
  0.08,                    !- Thickness [m]
  0.025,                   !- Conductivity [W/m-K]
  32.0,                    !- Density [kg/m3]
  1400.0,                  !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.50,                    !- Solar Absorptance
  0.50;                    !- Visible Absorptance

Material,
  GypsumBoard,             !- Name
  Smooth,                  !- Roughness
  0.016,                   !- Thickness [m]
  0.16,                    !- Conductivity [W/m-K]
  800.0,                   !- Density [kg/m3]
  1090.0,                  !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.40,                    !- Solar Absorptance
  0.40;                    !- Visible Absorptance

Construction,
  OfficeExtWall,           !- Name
  BrickVeneer,             !- Outside Layer
  PolyisoBoard,            !- Layer 2
  GypsumBoard;             !- Inside Layer

Construction,
  InteriorPartition,       !- Name
  GypsumBoard,             !- Outside Layer
  GypsumBoard;             !- Inside Layer

