!- Net-Zero Desert Hospital Wing with Radiant Concrete Slab and High-Albedo Roof
Building,
  PhoenixNetZeroHospital,  !- Name
  0.0,                     !- North Axis [deg]
  City,                    !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value [W]
  0.4,                     !- Temperature Convergence Tolerance Value [deltaC]
  FullExterior,            !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

Zone,
  PatientWard,             !- Name
  0.0,                     !- Direction of Relative North [deg]
  0.0, 0.0, 0.0,           !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.6,                     !- Ceiling Height [m]
  432.0;                   !- Volume [m3]

Zone,
  SurgicalSuite,           !- Name
  0.0,                     !- Direction of Relative North [deg]
  12.0, 0.0, 0.0,          !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.6,                     !- Ceiling Height [m]
  360.0;                   !- Volume [m3]

Material,
  WhiteCoolMembrane,       !- Name
  Smooth,                  !- Roughness
  0.005,                   !- Thickness [m]
  0.16,                    !- Conductivity [W/m-K]
  1120.0,                  !- Density [kg/m3]
  1460.0,                  !- Specific Heat [J/kg-K]
  0.88,                    !- Thermal Absorptance
  0.22,                    !- Solar Absorptance
  0.22;                    !- Visible Absorptance

Material,
  RadiantConcreteSlab,     !- Name
  MediumRough,             !- Roughness
  0.22,                    !- Thickness [m]
  1.80,                    !- Conductivity [W/m-K]
  2320.0,                  !- Density [kg/m3]
  900.0,                   !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.65,                    !- Solar Absorptance
  0.65;                    !- Visible Absorptance

Material,
  VacuumInsulPanel,        !- Name
  Smooth,                  !- Roughness
  0.06,                    !- Thickness [m]
  0.012,                   !- Conductivity [W/m-K]
  180.0,                   !- Density [kg/m3]
  800.0,                   !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.40,                    !- Solar Absorptance
  0.40;                    !- Visible Absorptance

Construction,
  HighPerfWall,            !- Name
  RadiantConcreteSlab,     !- Outside Layer
  VacuumInsulPanel;        !- Inside Layer

Construction,
  CoolPV_Roof,             !- Name
  WhiteCoolMembrane,       !- Outside Layer
  VacuumInsulPanel,        !- Layer 2
  RadiantConcreteSlab;     !- Inside Layer

Construction,
  HospitalPartition,       !- Name
  RadiantConcreteSlab;     !- Single Mass Layer

BuildingSurface:Detailed,
  WardSouthWall,           !- Name
  Wall,                    !- Surface Type
  HighPerfWall,            !- Construction Name
  PatientWard,             !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0.0, 0.0, 3.6,           !- Vertex 1
  0.0, 0.0, 0.0,           !- Vertex 2
  12.0, 0.0, 0.0,          !- Vertex 3
  12.0, 0.0, 3.6;          !- Vertex 4

BuildingSurface:Detailed,
  WardRoof,                !- Name
  Roof,                    !- Surface Type
  CoolPV_Roof,             !- Construction Name
  PatientWard,             !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0.0, 0.0, 3.6,           !- Vertex 1
  12.0, 0.0, 3.6,          !- Vertex 2
  12.0, 10.0, 3.6,         !- Vertex 3
  0.0, 10.0, 3.6;          !- Vertex 4

BuildingSurface:Detailed,
  WardToSurgWall,          !- Name
  Wall,                    !- Surface Type
  HospitalPartition,       !- Construction Name
  PatientWard,             !- Zone Name
  Surface,                 !- Outside Boundary Condition
  SurgToWardWall,          !- Outside Boundary Condition Object
  NoSun,                   !- Sun Exposure
  NoWind,                  !- Wind Exposure
  0.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  12.0, 0.0, 3.6,          !- Vertex 1
  12.0, 0.0, 0.0,          !- Vertex 2
  12.0, 10.0, 0.0,         !- Vertex 3
  12.0, 10.0, 3.6;         !- Vertex 4

BuildingSurface:Detailed,
  SurgToWardWall,          !- Name
  Wall,                    !- Surface Type
  HospitalPartition,       !- Construction Name
  SurgicalSuite,           !- Zone Name
  Surface,                 !- Outside Boundary Condition
  WardToSurgWall,          !- Outside Boundary Condition Object
  NoSun,                   !- Sun Exposure
  NoWind,                  !- Wind Exposure
  0.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  12.0, 10.0, 3.6,         !- Vertex 1
  12.0, 10.0, 0.0,         !- Vertex 2
  12.0, 0.0, 0.0,          !- Vertex 3
  12.0, 0.0, 3.6;          !- Vertex 4

Schedule:File,
  HospitalLoadSch,         !- Name
  Fraction,                !- Schedule Type Limits Name
  schedules.csv,           !- File Name
  2,                       !- Column Number
  1,                       !- Rows to Skip at Top
  24,                      !- Number of Hours of Data
  Comma;                   !- Column Separator

ElectricEquipment,
  MedicalImagingLoad,      !- Name
  SurgicalSuite,           !- Zone Name
  HospitalLoadSch,         !- Schedule Name
  EquipmentLevel,          !- Calculation Method
  3200.0;                  !- Design Level [W]

ZoneHVAC:IdealLoadsAirSystem,
  PatientWardDOAS,         !- Name
  PatientWard;             !- Zone Name

ZoneHVAC:IdealLoadsAirSystem,
  SurgicalSuiteDOAS,       !- Name
  SurgicalSuite;           !- Zone Name
