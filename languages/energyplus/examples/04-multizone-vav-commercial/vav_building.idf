!- Multi-Zone VAV Commercial Building with Denver Weather and External Occupancy Schedule
Building,
  DenverCommercialVAV,     !- Name
  0.0,                     !- North Axis [deg]
  Suburbs,                 !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value [W]
  0.4,                     !- Temperature Convergence Tolerance Value [deltaC]
  FullExterior,            !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

Zone,
  SouthPerimeter,          !- Name
  0.0,                     !- Direction of Relative North [deg]
  0.0, 0.0, 0.0,           !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.5,                     !- Ceiling Height [m]
  315.0;                   !- Volume [m3]

Zone,
  CoreZone,                !- Name
  0.0,                     !- Direction of Relative North [deg]
  0.0, 6.0, 0.0,           !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.5,                     !- Ceiling Height [m]
  525.0;                   !- Volume [m3]

Zone,
  NorthPerimeter,          !- Name
  0.0,                     !- Direction of Relative North [deg]
  0.0, 16.0, 0.0,          !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.5,                     !- Ceiling Height [m]
  315.0;                   !- Volume [m3]

Material,
  PrecastConcrete,         !- Name
  MediumRough,             !- Roughness
  0.15,                    !- Thickness [m]
  1.30,                    !- Conductivity [W/m-K]
  2240.0,                  !- Density [kg/m3]
  840.0,                   !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.65,                    !- Solar Absorptance
  0.65;                    !- Visible Absorptance

Material,
  XPSInsulation,           !- Name
  MediumSmooth,            !- Roughness
  0.10,                    !- Thickness [m]
  0.029,                   !- Conductivity [W/m-K]
  35.0,                    !- Density [kg/m3]
  1450.0,                  !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.50,                    !- Solar Absorptance
  0.50;                    !- Visible Absorptance

Construction,
  CommercialExtWall,       !- Name
  PrecastConcrete,         !- Outside Layer
  XPSInsulation;           !- Inside Layer

BuildingSurface:Detailed,
  SouthFacade,             !- Name
  Wall,                    !- Surface Type
  CommercialExtWall,       !- Construction Name
  SouthPerimeter,          !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0.0, 0.0, 3.5,           !- Vertex 1
  0.0, 0.0, 0.0,           !- Vertex 2
  15.0, 0.0, 0.0,          !- Vertex 3
  15.0, 0.0, 3.5;          !- Vertex 4

BuildingSurface:Detailed,
  NorthFacade,             !- Name
  Wall,                    !- Surface Type
  CommercialExtWall,       !- Construction Name
  NorthPerimeter,          !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  15.0, 22.0, 3.5,         !- Vertex 1
  15.0, 22.0, 0.0,         !- Vertex 2
  0.0, 22.0, 0.0,          !- Vertex 3
  0.0, 22.0, 3.5;          !- Vertex 4

Schedule:File,
  CommercialOccSch,        !- Name
  Fraction,                !- Schedule Type Limits Name
  occupancy.csv,           !- File Name
  2,                       !- Column Number
  1,                       !- Rows to Skip at Top
  24,                      !- Number of Hours of Data
  Comma;                   !- Column Separator

People,
  CorePeople,              !- Name
  CoreZone,                !- Zone Name
  CommercialOccSch,        !- Number of People Schedule Name
  People,                  !- Number of People Calculation Method
  18,                      !- Number of People
  ,                        !- People per Floor Area
  0.3;                     !- Fraction Radiant

ZoneHVAC:IdealLoadsAirSystem,
  SouthVAVBox,             !- Name
  SouthPerimeter;          !- Zone Name

ZoneHVAC:IdealLoadsAirSystem,
  CoreVAVBox,              !- Name
  CoreZone;                !- Zone Name

ZoneHVAC:IdealLoadsAirSystem,
  NorthVAVBox,             !- Name
  NorthPerimeter;          !- Zone Name
