!- Single-Zone Shoebox Thermal Envelope (8m x 6m x 3m)
Building,
  ShoeboxThermalEnvelope,  !- Name
  0.0,                     !- North Axis [deg]
  Suburbs,                 !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value [W]
  0.4,                     !- Temperature Convergence Tolerance Value [deltaC]
  FullExterior,            !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

Zone,
  MainZone,                !- Name
  0.0,                     !- Direction of Relative North [deg]
  0.0, 0.0, 0.0,           !- Origin [X, Y, Z]
  1,                       !- Type
  1,                       !- Multiplier
  3.0,                     !- Ceiling Height [m]
  144.0;                   !- Volume [m3]

Material,
  ConcreteBlock,           !- Name
  MediumRough,             !- Roughness
  0.20,                    !- Thickness [m]
  1.40,                    !- Conductivity [W/m-K]
  2100.0,                  !- Density [kg/m3]
  880.0,                   !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.65,                    !- Solar Absorptance
  0.65;                    !- Visible Absorptance

Material,
  MineralWool,             !- Name
  MediumRough,             !- Roughness
  0.10,                    !- Thickness [m]
  0.04,                    !- Conductivity [W/m-K]
  45.0,                    !- Density [kg/m3]
  840.0,                   !- Specific Heat [J/kg-K]
  0.90,                    !- Thermal Absorptance
  0.60,                    !- Solar Absorptance
  0.60;                    !- Visible Absorptance

Construction,
  ExtWallConst,            !- Name
  ConcreteBlock,           !- Outside Layer
  MineralWool;             !- Layer 2

Construction,
  SlabRoofConst,           !- Name
  MineralWool,             !- Outside Layer
  ConcreteBlock;           !- Layer 2

BuildingSurface:Detailed,
  WallSouth,               !- Name
  Wall,                    !- Surface Type
  ExtWallConst,            !- Construction Name
  MainZone,                !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0.0, 0.0, 3.0,           !- Vertex 1
  0.0, 0.0, 0.0,           !- Vertex 2
  8.0, 0.0, 0.0,           !- Vertex 3
  8.0, 0.0, 3.0;           !- Vertex 4

BuildingSurface:Detailed,
  WallNorth,               !- Name
  Wall,                    !- Surface Type
  ExtWallConst,            !- Construction Name
  MainZone,                !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  8.0, 6.0, 3.0,           !- Vertex 1
  8.0, 6.0, 0.0,           !- Vertex 2
  0.0, 6.0, 0.0,           !- Vertex 3
  0.0, 6.0, 3.0;           !- Vertex 4

BuildingSurface:Detailed,
  FloorSlab,               !- Name
  Floor,                   !- Surface Type
  SlabRoofConst,           !- Construction Name
  MainZone,                !- Zone Name
  Ground,                  !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  NoSun,                   !- Sun Exposure
  NoWind,                  !- Wind Exposure
  0.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0.0, 6.0, 0.0,           !- Vertex 1
  0.0, 0.0, 0.0,           !- Vertex 2
  8.0, 0.0, 0.0,           !- Vertex 3
  8.0, 6.0, 0.0;           !- Vertex 4

BuildingSurface:Detailed,
  RoofDeck,                !- Name
  Roof,                    !- Surface Type
  SlabRoofConst,           !- Construction Name
  MainZone,                !- Zone Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0.0, 0.0, 3.0,           !- Vertex 1
  8.0, 0.0, 3.0,           !- Vertex 2
  8.0, 6.0, 3.0,           !- Vertex 3
  0.0, 6.0, 3.0;           !- Vertex 4

ZoneHVAC:IdealLoadsAirSystem,
  MainZoneIdealHVAC,       !- Name
  MainZone;                !- Zone Name
