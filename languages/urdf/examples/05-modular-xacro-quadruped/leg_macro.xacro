<?xml version="1.0"?>
<robot name="quadruped_leg_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="thigh_length" value="0.22"/>
  <xacro:property name="shin_length" value="0.21"/>
  <xacro:property name="max_hip_torque" value="35.0"/>

  <link name="macro_hip_module">
    <inertial>
      <mass value="0.65"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
  </link>
</robot>
