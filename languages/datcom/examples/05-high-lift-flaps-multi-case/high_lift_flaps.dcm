* Multi-Case High-Lift Trailing-Edge Flaps and Differential Ailerons Study
CASEID APPROACH HIGH LIFT FLAPS
DIM M
DERIV DEG
SAVE
 $FLTCON NMACH=1.0, MACH(1)=0.22, NALT=1.0, ALT(1)=300.0,
  NALPHA=7.0, ALSCHD(1)=-4.0,-2.0,0.0,2.0,4.0,6.0,8.0,
  WT=185000.0$
 $OPTINS SREF=42.0, CBARR=2.35, BLREF=19.2$
 $SYNTHS XCG=8.90, ZCG=-0.1, XW=6.60, ZW=-0.35, ALIW=1.5,
  XH=15.8, ZH=0.60, ALIH=-1.5, XV=14.6, ZV=0.50, VERTUP=.TRUE.$
 $BODY NX=6.0, X(1)=0.0,2.0,6.0,12.0,16.0,18.2,
  S(1)=0.0,2.1,3.6,3.4,1.2,0.12,
  R(1)=0.0,0.82,1.07,1.04,0.62,0.20$
 $WGPLNF CHRDR=3.10, CHRDTP=1.20, SSPN=9.60, SSPNE=8.55,
  SAVSI=18.0, CHSTAT=0.25, TWISTA=-2.0, DHDADI=3.0, TYPE=1.0$
 $HTPLNF CHRDR=1.80, CHRDTP=0.80, SSPN=3.40, SSPNE=3.10,
  SAVSI=22.0, CHSTAT=0.25, TYPE=1.0$
 $VTPLNF CHRDR=2.90, CHRDTP=1.10, SSPN=3.10, SSPNE=2.60,
  SAVSI=34.0, CHSTAT=0.25, TYPE=1.0$
 $SYMFLP FTYPE=1.0, NDELTA=4.0, DELTA(1)=0.0,10.0,20.0,30.0,
  SPANFI=1.20, SPANFO=5.80, CHRDFI=0.75, CHRDFO=0.55$
NACA-W-4-2412
NACA-H-4-0009
NACA-V-4-0009
BUILD
DAMP
NEXT CASE
CASEID ROLL CONTROL AILERON DEFLECTION
 $FLTCON NMACH=1.0, MACH(1)=0.35, NALT=1.0, ALT(1)=3000.0,
  NALPHA=5.0, ALSCHD(1)=-2.0,0.0,2.0,4.0,6.0,
  WT=185000.0$
 $ASYFLP STYPE=4.0, NDELTA=3.0, DELTAL(1)=-15.0,-5.0,10.0,
  DELTAR(1)=15.0,5.0,-10.0, SPANFI=6.0, SPANFO=9.2,
  CHRDFI=0.45, CHRDFO=0.30$
PLOT
NEXT CASE
