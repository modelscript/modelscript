  {
    "name": "SDS",
    "kind": "Class",
    "namePath": "HDF4.SDS",
    "exports": [
      "tag",
      "dataType",
      "rank",
      "scaleFactor",
      "addOffset"
    ],
    "inherits": [],
    "metadata": {
      "label": "Scientific Data Set (SDS)",
      "category": "HDF4 Core Objects",
      "domain": "scientific-data",
      "description": "N-dimensional typed scientific array with dimension scales, calibration, and attributes (DFTAG_SD=702).",
      "provenance": "NCSA HDF4 Specification v4.2 (1987)",
      "aliases": [
        "DFTAG_SD",
        "SCIENTIFIC_DATA_SET"
      ],
      "parameters": [
        {
          "key": "tag",
          "type": "real",
          "defaultValue": 702,
          "description": "DFTAG_SD primary data tag"
        },
        {
          "key": "dataType",
          "type": "real",
          "defaultValue": 5,
          "description": "DFNT_FLOAT32 (5) or DFNT_FLOAT64 (6)"
        },
        {
          "key": "rank",
          "type": "real",
          "defaultValue": 2,
          "description": "Number of array dimensions"
        },
        {
          "key": "scaleFactor",
          "type": "real",
          "defaultValue": 1,
          "description": "Linear calibration gain"
        },
        {
          "key": "addOffset",
          "type": "real",
          "defaultValue": 0,
          "description": "Linear calibration offset"
        }
      ],
      "wasmKernel": "hdf4ModelEval",
      "archetypeId": 1
    }
  },
