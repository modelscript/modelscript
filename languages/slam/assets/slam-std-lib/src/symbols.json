  {
    "name": "DETECT",
    "kind": "block",
    "namePath": "SLAM.DETECT",
    "exports": [
      "VALUE",
      "TOL",
      "DIR"
    ],
    "inherits": [],
    "metadata": {
      "label": "DETECT — Continuous State Threshold Event",
      "category": "Continuous & Threshold",
      "domain": "systems",
      "description": "Monitors SS(i) or DD(i) and generates a discrete network entity when crossing VALUE in direction XDIR within TOL.",
      "provenance": "Pritsker & Pegden (1979), Introduction to Simulation and SLAM, Ch. 9 (Combined Modeling)",
      "aliases": [
        "THRESHOLD",
        "STATE_EVENT"
