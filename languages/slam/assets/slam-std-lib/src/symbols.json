          "key": "VALUE",
          "type": "real",
          "defaultValue": 0,
          "unit": "1",
          "description": "Threshold value"
        },
        {
          "key": "TOL",
          "type": "real",
          "defaultValue": 0.001,
          "unit": "1",
          "description": "Crossing tolerance"
        },
        {
          "key": "DIR",
          "type": "real",
          "defaultValue": 1,
          "unit": "enum",
          "description": "1 = XP (+), -1 = XN (-), 0 = X (either)"
        }
      ],
      "wasmKernel": "slamBlockStep",
      "archetypeId": 12
    }
  },
