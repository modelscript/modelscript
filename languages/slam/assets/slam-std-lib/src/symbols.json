[
  {
    "name": "CREATE",
    "kind": "block",
    "namePath": "SLAM.CREATE",
    "exports": [
      "TBC",
      "TF",
      "MA",
      "MC"
    ],
    "inherits": [],
    "metadata": {
      "label": "CREATE — Entity Arrival Generator",
      "category": "Entity Flow",
      "domain": "systems",
      "description": "Generates entities into a SLAM II network according to interarrival time TBC and first creation TF.",
      "provenance": "Pritsker & Pegden (1979), Introduction to Simulation and SLAM, Ch. 3",
      "aliases": [
        "ARRIVAL",
        "SOURCE"
      ],
      "parameters": [
        {
          "key": "TBC",
          "type": "real",
          "defaultValue": 1,
          "unit": "time",
          "description": "Time between entity creations"
        },
        {
          "key": "TF",
          "type": "real",
          "defaultValue": 0,
          "unit": "time",
          "description": "Time of first entity creation"
        },
        {
          "key": "MA",
          "type": "real",
          "defaultValue": 1,
          "unit": "index",
          "description": "Mark attribute index for creation timestamp"
        },
        {
          "key": "MC",
          "type": "real",
          "defaultValue": 0,
          "unit": "count",
          "description": "Maximum creations (0 = unlimited)"
        }
      ],
      "wasmKernel": "slamBlockStep",
      "archetypeId": 1
    }
  },
  {
    "name": "QUEUE",
    "kind": "block",
    "namePath": "SLAM.QUEUE",
    "exports": [
      "IFL",
      "IQ",
      "QC"
    ],
    "inherits": [],
    "metadata": {
      "label": "QUEUE — Entity Waiting File",
      "category": "Entity Flow",
      "domain": "systems",
      "description": "Holds arriving entities in file IFL until a downstream service ACTIVITY becomes available.",
      "provenance": "Pritsker & Pegden (1979), Introduction to Simulation and SLAM, Ch. 3",
      "aliases": [
        "QNODE",
        "BUFFER"
      ],
      "parameters": [
        {
          "key": "IFL",
          "type": "real",
          "defaultValue": 1,
          "unit": "index",
          "description": "File number"
        },
        {
          "key": "IQ",
          "type": "real",
          "defaultValue": 0,
          "unit": "count",
          "description": "Initial number of entities in queue"
        },
        {
          "key": "QC",
          "type": "real",
          "defaultValue": 1000,
          "unit": "count",
          "description": "Maximum queue capacity"
        }
      ],
      "wasmKernel": "slamBlockStep",
      "archetypeId": 2
    }
  },
  {
    "name": "ACTIVITY",
    "kind": "block",
    "namePath": "SLAM.ACTIVITY",
    "exports": [
      "DUR",
      "PROB",
      "N"
    ],
    "inherits": [],
    "metadata": {
      "label": "ACTIVITY — Timed Branch / Server",
      "category": "Entity Flow",
      "domain": "systems",
      "description": "Delays entities for duration DUR and routes them probabilistically or conditionally to target node NLBL.",
      "provenance": "Pritsker & Pegden (1979), Introduction to Simulation and SLAM, Ch. 3",
      "aliases": [
        "ACT",
        "BRANCH",
        "SERVICE"
      ],
      "parameters": [
        {
          "key": "DUR",
          "type": "real",
          "defaultValue": 1,
          "unit": "time",
          "description": "Activity service or transit duration"
        },
        {
          "key": "PROB",
          "type": "real",
          "defaultValue": 1,
          "unit": "1",
          "description": "Branch selection probability"
        },
        {
          "key": "N",
          "type": "real",
          "defaultValue": 1,
          "unit": "count",
          "description": "Number of parallel servers"
        }
      ],
      "wasmKernel": "slamBlockStep",
      "archetypeId": 3
    }
  },
