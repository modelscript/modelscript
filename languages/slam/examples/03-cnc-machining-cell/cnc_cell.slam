; SLAM II Multi-Resource CNC Machining Cell with Shared Setup Operator
GEN, PRITSKER, CNC_MACHINING_CELL, 1/1/1979, 1;
LIMITS, 3, 3, 200;
INITIALIZE, 0.0, 600.0;
NETWORK;
  RESOURCE/CNC(3), 1;
  RESOURCE/OPERATOR(1), 2;
  CREATE, EXPON(5.0), 0.0, 1;
  WCNC  AWAIT(1), CNC/1;
  WOP1  AWAIT(2), OPERATOR/1;
        ACTIVITY/1, UNFRM(1.5, 2.5), 1.0, RELOP;
  RELOP FREE, OPERATOR/1;
        ACTIVITY/2, RNORM(11.0, 1.5), 1.0, RELCNC;
  RELCNC FREE, CNC/1;
        COLCT, INT(1), PART_CYCLE_TIME;
        TERMINATE;
ENDNETWORK;
FIN;
