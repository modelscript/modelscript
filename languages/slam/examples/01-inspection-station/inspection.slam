; SLAM II Single-Server Quality Inspection Station
GEN, PRITSKER, INSPECTION_STATION, 1/1/1979, 1;
LIMITS, 1, 2, 100;
INITIALIZE, 0.0, 480.0;
NETWORK;
  CREATE, EXPON(6.0), 0.0, 1;
  QINSP QUEUE(1), 0, 50;
        ACTIVITY/1, UNFRM(3.5, 5.5);
        COLCT, INT(1), TIME_IN_INSPECTION;
        TERMINATE;
ENDNETWORK;
FIN;
