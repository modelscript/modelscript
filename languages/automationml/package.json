{
  "name": "@modelscript/automationml",
  "version": "0.1.0",
  "description": "IEC 62714 AutomationML (CAEX) mechatronic plant engineering and virtual commissioning language package for ModelScript",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "default": "./dist/src/language.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./parser": {
      "types": "./dist/src/parser/index.d.ts",
      "default": "./dist/src/parser/index.js"
    },
    "./lints": {
      "types": "./dist/src/lints/index.d.ts",
      "default": "./dist/src/lints/index.js"
    },
    "./dae": {
      "types": "./dist/src/dae/index.d.ts",
      "default": "./dist/src/dae/index.js"
    },
    "./cosim": {
      "types": "./dist/src/cosim/index.d.ts",
      "default": "./dist/src/cosim/index.js"
    },
    "./projections": {
      "types": "./dist/src/projections/index.d.ts",
      "default": "./dist/src/projections/index.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp.d.ts",
      "default": "./dist/src/lsp.js"
    },
    "./parser.wasm": "./dist/parser.wasm",
    "./wasm-parser": {
      "types": "./src-gen/bindings.d.ts",
      "default": "./src-gen/bindings.js"
    },
    "./aml-dsl-parser.wasm": "./dist/aml-dsl-parser.wasm",
    "./aml-dsl-wasm-parser": {
      "types": "./src-gen/aml-dsl/bindings.d.ts",
      "default": "./src-gen/aml-dsl/bindings.js"
    },
    "./ui": {
      "types": "./dist/src/ui/AmlPanel.d.ts",
      "default": "./dist/src/ui/AmlPanel.js"
    }
  },
  "files": [
    "dist/**",
    "src-gen/**"
  ],
  "scripts": {
    "ansatz": "npx tsx ../../scripts/tools/language-ansatz.ts .",
    "build": "node ../../scripts/build/build-language-parser.js && node ./scripts/build-dsl-parser.js && tsc",
    "build:parser": "node ../../scripts/build/build-language-parser.js --force && node ./scripts/build-dsl-parser.js --force",
    "clean": "rimraf dist",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "node ../../scripts/ci/test-runner.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/diagram": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/plcopen": "workspace:*",
    "@modelscript/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@modelscript/design-tokens": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelscript/design-tokens": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "modelscript": {
    "tier": "alpha",
    "category": "language"
  }
}
