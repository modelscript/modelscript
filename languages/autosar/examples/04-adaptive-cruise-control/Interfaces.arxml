<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AccInterfaces</SHORT-NAME>
      <ELEMENTS>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RadarTrackIf</SHORT-NAME>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE><SHORT-NAME>TargetRangeM</SHORT-NAME></VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE><SHORT-NAME>RelVelocityMs</SHORT-NAME></VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <CLIENT-SERVER-INTERFACE>
          <SHORT-NAME>DecelRequestIf</SHORT-NAME>
          <OPERATIONS>
            <CLIENT-SERVER-OPERATION><SHORT-NAME>RequestDeceleration</SHORT-NAME></CLIENT-SERVER-OPERATION>
          </OPERATIONS>
        </CLIENT-SERVER-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
