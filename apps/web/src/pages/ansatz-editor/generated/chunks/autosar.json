    "subFormats": ["arxml"],
    "difficulty": 1,
    "title": "Single Sensor Application SWC with Valid Timing",
    "description": "AUTOSAR Classic Application Software Component for a wheel speed sensor with a provided sender-receiver port and a 10 ms periodic runnable meeting its 1.5 ms WCET budget.",
    "category": "Automotive Software Architecture",
    "tags": ["autosar", "swc", "wcet", "timing-event"],
    "activeFile": "SensorSwc.arxml",
    "fileNames": ["SensorSwc.arxml"],
    "fileCount": 1,
    "isDefaultStarter": true,
    "code": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<AUTOSAR>\n  <AR-PACKAGES>\n    <AR-PACKAGE>\n      <SHORT-NAME>Chassis</SHORT-NAME>\n      <ELEMENTS>\n        <SENDER-RECEIVER-INTERFACE>\n          <SHORT-NAME>WheelSpeedIf</SHORT-NAME>\n          <DATA-ELEMENTS>\n            <VARIABLE-DATA-PROTOTYPE>\n              <SHORT-NAME>WheelSpeedRpm</SHORT-NAME>\n            </VARIABLE-DATA-PROTOTYPE>\n          </DATA-ELEMENTS>\n        </SENDER-RECEIVER-INTERFACE>\n\n        <APPLICATION-SW-COMPONENT-TYPE>\n          <SHORT-NAME>WheelSpeedSensorSwc</SHORT-NAME>\n          <PORTS>\n            <P-PORT-PROTOTYPE>\n              <SHORT-NAME>SpeedOut</SHORT-NAME>\n              <PROVIDED-INTERFACE-TREF DEST=\"SENDER-RECEIVER-INTERFACE\">/Chassis/WheelSpeedIf</PROVIDED-INTERFACE-TREF>\n            </P-PORT-PROTOTYPE>\n          </PORTS>\n          <INTERNAL-BEHAVIORS>\n            <SWC-INTERNAL-BEHAVIOR>\n              <SHORT-NAME>WheelSpeedSensor_IB</SHORT-NAME>\n              <RUNNABLES>\n                <RUNNABLE-ENTITY>\n                  <SHORT-NAME>RE_SampleWheelSpeed</SHORT-NAME>\n                  <EXECUTION-TIME-WCET>0.0015</EXECUTION-TIME-WCET>\n                </RUNNABLE-ENTITY>\n              </RUNNABLES>\n              <EVENTS>\n                <TIMING-EVENT>\n                  <SHORT-NAME>TE_10ms</SHORT-NAME>\n                  <START-ON-EVENT-REF>RE_SampleWheelSpeed</START-ON-EVENT-REF>\n                  <PERIOD>0.010</PERIOD>\n                </TIMING-EVENT>\n              </EVENTS>\n            </SWC-INTERNAL-BEHAVIOR>\n          </INTERNAL-BEHAVIORS>\n        </APPLICATION-SW-COMPONENT-TYPE>\n      </ELEMENTS>\n    </AR-PACKAGE>\n  </AR-PACKAGES>\n</AUTOSAR>\n"
  },
  {
