{
  "name": "@modelscript/api",
  "version": "0.0.0",
  "description": "REST API for ModelScript",
  "keywords": [
    "modelscript"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Mohamad Omar Nachawati <omar@modelscript.org>",
  "type": "module",
  "files": [
    "package.json",
    "README.md",
    "COPYING",
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dev": "PORT=3000 SEED_POSTS=true NODE_OPTIONS='--max-old-space-size=8192 --dns-result-order=ipv4first' tsx watch src/main.ts",
    "lint": "eslint src",
    "test": "node ../../scripts/test-runner.js",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@comunica/query-sparql": "^5.4.1",
    "@comunica/query-sparql-rdfjs": "^5.4.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelscript/cad": "*",
    "@modelscript/cfd": "*",
    "@modelscript/dsl": "*",
    "@modelscript/exchange": "*",
    "@modelscript/fea": "*",
    "@modelscript/mcp": "*",
    "@modelscript/modelica": "*",
    "@modelscript/runtime": "*",
    "@modelscript/simulate": "*",
    "@modelscript/step": "*",
    "@modelscript/sysml2": "*",
    "@svgdotjs/svg.js": "^3.2.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.1",
    "jsonwebtoken": "^9.0.3",
    "maxmind": "^5.0.7",
    "multer": "^2.4.0",
    "n3": "^2.13.9",
    "occt-import-js": "^0.0.23",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.23.1",
    "puppeteer": "^25.12.0",
    "rss-parser": "^3.13.0",
    "semver": "^7.8.5",
    "simple-git": "^4.0.2",
    "stemmer": "^2.0.1",
    "svgdom": "^0.1.29",
    "xml-formatter": "^3.6.7",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/maxmind": "^2.0.4",
    "@types/multer": "^1.4.12",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.3.2",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.0",
    "@types/svgdom": "^0.1.2",
    "@types/xml-formatter": "^2.1.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "eslint": "^9.39.1",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^3.0.0",
    "rimraf": "^6.1.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.3"
