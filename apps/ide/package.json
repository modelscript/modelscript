{
  "name": "@modelscript/ide",
  "version": "0.0.0",
  "private": true,
  "description": "ModelScript VS Code Web IDE with GitHub/GitLab repository integration",
  "type": "module",
  "scripts": {
    "build": "npm run download-vscode && npm run build-extension && npm run build-github-fs && npm run build-server",
    "build-extension": "npx tsx scripts/build-extension.ts",
    "build-github-fs": "cd github-fs && npm run build",
    "build-server": "npx esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:express --external:http-proxy-middleware",
    "build-static": "npm run download-vscode && npm run build-extension && npm run build-github-fs && npx tsx src/build-static.ts",
    "clean": "rimraf dist",
    "dev": "npm run download-vscode && npm run build-extension && PORT=3003 npx tsx watch src/server.ts",
    "download-model": "bash scripts/download-model.sh",
    "download-vscode": "npx tsx src/download-vscode.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@modelscript/cad": "*",
    "@modelscript/csv": "*",
    "@modelscript/diagram": "*",
    "@modelscript/dsl": "*",
    "@modelscript/exchange": "*",
    "@modelscript/ide-client": "*",
    "@modelscript/lsp": "*",
    "@modelscript/modelica": "*",
    "@modelscript/owl2": "*",
    "@modelscript/runtime": "*",
    "@modelscript/scad": "*",
    "@modelscript/simulate": "*",
    "@modelscript/step": "*",
    "@modelscript/sysml2": "*",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "http-proxy-middleware": "^3.0.7",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.3",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.39.0"
  }
}
