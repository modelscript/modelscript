{
  "name": "@modelscript/ide",
  "version": "0.1.0",
  "private": true,
  "description": "Ansatz Studio (VS Code Web) with GitHub/GitLab repository integration",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "npm run download-vscode && npm run build-extension && npm run build-github-fs",
    "build-extension": "npx tsx scripts/build-extension.ts",
    "build-github-fs": "pnpm --filter modelscript-github-fs build",
    "build-static": "npm run download-vscode && npm run build-extension && npm run build-github-fs && npx tsx src/build-static.ts",
    "clean": "rimraf dist",
    "download-model": "bash scripts/download-model.sh",
    "download-vscode": "npx tsx src/download-vscode.ts",
    "lint": "eslint src scripts --no-warn-ignored",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/cad": "workspace:*",
    "@modelscript/csv": "workspace:*",
    "@modelscript/diagram": "workspace:*",
    "@modelscript/dsl": "workspace:*",
    "@modelscript/exchange": "workspace:*",
    "@modelscript/ide-client": "workspace:*",
    "@modelscript/las": "workspace:*",
    "@modelscript/lsp": "workspace:*",
    "@modelscript/modelica": "workspace:*",
    "@modelscript/owl2": "workspace:*",
    "@modelscript/runtime": "workspace:*",
    "@modelscript/scad": "workspace:*",
    "@modelscript/simulate": "workspace:*",
    "@modelscript/step": "workspace:*",
    "@modelscript/sysml2": "workspace:*",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.3",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.28.1",
    "eslint": "^10.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "modelscript": {
    "tier": "beta",
    "category": "app"
  }
}
