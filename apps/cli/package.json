{
  "name": "@modelscript/cli",
  "version": "0.0.18",
  "description": "CLI for ModelScript",
  "keywords": [
    "modelscript"
  ],
  "homepage": "https://modelscript.org",
  "bugs": {
    "url": "https://github.com/modelscript/modelscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modelscript/modelscript.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Mohamad Omar Nachawati <mnachawa@gmail.com>",
  "type": "module",
  "bin": {
    "msc": "./dist/main.js"
  },
  "files": [
    "package.json",
    "README.md",
    "COPYING",
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/vendor && cp -r src/vendor/* dist/vendor/ && chmod +x dist/main.js",
    "clean": "rimraf dist",
    "test": "npm run test:jest && npm run test:node",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:node": "npx tsx --test tests/test-dhf-export.test.ts tests/test-digital-thread-complete.test.ts tests/test-multidomain-falsify-cli.test.ts tests/test-pr-diff.test.ts tests/test-tgg-multi-domain.test.ts tests/test-unified-verify.test.ts",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.9",
    "@modelscript/cad": "*",
    "@modelscript/csv": "*",
    "@modelscript/diagram": "*",
    "@modelscript/dsl": "*",
    "@modelscript/exchange": "*",
    "@modelscript/lsp": "*",
    "@modelscript/modelica": "*",
    "@modelscript/owl2": "*",
    "@modelscript/runtime": "*",
    "@modelscript/scad": "*",
    "@modelscript/simulate": "*",
    "@modelscript/step": "*",
    "@modelscript/sysml2": "*",
    "@npmcli/package-json": "^8.0.0",
    "adm-zip": "^0.6.1",
    "assemblyscript": "^0.28.20",
    "jiti": "^2.7.0",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.2.7",
    "svgdom": "^0.1.29",
    "wabt": "^1.0.39",
    "xml-formatter": "^3.6.7",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.2",
    "@types/npmcli__package-json": "^4.0.4",
    "@types/svgdom": "^0.1.2",
    "@types/xml-formatter": "^2.1.1",
    "@types/yargs": "^17.0.34",
    "eslint": "^9.39.1",
    "jest": "^30.5.1",
    "jest-ctrf-json-reporter": "^0.0.11",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^3.0.0",
    "rimraf": "^6.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
