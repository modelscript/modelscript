{
  "name": "@modelscript/desktop",
  "version": "0.0.18",
  "private": true,
  "description": "ModelScript Native Desktop Studio (Tauri v2)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:appimage": "tauri build --bundles appimage",
    "build:deb": "tauri build --bundles deb",
    "build:debug": "tauri build --debug",
    "build:dmg": "tauri build --bundles dmg",
    "build:msi": "tauri build --bundles msi",
    "build:portable": "tauri build --bundles nsis",
    "build:tauri": "tauri build",
    "clean": "rimraf dist",
    "dev": "tauri dev",
    "lint": "eslint src tests --no-warn-ignored",
    "test": "tsx tests/tauri-config.test.ts && tsx tests/desktop-blackbox-simulation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelscript/exchange": "*",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0"
  }
}
